@ARTICLE{9385792,
  author={Gu, Yu and Yan, Huan and Dong, Mianxiong and Wang, Meng and Zhang, Xiang and Liu, Zhi and Ren, Fuji},
  journal={IEEE Transactions on Computational Social Systems}, 
  title={WiONE: One-Shot Learning for Environment-Robust Device-Free User Authentication via Commodity Wi-Fi in Man–Machine System}, 
