@ARTICLE{11520317,
  author={Monteiro, Marcos Eduardo Pivaro and ACQUA, Thiago Luciano Dall and SANTOS, Douglas de Oliveira and Frutos, Estefani and SOUZA, Cleber Brantl de and SILVA, Alisson Siqueira},
