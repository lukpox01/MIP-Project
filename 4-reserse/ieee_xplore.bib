@INPROCEEDINGS{11582617,
  author={Yang, Xiaoying and Xu, Zishen and Zuo, Yiping and Chen, Weicong and Guo, Jiajia and Dai, Chen},
  booktitle={2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={MulSense: An Enhanced Multi-Person Intrusion Detection System Using Commodity WiFi Devices}, 
  year={2026},
  volume={},
  number={},
  pages={4202-4207},
  abstract={Existing intrusion detection systems based on WiFi channel state information (CSI) often suffer from limited accuracy and robustness in complex multi-person scenarios, making it difficult to reliably detect intruders and distinguish different numbers of people. To address this challenge, we propose MulSense, an enhanced multi-person intrusion detection system built on commodity WiFi devices. MulSense first incorporates the multi-antenna transmit–receive geometry to establish a disturbance and sensing-boundary model under multi-person intrusion, which describes how detection capability changes with the positions and number of intruders. On this basis, we design an enhanced CSI ratio model that uses static-reference construction, differential normalization, and phase alignment to significantly suppress static background components and measurement noise. Furthermore, we introduce a disturbance-strength-driven channel weighting and frequency-domain feature extraction mechanism, which adaptively amplifies channels that are more sensitive to human motion, and thus enables an intrusion detection and two-person counting pipeline without offline training. Extensive experiments show that, compared with existing WiFi CSI-based methods, MulSense improves both the average people-counting accuracy and the overall intrusion detection accuracy by about 10%–20%, demonstrating its practical value for low-cost indoor multi-person intrusion monitoring.},
  keywords={Wireless fidelity;Modeling;Distance measurement;Intrusion detection;Equations;Timing;Antennas;Printing;Noise;Tagging;WiFi sensing;channel state information (CSI);intrusion detection},
  doi={10.1109/CSCWD68734.2026.11582617},
  ISSN={2768-1904},
