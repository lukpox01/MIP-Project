@INPROCEEDINGS{9097590,
  author={Pasquel Mohottige, Iresha and Gharakheili, Hassan Habibi and Vishwanath, Arun and Kanhere, Salil S and Sivaraman, Vijay},
  booktitle={2020 IEEE/ACM Fifth International Conference on Internet-of-Things Design and Implementation (IoTDI)}, 
  title={Evaluating Emergency Evacuation Events Using Building WiFi Data}, 
  year={2020},
  volume={},
  number={},
  pages={116-127},
  abstract={Building operators are required to conduct periodic drills to ensure smooth evacuations in the event of emergencies. However, quantitative evaluation of the drill for adherence to building codes is largely manual and error-prone. Further, unplanned evacuations are seldom documented, let alone evaluated. This paper explores the use of building WiFi data for quantitative evaluations of both planned and unplanned evacuation events. We collect and analyze WiFi connectivity logs spanning a period of 180 days from 14 buildings in a large University campus. For our first contribution, we isolate WiFi data for known planned evacuation drills, conduct floor-level analysis to eliminate noise associated with transient WiFi connections or persistently connected devices, and highlight the anatomy of evacuations across multiple representative buildings each with differing number of levels, exit layouts, and occupant types. Armed with a detailed understanding of the anatomy of a planned evacuation, our second contribution develops a novel method to automatically identify evacuation events from WiFi data; we use it to detect 29 unplanned evacuations, and corroborate them against documented records where available. Our third contribution deduces quantitative measures to compare planned and unplanned evacuations, in terms of evacuation speed and occupancy levels, and further quantifies the man-days of productivity loss arising from unplanned evacuation events across campus. We believe our work is the first to show that building evacuations can be evaluated systematically and accurately at scale using WiFi data, both to corroborate current manual records and to gain new insights.},
  keywords={Buildings;Wireless fidelity;Transient analysis;Manuals;Australia;Productivity;Education;WiFi, Connection Logs, Evacuation, Data Analytics},
  doi={10.1109/IoTDI49375.2020.00018},
  ISSN={},
  month={April},}

@INPROCEEDINGS{11418454,
  author={Yavuz, Rabia and Fıçıcı, Cansel and Çatalbaş, Mehmet Cem},
  booktitle={2026 5th International Informatics and Software Engineering Conference (IISEC)}, 
  title={Comparative Performance of YOLOv5, YOLOv8, and YOLOv11 for Person Detection in Thermal Imagery}, 
  year={2026},
  volume={},
  number={},
  pages={451-455},
  abstract={Human detection in thermal images has become an important topic that stands out in many critical areas such as search and rescue operations, security, and autonomous systems. The deep learning-based object detection model You Look Only Once is preferred due to its real-time detection capability, high accuracy and precision, and resilience against challenges encountered in thermal images such as adverse weather conditions, night vision complexity, and insufficient light. In this study, the human detection performance of the YOLOv5s, YOLOv8s, YOLOv8l, and YOLOv11s models was comparatively evaluated using a suitable thermal image dataset. The models were compared using precision, recall, mAP at 0.50 IoU, and processing time (time) metrics. YOLO11s and YOLOv8s achieved the highest precision values (88–89%), while YOLOv5s lagged behind with a lower precision rate of 87% and YOLOv8l with 87%. In terms of mAP at 0.50 IoU values, YOLOv8s and YOLO11s achieved high success at 89% levels, while YOLOv5s and YOLOv8l showed a lower performance at around 87%. In terms Relative Computation Complexity (RCC), YOLOv8l, selected as the baseline model, has the lowest computational load, while YOLOv5s and YOLOv8s show similar levels of complexity, and YOLOv11s has been determined to be the model with the highest computational complexity. In addition, hardware and computational costs were also considered using metrics such as the number of parameters, inference speed in frames per second (FPS), latency, and memory usage in video random-access memory (VRAM). The results obtained show that YOLOv11s and YOLOv8s are particularly suitable for systems requiring real-time performance.},
  keywords={YOLO;Weather;Accuracy;Computational modeling;Thermal engineering;Real-time systems;Time measurement;Computational complexity;Load modeling;Videos;Thermal Imaging;Infrared Imaging;Human Detection;YOLO;Object Detection;Deep Learning;Search and Rescue;Low-Visibility Environments;UAV Applications},
  doi={10.1109/IISEC69317.2026.11418454},
  ISSN={},
  month={Feb},}

@INPROCEEDINGS{8675617,
  author={Ivanovs, Arturs and Nikitenko, Agris and Di Castro, Mario and Torims, Toms and Masi, Alessandro and Ferre, Manuel},
  booktitle={2019 Third IEEE International Conference on Robotic Computing (IRC)}, 
  title={Multisensor Low-Cost System for Real Time Human Detection and Remote Respiration Monitoring}, 
  year={2019},
  volume={},
  number={},
  pages={254-257},
  abstract={The most important features of autonomous Search And Rescue robots are abilities to autonomously detect victims and assess their basic vital parameters, such as respiration and heartbeat status, by using their on-board sensors to classify survivors according to their need of medical care. This paper presents a novel sensor composition for autonomous victim detection and non-contact respiration monitoring with SAR robots having limited on-board computational power, using a combination of commercial low-cost components - a visual sensor and Ultra-Wide Band radar. In the proposed method, a pretrained neural network (MobileNet) is used to process camera frames and detect human presence in real-time. Once the victim is localized, the radar is used to perform respiration monitoring. The proposed method is evaluated by building a prototype and performing measurements on volunteers in different positions, clothing and amount of subjects in frame.},
  keywords={Visualization;Monitoring;Synthetic aperture radar;Robot sensing systems;UWB, human detection, vital sign, respiration detection, search and rescue},
  doi={10.1109/IRC.2019.00047},
  ISSN={},
  month={Feb},}

@ARTICLE{10947678,
  author={Martin-Martin, Alberto and Verona-Almeida, Marta and Padial-Allué, Rubén and Saez, Borja and Mendez, Javier and Castillo, Encarnación and Parrilla, Luis},
  journal={IEEE Access}, 
  title={Spiking Neural Networks for People Counting Based on FMCW Radar}, 
  year={2025},
  volume={13},
  number={},
  pages={60846-60858},
  abstract={This paper presents an innovative method for indoor people counting using Spiking Neural Networks (SNNs) exclusively with radar data, effectively addressing privacy concerns associated with camera-based systems. When compared to established neural network-based algorithms like VGG16 (F1-Score=0.8003), ResNet50 (F1-Score=0.6669), and MobileNet (F1-Score=0.7258), the SNN (F1-Score=0.8284) exhibits superior performance in the task of counting people indoors. Furthermore, the energy efficiency of the SNN is a strong advantage, particularly for hardware deployment. This characteristic not only reduces computational demands but also aligns with the increasing emphasis on energy conservation in modern technology. The combination of privacy preservation, accuracy, and energy efficiency positions the SNN as a promising choice for a wide range of real-world applications, including security, transportation, and smart spaces, offering a comprehensive solution for people counting in indoor environments.},
  keywords={Radar;Sensors;Accuracy;Cameras;Radar antennas;Receiving antennas;Pipelines;Hardware;Feature extraction;Ultra wideband radar;FMCW radar;people counting;spiking neural network},
  doi={10.1109/ACCESS.2025.3557317},
  ISSN={2169-3536},
  month={},}

@INPROCEEDINGS{11414950,
  author={Li, Weijia},
  booktitle={2025 7th International Academic Exchange Conference on Science and Technology Innovation (IAECST)}, 
  title={Enhanced Thermal Imaging Human Detection Via Adaptive Channel-Spatial Attention Mechanism}, 
  year={2025},
  volume={},
  number={},
  pages={1419-1423},
  abstract={Thermal imaging-based human detection plays a critical role in low-visibility applications, including nighttime surveillance and search-and-rescue missions, and industrial monitoring. However, thermal images often suffer from low contrast, high noise levels, and ambiguous boundaries, posing significant challenges for accurate detection. This paper proposes an enhanced detection framework that integrates an adaptive channel-spatial attention module (ACSAM) with a baseline thermal object detector. The proposed method employs a dual-attention mechanism that selectively amplifies discriminative thermal signatures while suppressing background interference. Extensive experiments on a thermal human detection dataset demonstrate that our approach achieves 95.2% precision and 93.8 recall, outperforming baseline methods by 4.3% and 3.7% respectively. The ablation study validates the effectiveness of each attention component, with the combined module contributing to a 5.1% improvement in mean Average Precision (mAP). The proposed framework maintains real-time inference capability at 67.3 FPS on GPU, making it suitable for practical deployment in resource-constrained scenarios.},
  keywords={YOLO;Visualization;Technological innovation;Attention mechanisms;Surveillance;Detectors;Thermal noise;Real-time systems;Time factors;Noise level;Thermal Imaging;Human Detection;Attention Mechanism;YOLO;Low-Visibility Detection},
  doi={10.1109/IAECST68792.2025.11414950},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{11577042,
  author={D, Gunapriya and N, Pushpalatha and S, Pranav kumar and S, Mohammed Rafi and CM, Tharun and A, Swetha},
  booktitle={2026 International Conference on Connected Intelligence for Industrial Applications (CI2A)}, 
  title={AI-Based Smart Fire Detection and Suppression System for the Firecracker Industry}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Firecracker industries are one of the most hazardous places considering its concentration of combustible material, integrated human errors, and the lack of monitoring in realtime. The existing retractive fire alarm system could not predict the risk earlier or ensure human safety during suppression. The proposed system presents an AI-based Smart Fire Detection and Suppression System that includes sensor fusion and machine learning algorithms using an ESP32 microcontroller. The system captures the live data of temperature, smoke, and gas variation using the DHT11 and MQ-2 sensor and two infrared sensors to calculate the occupancy rate of human. The proposed model uses the Random Forest machine learning algorithm to predict the fire condition in the timing schedule as Safe, Warning, and Critical based on the factors considered. When the critical stage of the fire factor reaches and the occupancy rate of human inside the chambers has emptied, then the CO2 suppression unit automatically starts and capsizes the fire. The performance of the proposed system over the prototype can be calculated as more accuracy, less false alarm, robust predicting in environmental conditions, and implementation proves that the system can be cost-effective and intelligent protection of firecrackers.},
  keywords={Fires;Firing;Image sensors;Signal detection;Modeling;Machine learning;Machining;Random forests;Accuracy;Artificial intelligence;-Fire Detection;ESP32;Machine Learning;Internet of Things (IoT);Firecracker Industry;CO2 Suppression;Safety System},
  doi={10.1109/CI2A69097.2026.11577042},
  ISSN={},
  month={April},}

@INPROCEEDINGS{11233458,
  author={Roshan, Dhilbar and Mahesh, Diya and Naveen, V S and Mary Catherine, V G},
  booktitle={2025 11th International Conference on Smart Computing and Communications (ICSCC)}, 
  title={Deep Learning-Based Human Detection Rover for AI-Powered Search and Rescue in Disaster Zones}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Under disaster-affected regions and emergency scenarios, conventional human detection and rescue missions are challenged by limited visibility, dangerous terrain, and danger to rescue personnel. Current practices do not possess real-time and effective means for survivor detection in complicated landscapes. To overcome these, we introduce a Human Detection Rover, an innovative search-and-rescue system utilizing infrared sensing, artificial intelligence-powered image recognition, and wireless remote control to increase efficiency in operations. The rover is controlled by a Raspberry Pi microcontroller. The PIR(Passive Infrared Sensor) sensor is in constant search of infrared radiation from possible survivors, signaling the YOLOv3 deep learning model for real-time object identification in case of motion detection. In case a human is detected, the system sends GPS coordinates to rescue teams for prompt response. If a human presence is not detected, the rover path dynamically corrects to resume scanning. Communication is done through WiFi-based direct IP connectivity or cloud-based remote access using MQTT(Message Queuing Telemetry Transport)/WebSockets. This system provides a low-cost, and real-time response for disaster rescue, military scouting, and security monitoring, with minimal human presence in dangerous environments. Through infrared sensing, artificial intelligence-based object recognition, and wireless control, our Human Detection Rover greatly increases the efficiency, accuracy, and safety of key rescue operations.},
  keywords={YOLO;Wireless communication;Wireless sensor networks;Accuracy;Disasters;Search problems;Real-time systems;Motion detection;Hardware;Object recognition;Human Detection;Search and Rescue;AI-based Object Recognition;YOLOv3},
  doi={10.1109/ICSCC66177.2025.11233458},
  ISSN={},
  month={July},}

@INPROCEEDINGS{9293893,
  author={Bandala, Argel A. and Sybingco, Edwin and Maningo, Jose Martin Z. and Dadios, Elmer P. and Isaac Isidro, Gann and Deanne Jurilla, Rocez and Lai, Chia-Yu},
  booktitle={2020 IEEE REGION 10 CONFERENCE (TENCON)}, 
  title={Human Presence Detection using Ultra Wide Band Signal for Fire Extinguishing Robot}, 
  year={2020},
  volume={},
  number={},
  pages={1176-1181},
  abstract={Fire incidents often result to associated deaths, injuries, and losses occurring structures and properties, particularly in homes every year. In this study, the researchers proposed a 4-wheeled fire extinguishing robot with the ability to detect human presence in the area even when there is fire. Multiple sensors are utilized in this study to detect nearby flame, smoke, temperature and humidity, and obstacles through integration with Arduino and Raspberry Pi. The proposed robot is remotely controlled by the user over Wi-Fi through the graphical user interface created by the researchers in Python for easy monitoring of data and control. A camera is also mounted to the robot for surveillance purposes. The human detection system of the robot is implemented through using ultra-wide band radar (UWB) by utilizing the X4M300 presence sensor, which could detect human presence based on their respiration movement. Initial testing and four experiments were conducted to test the radar sensor's capabilities compared to the existing methods of human detection. The researchers yielded an accuracy of 97.29% in the testing of human detection system, proving that the implementation of UWB radar sensor is successful.},
  keywords={Robots;Sensors;Radar;Ultra wideband radar;Temperature sensors;Radar antennas;Radar detection;fire extinguishing robot;human detection;ultra-wide band radar},
  doi={10.1109/TENCON50793.2020.9293893},
  ISSN={2159-3450},
  month={Nov},}

@INPROCEEDINGS{11232628,
  author={Masaling, Nikita Ananda Putri and Heryadi, Yaya and Girsang, Abba Suganda and Wulandhari, Lili Ayu and Sonata, Ilvico},
  booktitle={2025 International Conference on Information Technology Research and Innovation (ICITRI)}, 
  title={A Comparative Analysis of YOLO Models on Human Detection for Drone-Based Search and Rescue}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Unmanned Aerial Vehicles (UAVs), or drones, are increasingly vital in Search and Rescue (SAR) operations, offering rapid coverage of challenging terrains. Effective human detection in drone-captured imagery is crucial for mission success but faces obstacles such as varied environmental conditions and real-time processing demands. This paper presents a comprehensive comparative analysis of YOLOv8 and YOLOv11 model variants (specifically ' $n$ ' and ' $s$ ' versions) for human detection using the specialized Search and Rescue Dataset (SARD). The models were trained with minimal preprocessing and no explicit data augmentation, focusing on their core performance with pre-trained weights and a consistent training regimen (20 epochs, $640 \times 640$ image size). Performance was evaluated based on standard metrics including Precision, Recall, mean Average Precision (mAP-50 and mAP50-95), and inference time. Results indicate that YOLOv8s achieved the highest detection accuracy with a mAP50-95 of 0.606, outperforming YOLOv8n (0.591), YOLOv11s ($\mathbf{0. 5 8 5}$), and YOLOv11n ($\mathbf{0. 5 7 5}$). In terms of speed, YOLOv8n was the fastest, with an inference time of 7.83 ms, followed by YOLOv11n (9.89 ms), YOLOv8s (12.18 ms), and YOLOv11s (15.5 ms). This study is expected to provide information on the capabilities of YOLO variants, especially YOLOv8 and YOLOv11, by highlighting that YOLOv8 offers the best balance of accuracy in this experimental setting. In addition, YOLOv8 excels in terms of speed, making it a model of choice for practical drone-based SAR applications.},
  keywords={YOLO;Training;Deep learning;Analytical models;Technological innovation;Accuracy;Computational modeling;Data augmentation;Hardware;Drones;Computer Vision;Deep Learning;Human Detection;Image Detection;Search and Rescue (SAR);YOLO},
  doi={10.1109/ICITRI67507.2025.11232628},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{10293139,
  author={Rizk, M. and Bayad, I.},
  booktitle={2023 Seventh International Conference on Advances in Biomedical Engineering (ICABME)}, 
  title={Human Detection in Thermal Images Using YOLOv8 for Search and Rescue Missions}, 
  year={2023},
  volume={},
  number={},
  pages={210-215},
  abstract={The effectiveness of life-saving search and rescue missions relies on swiftly locating and supplying crucial information about injured or missing persons, which optimize resource allocation and operational efforts while reducing expenses. Our research work explores the advances in deep learning techniques for efficient and accurate human detection using thermal images targeting the application of search and rescue missions. This paper focuses on exploring YOLOv8, the latest version of the You Only Look Once (YOLO) object detection model, to detect humans in diverse scenarios. A novel dataset of 17,148 grayscale thermal images with 90,882 annotations of humans is constructed carefully to represent various conditions and scenarios. All available YOLOv8 variants of different sizes and architectures (from Nano to Extra Large) are trained and evaluated using this dataset. The evaluation of the trained models demonstrates the effectiveness of YOLOv8 models in human detection exhibiting a high average precision of 95%. Furthermore, the impact of model size on precision and accuracy is highlighted.},
  keywords={Deep learning;Training;Adaptation models;Image edge detection;Computational modeling;Surveillance;Video sequences;Thermal Images;Object Detection;Deep learning;Convolutional Neural Networks;YOLO;Human Detection},
  doi={10.1109/ICABME59496.2023.10293139},
  ISSN={2377-5696},
  month={Oct},}

@INPROCEEDINGS{9324052,
  author={Kim, Youngwook and Alnujaim, Ibrahim and You, Sungjin and Jeong, Byung Jang},
  booktitle={IGARSS 2020 - 2020 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={Human Detection with Range-Doppler Signatures Using 3D Convolutional Neural Networks}, 
  year={2020},
  volume={},
  number={},
  pages={2440-2442},
  abstract={Human detection is proposed based on time-varying range- Doppler signatures measured by millimeter-wave FMCW radar using deep recurrent neural networks. Human detection is a significant topic for security, surveillance, and search and rescue. When a target is measured by fast-chirp FMCW radar, a range-Doppler diagram can be constructed in real time. Because the signatures in a range-Doppler diagram are time-varying, we investigated the feasibility of classifying targets using those signatures. We measured five classes-humans, cars, cyclists, dogs, and road clutter-using millimeter-wave FMCW radar. We applied 3D-convolutional neural networks to 3D representations of time-varying signatures and achieved a classification accuracy of 97%, with a human detection rate of 100%.},
  keywords={Radar;Three-dimensional displays;Clutter;Feature extraction;Dogs;Automobiles;Millimeter wave measurements;Human detection;FMCW radar;range- Doppler diagram;deep convolutional neural networks;deep recurrent neural networks},
  doi={10.1109/IGARSS39084.2020.9324052},
  ISSN={2153-7003},
  month={Sep.},}

@INPROCEEDINGS{11537125,
  author={Acar, Muhammed Besir and Kaba, Talha and Parlak, Abdulkadir and Hussen, Ramadan Shemsu and Gokpinar, Ahmet Emre and Dilek, Selma and Cakin, Alperen},
  booktitle={2026 8th International Congress on Human-Computer Interaction, Optimization and Robotic Applications (ICHORA)}, 
  title={Optimizing Survivor Detection Models on Thermal Imagery for UAV-Assisted Search and Rescue}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={This study presents a systematic hardware-aware optimization and deployment analysis of deep neural networks for human detection in disaster areas using thermal imaging in Search and Rescue (SAR) operations. The study specifically targets real-time inference on AI-mounted UAVs, particularly the NVIDIA Jetson Orin Nano. Various state-of-the-art object detection architectures are evaluated, including YOLO models (YOLO v5-v11, v26) and transformer-based detectors (RT-DETR, RFDETR). In 278 experimental configurations, combinations of post-training quantization (FP16/INT8 via TensorRT), unstructured pruning $(30-85 \%$ sparsity), power mode scaling $(7 ~\mathrm{W}-25 ~\mathrm{W})$ and input resolution reduction (160-512 px) were applied. Models are trained and validated on the WiSARD wilderness thermal UAV dataset to reflect realistic SAR deployment conditions. The contributions of the project are overall comparative analysis of detection methods and a scalable/optimized deep learning framework capable of real-time survivor detection from thermal images on edge AI devices.},
  keywords={Modeling;Quantization (signal);Optimization;Signal detection;Timing;Printing;Accuracy;Autonomous aerial vehicles;Architecture;Computer architecture;Uncrewed aerial vehicles (UAVs);thermal imagery;search and rescue;survivor detection;mobile edge computing;neural network compression},
  doi={10.1109/ICHORA69329.2026.11537125},
  ISSN={2996-4393},
  month={May},}

@INPROCEEDINGS{11522286,
  author={Balambigai, S. and C R, Raksith and A, Saravanakumar and S, Sivachandiran and S, Vinothraja and S S, Vedhanth},
  booktitle={2026 4th International Conference on Artificial Intelligence and Machine Learning Applications Theme: Healthcare and Internet of Things (AIMLA)}, 
  title={Drone-Based Multi-Sensor Detection System for Underground Human Identification}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={In disaster and forensic investigations, the issue of determining the location of human beings who are buried under the ground or trapped in their rubble is an urgent and highly monitored problem, which is resolved quickly and with precision. Thermal imaging and manual ground surveys are traditional methods that are limited and time-consuming, particularly when it comes to subsurface identification. To overcome these shortcomings, this project suggests a Drone-based Multi-Sensor Detection System Underground Human Identification, which incorporates the Ultra-Wideband (UWB) radar, thermal imaging, and RGB cameras on a platform of an aerial drone. The suggested system uses several sensors to enhance the accuracy in detecting. The applications of UWB technology include the detection of underground anomalies through the transmission of low-power and widespectrum signals, the identification of temperature changes on the surface, and the visual mapping of the treated section through thermal and RGB cameras, respectively. The data from all sensors is processed in real time by an onboard processor, and the results are an anomaly map, which is wirelessly communicated to a mobile application dashboard to view live data. This will serve to give real time representation of a possible human presence found on a 2D/3D map of GPS position. As in the experimental results, it has been shown that the system costs less in search time when compared to the oldfashioned standalone systems, in addition to higher detection accuracy. The small size and aerial features of the system enable prompt implementation in the disasterstricken regions and fallen buildings, as well as in challenging environments. The solution suggested can be used in various ways in disaster rescue phases, in forensic investigations, in defense, or in archaeological surveys. Within the scope of the future, one may consider automatic classification of anomalies with the help of artificial intelligence and drone swarms to cover vast areas, as well as sharing data via clouds and enhancing coordination between rescue crews.},
  keywords={Image sensors;Grounding;Timing;Signal detection;Drones;Surfaces;Joining processes;Real-time systems;Ultra wideband radar;Ground penetrating radar;Ultra-Wideband Radar;Thermal Imaging;Multi-Sensor Fusion;Underground Human Detection;Search and Rescue;Edge Computing},
  doi={10.1109/AIMLA67915.2026.11522286},
  ISSN={},
  month={April},}

@INPROCEEDINGS{11507872,
  author={Jeyakumar, P. and R, Jeya Shruthika and B, Harshita and M, Harshini and V, Karishma},
  booktitle={2026 6th International Conference on Trends in Material Science and Inventive Materials (ICTMIM)}, 
  title={M-LTHD-Based Lightweight Temporal Human Detection for Maritime Search and Rescue Using Embedded UAVs}, 
  year={2026},
  volume={},
  number={},
  pages={45-54},
  abstract={Poor visibility, unstable sea conditions, and the delay in identifying victims are generally a hustle to search and rescue efforts in maritime environments and greatly undermine chances of survival. In this paper, we introduced that M-LTHD (Maritime Lightweight Temporal Human Detection) is a lowpower, embedded human detection system that includes an unmanned aerial vehicle (UAV) to be used in real-time search and rescue missions over the sea. The system proposed uses a lightweight vision-based detection pipeline designed to work with hardware in the microcontroller range and uses temporal verification to minimize false detections that can occur due to sea reflections and wave patterns. The results of experimental assessment based on UAV-collected maritime imagery show that the detection rate is 88.2, the false positive rate is less than 6.5, and the average processing time is $30 ~\text{ms} /$ frame, which means that it can be operated in real-time. Systems have end-to-end detection to alert response times of less than 4.2 seconds and low power consumption with a mean operation draw of 260 mW in the detection mode. This research confirms the efficiency of the proposed solution as an inexpensive, fast implementation solution to the improvement of maritime search and rescue missions.},
  keywords={Signal detection;Timing;Autonomous aerial vehicles;Real-time systems;Modules (abstract algebra);Cameras;Specific absorption rate;Synthetic aperture radar;Global Positioning System;Hardware;Maritime Search and Rescue;Unmanned Aerial Vehicles;Human Detection;Embedded Vision;Low-Power Systems;Temporal Verification;Raspberry Pi Pico},
  doi={10.1109/ICTMIM68190.2026.11507872},
  ISSN={},
  month={April},}


@INPROCEEDINGS{11203549,
  author={Srivastava, Srishti and Kar, Udit Narayan and Pandey, Shreshth and Dalai, Asish Kumar},
  booktitle={2025 International Conference on Artificial Intelligence and Machine Vision (AIMV)}, 
  title={Human Detection and Tracking in Fire Situations: Leveraging AI for Safer Evacuations}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In areas affected by fire, efficient human tracking and detection is essential to facilitating prompt and safe evacuations. Nonetheless, fire situations provide distinct visual difficulties that impede conventional surveillance systems, including dense smoke, occlusions, fluctuating illumination, and dynamic movement. The robust real-time approach proposed in this work combines ByteTrack for high-performance multi-object tracking with YOLOv8n (You Only Look Once version 8 nano) for lightweight yet accurate object recognition. To improve situational awareness even more, the system incorporates posture recognition to determine whether a person is standing, crawling, or lying down—a crucial function for setting priorities for rescue operations. The CrowdHuman and FireNet datasets, as well as a specially annotated fire simulation dataset constructed using Firescape video sequences and thermal imagery from the FLIR ADAS dataset, are used to train and assess the suggested approach, guaranteeing thorough coverage of smoke, low visibility, and a variety of postures. The model’s performance is evaluated using tracking metrics like MOTA and IDF1, as well as common object detection metrics like mAP@0.5 and mAP@0.5:0.95. The individual contributions of YOLOv8n, ByteTrack, and the posture recognition module are illustrated by ablation studies, which also emphasize their effects on tracking stability and detection accuracy in fire-like scenarios. Comparing experimental outcomes to baseline tracking methods, MOTA improved by 27% and IDF1 increased by 15%.},
  keywords={YOLO;Visualization;Accuracy;Tracking;Computational modeling;Surveillance;Benchmark testing;Emergency services;Real-time systems;Artificial intelligence;Human Detection;Multi-Object Tracking;YoLOv8n;ByteTrack;Fire Evacuation;Posture Recognition;FLIR ADAS;FireNet;Real-Time Surveillance;Emergency Response AI},
  doi={10.1109/AIMV66517.2025.11203549},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{11213156,
  author={Premachandra, Charith and Tan, U-Xuan},
  booktitle={2025 International Conference on Indoor Positioning and Indoor Navigation (IPIN)}, 
  title={Novel UWB Synthetic Aperture Radar Imaging for Mobile Robot Mapping}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Traditional exteroceptive sensors in mobile robots, such as LiDARs and cameras often struggle to perceive the environment in poor visibility conditions. Recently, radar technologies, such as ultra-wideband (UWB) have emerged as potential alternatives due to their ability to see through adverse environmental conditions (e.g. dust, smoke and rain). However, due to the small apertures with low directivity, the UWB radars cannot reconstruct a detailed image of its field of view (FOV) using a single scan. Hence, a virtual large aperture is synthesized by moving the radar along a mobile robot path. The resulting synthetic aperture radar (SAR) image is a high-definition representation of the surrounding environment. Hence, this paper proposes a pipeline for mobile robots to incorporate UWB radar-based SAR imaging to map an unknown environment. Finally, we evaluated the performance of classical feature detectors: SIFT, SURF, BRISK, AKAZE and ORB to identify loop closures using UWB SAR images. The experiments were conducted emulating adverse environmental conditions. The results demonstrate the viability and effectiveness of UWB SAR imaging for high-resolution environmental mapping and loop closure detection toward more robust and reliable robotic perception systems.},
  keywords={Accuracy;Feature detection;Pipelines;Detectors;Radar imaging;Apertures;Feature extraction;Radar polarimetry;Mobile robots;Ultra wideband radar;UWB radar;SAR imaging;SIFT;SURF;BRISK;AKAZE;ORB},
  doi={10.1109/IPIN66788.2025.11213156},
  ISSN={2471-917X},
  month={Sep.},}

@INPROCEEDINGS{11414465,
  author={Kumar, Vishnu and Kumar, Utkarsh and Kumar, Rishu and Yadav, Rahul and Bhardwaj, Aditya and Khan, Shahid},
  booktitle={2025 3rd International Conference on IoT, Communication and Automation Technology (ICICAT)}, 
  title={A Smart Flame-Tracking Robot with IoT Monitoring and ML-Based Human Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The research details how to design a fire robot at home using Arduino, wherein the robot senses flames and faces thanks to a built-in fire detection system and facial recognition function, allowing it to help rescue trapped people. It has several sensors, among them flame, smoke and infrared (IR), as well as modules that detect faces. Thanks to IR, an infrared sensor, the robot can navigate alone by identifying obstacles and smoke and flame detectors help find fire and leakages early in homes and industries. In addition, the face detection process helps by finding people in the influenced area and alerts for prioritizing rescue activities. Integrating these modules lets you build an affordable and standalone robot for detecting fire and reacting to emergencies.},
  keywords={Service robots;Navigation;Fires;Spraying;Robot sensing systems;Sensor systems;Face detection;Faces;Monitoring;Intelligent sensors;Arduino;Flame-Tracking;Water spraying mechanism;Face detection system;Infrared flame sensor},
  doi={10.1109/ICICAT68430.2025.11414465},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{9331705,
  author={Snigdha, Farjana and Ishmael, Khaldoon and Neville, Ryan and Boric-Lubecke, Olga},
  booktitle={2020 IEEE Asia-Pacific Microwave Conference (APMC)}, 
  title={Cardiopulmonary Effective Radar Cross Section (ERCS) for Orientation of Sedentary Subject Using Microwave Doppler Radar}, 
  year={2020},
  volume={},
  number={},
  pages={971-973},
  abstract={Effective radar cross-section (ERCS) for microwave Doppler radar, is defined by the reflected power from sections of the human body that undergo physiological motion. This paper investigates ERCS for human cardiopulmonary motion of sedentary subjects at three different positions (front, back and side with respect to radar). While human breathing and heartbeat can be measured from all four sides of the body, the characteristics of measured signals will vary with body orientation. Thus, continuous wave radar with quadrature architecture at 2. 4GHz was used to test a sedentary subject for three minutes from three different orientations: front, back and side with respect to radar. The results obtained from the tests showed that physiological motion could be obtained and that distinct patterns emerge due to the differences in the ERCS for each orientation. For the seated subject, back ERCS was higher than for front and side positions. Determining ERCS changes with position may enable determining body orientation with respect to the radar. This research opens further opportunities for development of high-resolution occupancy sensing and emergency search and rescue sensing, where the orientation of a human subject may be unknown ahead of time.},
  keywords={Microwave measurement;Radar cross-sections;Doppler radar;Sensors;Biomedical monitoring;Monitoring;Testing;ERCS (Effective Radar cross-section);Radar cross section;Doppler radar;Orientation;Sedentary;Smart building},
  doi={10.1109/APMC47863.2020.9331705},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{11512857,
  author={Nguyen, Hung and Duc, Hai Duong Nguyen and Hai, Dang Bui and Quang, Ninh Pham and Trung, Kien Do},
  booktitle={2025 IEEE Ocean Engineering Technology and Innovation Conference: Management and Conservation for Sustainable and Resilient Marine and Coastal Resources (OETIC)}, 
  title={Real-Time Multimodal AI-Based Human Detection and Localization for Maritime Search and Rescue Using LiDAR and Thermal Imaging}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Maritime search and rescue operations at sea face many difficulties, especially in low-visibility conditions and complex marine environments. The traditional methods, such as RGB cameras, radar, and visual inspection, are often ineffective in detecting people in distress. This paper proposes an Artificial Intelligence (AI) based human detection and positioning system that integrates Light Detection and Ranging (LiDAR) sensors and thermal cameras to serve maritime rescue work and minimize missed detections. The research method uses the YOLOv8 deep learning model to detect objects and classify input data in real time. An intelligent search algorithm, combined with data from LiDAR and thermal cameras, accurately estimates target coordinates and distances. In addition, the system applies the Denoising Convolutional Neural Network (DnCNN) to reduce interference with the marine environment and help track targets with higher performance. Research results show that the system operates with a high accuracy of about 90% in challenging ocean environments. Multi-sensor data helps improve accuracy and object detection performance compared to traditional single methods.},
  keywords={Modeling;Signal detection;Laser radar;Cameras;Printing;Surfaces;Water;Noise;Image sensors;Lighting;maritime rescue;object detection;YOLOv8 with LiDAR;thermal camera;DnCNN image denoising},
  doi={10.1109/OETIC67587.2025.11512857},
  ISSN={},
  month={Dec},}

@ARTICLE{10716363,
  author={Bany Abdelnabi, Ahmad A. and Rabadi, Ghaith},
  journal={IEEE Access}, 
  title={Human Detection From Unmanned Aerial Vehicles’ Images for Search and Rescue Missions: A State-of-the-Art Review}, 
  year={2024},
  volume={12},
  number={},
  pages={152009-152035},
  abstract={Natural disasters continue to occur at an alarming rate impacting communities worldwide and requiring greater preparedness and response efforts. In the aftermath of disasters such as hurricanes and earthquakes, search and rescue (SAR) usually takes the highest priority on the response list. Utilizing recent advancements in technology, especially Unmanned Aerial Vehicles (UAVs) and Computer Vision in SAR operations has become more common due to their ability to quickly scan large disaster areas, identify and locate victims, and deliver first aid supplies especially in challenging environments. Researchers have leveraged machine learning (ML), particularly Convolutional Neural Networks, to enhance human detection accuracy. However, despite achieving excellent recall rates, the efficiency of these algorithms during actual SAR missions remains a critical consideration. The aim of this paper is to thoroughly examine the literature on human detection from UAV aerial images in SAR scenarios. This paper reviews the existing literature comprehensively and categorizes methods based on disaster type, environment, case study availability, and UAV system capabilities. It also reviews in detail the ML approaches used in the literature and compares them based on factors like image types, training datasets, model details, processing hardware, and evaluation methods. Moreover, it reviews and compares the available datasets according to their types, quantities, applications, and relevance to SAR operations. It also briefly covers state-of-the-art hardware for real-time onboard processing. Finally, we discuss the main challenges and recommendations for achieving fully autonomous UAV systems for human detection in SAR missions and offer recommendations for future research directions.},
  keywords={Reviews;Autonomous aerial vehicles;Surveys;Object recognition;YOLO;Monitoring;Videos;Training;Computer vision;Disaster management;Computer vision;disaster response;search and rescue;unmanned aerial vehicles},
  doi={10.1109/ACCESS.2024.3479988},
  ISSN={2169-3536},
  month={},}

@INPROCEEDINGS{11246471,
  author={Liu, Ruihan and Wu, Xiaoyi and Chen, Xijun and Hu, Liang and Lou, Yunjiang},
  booktitle={2025 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)}, 
  title={4D-ROLLS: 4D Radar Occupancy Learning via LiDAR Supervision}, 
  year={2025},
  volume={},
  number={},
  pages={13602-13609},
  abstract={A comprehensive understanding of 3D scenes is essential for autonomous vehicles (AVs), and among various perception tasks, occupancy estimation plays a central role by providing a general representation of drivable and occupied space. However, most existing occupancy estimation methods rely on LiDAR or cameras, which perform poorly in degraded environments such as smoke, rain, snow, and fog. In this paper, we propose 4D-ROLLS, the first weakly supervised occupancy estimation method for 4D radar using the LiDAR point cloud as the supervisory signal. Specifically, we introduce a method for generating pseudo-LiDAR labels, including occupancy queries and LiDAR height maps, as multi-stage supervision to train the 4D radar occupancy estimation model. Then the model is aligned with the occupancy map produced by LiDAR, fine-tuning its accuracy in occupancy estimation. Extensive comparative experiments validate the exceptional performance of 4D-ROLLS. Its robustness in degraded environments and effectiveness in cross-dataset training are qualitatively demonstrated. The model is also seamlessly transferred to downstream tasks BEV segmentation and point cloud occupancy prediction, highlighting its potential for broader applications. The lightweight network enables 4D-ROLLS model to achieve fast inference speeds at about 30 Hz on a 4060 GPU. The code of 4D-ROLLS will be made available at https://github.com/CLASS-Lab/4D-ROLLS.},
  keywords={Point cloud compression;Training;Space vehicles;Laser radar;Weak supervision;Three-dimensional displays;Estimation;Predictive models;Robustness;Testing},
  doi={10.1109/IROS60139.2025.11246471},
  ISSN={2153-0866},
  month={Oct},}

@INPROCEEDINGS{8760811,
  author={Llasag, Raúl and Marcillo, Diego and Grilo, Carlos and Silva, Catarina},
  booktitle={2019 14th Iberian Conference on Information Systems and Technologies (CISTI)}, 
  title={Human Detection for Search and Rescue Applications with UAVs and Mixed Reality Interfaces}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={Human Detection (HD)in natural disaster areas with the use of Unmanned Aerial Vehicles (UAV)or drones is an important approach to preserve human lives in Search and Rescue (SAR)operations, allowing to rescue injured people through previous and fast exploration from safer zones. Nevertheless, constraints on artificial vision and interactive interfaces remain a challenge, namely the ones related to Computer Vision (CV)techniques, since HD cameras drones need to transmit video streams in real-time to Ground Stations (GS). Additionally, GS interfaces of this type of applications are usually not easy to use for unexperienced pilots. In this work, we propose an architecture for SAR operations, integrating an interactive interface that can be used with commercial UAV and Head-Mounted Display (HMD)devices, which provide Mixed Reality (MR)for GS. Results on an application prototype show that a fine tunning process of a non-traditional object detection model with SAR images can improve human detection precision with real-time video streaming.},
  keywords={Computer vision;Head-mounted displays;Mixed reality;Prototypes;Object detection;Autonomous aerial vehicles;Real-time systems;Radar polarimetry;Drones;Information systems;Human Detection;Unmanned Aerial Vehicles;Search and Rescue;Computer Vision;Mixed Reality;Head-Mounted Display},
  doi={10.23919/CISTI.2019.8760811},
  ISSN={2166-0727},
  month={June},}

@INPROCEEDINGS{11624823,
  author={P, Sri Silpa and Anusha, S. L. and Haritha, K. and Harshita, M. and Sai, S. Mohan},
  booktitle={2026 9th International Conference on Computing Methodologies and Communication (ICCMC)}, 
  title={IoT-based Smart Helmet for Firefighters with Machine Learning-based Human, Fire and Smoke Detection}, 
  year={2026},
  volume={},
  number={},
  pages={620-627},
  abstract={The fire accident scenarios result in a challenging working environment for the firefighters due to dense smoke clouds, extreme temperatures above 600°C, and presence of lethal gases. Hence, it becomes challenging for the firefighters to detect the persons trapped inside the building. Traditionally designed firefighting gear mainly concentrates on providing physical safety but lacks the capability to provide real-time intelligent monitoring. This paper presents an experimental study on the design, development, and analysis of an IoT-based smart helmet equipped with human detection using the YOLOv8 machine learning algorithm, multi-sensor environmental monitoring, dual-buzzer alert system, live video streaming, and GPS location tracking capability. The proposed solution utilizes the Arduino UNO microcontroller as a central processing unit integrated with temperature and humidity sensor (DHT11), gas sensors (MQ-2), IR sensors, light intensity sensors, GPS sensor (NEO-6M), and ESP32-CAM camera to capture images and stream live videos. The proposed YOLOv8 model detects humans within the fire environment with 95.2% accuracy with precision rate of 94.8% and recall rate of 95.6%. The MQ-2 gas sensor detects any kind of lethal gas with less than 3 seconds delay. Implementation of the prototype proved to be technically feasible and user-friendly. Potential areas for further development will focus on incorporating thermal imaging technology, utilizing LoRa mesh networks, and conducting trials with functional fire brigades.},
  keywords={Internet of Things;Image sensors;Signal detection;Gases;Global Positioning System;Real-time systems;Modeling;Timing;Fires;Firing;YOLOv8;ESP32-CAM;Smart Helmet;Firefighter Safety;Real-time Monitoring;Sensor Networks;Deep Learning},
  doi={10.1109/ICCMC69250.2026.11624823},
  ISSN={},
  month={July},}

@INPROCEEDINGS{10986725,
  author={Upadhyay, Harsh Kumar and Singh, Vaibhav and Bali, Vikram and Pandey, Sarvagya and Verma, Vandna and Nishad, D. K.},
  booktitle={2025 3rd International Conference on Device Intelligence, Computing and Communication Technologies (DICCT)}, 
  title={Enhanced Thermal Object Tracking in Search and Rescue Missions Using Adaptive 3D Kalman Filtering}, 
  year={2025},
  volume={},
  number={},
  pages={688-693},
  abstract={Search and rescue (SAR) operations often involve hazardous environments where rapid human detection is critical for survival. While thermal imaging drones have improved SAR capabilities, challenges persist in maintaining accurate tracking amid dynamic environmental conditions, occlusions, and changing perspectives. This paper presents a novel approach to thermal human tracking by implementing an adaptive 3D Kalman filtering system integrated with depth estimation techniques. Our methodology enhances tracking accuracy by extending traditional 2D Kalman filters to incorporate altitude changes and advanced occlusion handling. Experimental results demonstrate significant improvements in detection reliability and tracking persistence across challenging scenarios including darkness, smoke, and dense foliage. The system achieves 92% detection accuracy in low-visibility conditions and reduces false positive rates by 37% compared to conventional methods. This research addresses critical gaps in SAR technology while offering applications across disaster management, wildlife conservation, and industrial safety domains. The proposed framework enables more efficient SAR operations, potentially reducing response times and improving survival outcomes in disaster scenarios.},
  keywords={Three-dimensional displays;Accuracy;Filtering;Depth measurement;Wildlife;Imaging;Search problems;Kalman filters;Time factors;Reliability;Thermal Imaging;3D Kalman Filter;Human Tracking;Search and Rescue (SAR);Depth Estimation;Occlusion Handling;Low-Visibility Detection;Computer Vision},
  doi={10.1109/DICCT64131.2025.10986725},
  ISSN={},
  month={March},}

@INPROCEEDINGS{10391031,
  author={Ozyurt, Umut and Cicekdag, Begum and Budak, Zafer Dogan and Ertekin, Seyda},
  booktitle={2023 4th International Informatics and Software Engineering Conference (IISEC)}, 
  title={Enhanced Thermal Human Detection with Fast Filtering for UAV Images}, 
  year={2023},
  volume={},
  number={},
  pages={1-7},
  abstract={Real-time human detection systems can facilitate search and rescue (SAR) operations by expediting the identification of individuals in disaster-stricken areas. Unmanned aerial vehicles (UAVs), equipped with thermal imaging, can help locate missing or injured people, especially at night or in adverse weather conditions. In this study, a preprocessing filter for increasing the detection accuracy of YOLOv8 in thermal images, has been developed. Combining Contrast Limited Adaptive Histogram Equalization (CLAHE) with color value remapping filters, the proposed method creates a 3-channel RGB image from a grayscale thermal image. Experimental results show that the proposed filtering method is successful in decreasing both the false positive and the false negative rates. In addition, having minimal computational and memory requirements, it provides an alternative technique for future studies involving real-time detection in edge computing devices.},
  keywords={YOLO;Computer vision;Image color analysis;Filtering;Computational modeling;Imaging;Gray-scale;Human detection;thermal images;infrared images;YOLOv8;unmanned aerial vehicles},
  doi={10.1109/IISEC59749.2023.10391031},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{10152170,
  author={Uzunidis, Dimitris and Kasnesis, Panagiotis and Margaritis, Evangelos and Feidakis, Michalis and Patrikakis, Charalampos Z. and Mitilineos, Stelios A.},
  booktitle={2022 IEEE 8th World Forum on Internet of Things (WF-IoT)}, 
  title={Real-Time Human Detection Behind Obstacles Based on a low-cost UWB Radar Sensor}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={Ultra-Wideband (UWB) radars are a cost-effective and accurate solution for recognizing human movements for various purposes that span from human activity recognition to vital signs monitoring, (i.e. breathing and heart beating). In this work, we introduce a convenient to use, lightweight and portable solution that exploits an UWB radar sensor as well as an analysis tool tailored for search and rescue operations. In particular, the proposed method works in real-time with main aim to find trapped victims via recognizing their torso movement during breathing. To validate the efficiency of the candidate solution we have collected about three hours of data for three different case studies: indoor environment with and without clear Line of Sight (LOS) as well as outdoor environment with clear LOS. The results demonstrate that the proposed tool is efficient in quantifying in real-time a) if a victim is present within the effective radar range and b) its distance from the radar sensor, even in cases with zero LOS, e.g. behind large obstacles or walls.},
  keywords={Torso;Heart;Real-time systems;Indoor environment;Internet of Things;Ultra wideband radar;Biomedical monitoring;UWB sensor;human detection;non-line of sight;bio-sensing;search and rescue},
  doi={10.1109/WF-IoT54382.2022.10152170},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{9836074,
  author={El Tin, Fares and Sharf, Inna and Nahon, Meyer},
  booktitle={2022 International Conference on Unmanned Aircraft Systems (ICUAS)}, 
  title={Fire Monitoring with a Fixed-wing Unmanned Aerial Vehicle}, 
  year={2022},
  volume={},
  number={},
  pages={1350-1358},
  abstract={When it comes to wildfire surveillance missions, Unmanned Aerial Vehicles (UAVs) offer a safer alternative over manned aircraft in such dangerous flight conditions. Furthermore, the efficiency of fixed-wing UAVs, as compared to multi-rotors platforms, makes them more desirable for prolonged missions with sustained surveillance. Therefore, while previous research has explored autonomous monitoring of fires with multi-rotor UAVs, this work focuses on developing an approach for fire monitoring with a fixed-wing UAV. In order to autonomously track the fire as it propagates, images of the fire from an on-board IR camera are first processed to extract an edge of the fire front. The proposed algorithm then guides the UAV to fly towards the fire front and track it, by obtaining a reference point located on the extracted fire edge, and using L1 guidance law to command the aircraft. Furthermore, as the UAV navigates around the fire, a map of the fire is constructed on-board the vehicle, using a fire occupancy grid map to denote the probability of a fire in each cell. Results from two simulations, with fire data obtained from WRF-Fire simulations, demonstrate the ability for the UAV to autonomously track the propagating fire, regardless of its shape or scale, and maintain a map of the fire on-board the vehicle.},
  keywords={Adaptation models;Shape;Image edge detection;Surveillance;Atmospheric modeling;Fires;Autonomous aerial vehicles},
  doi={10.1109/ICUAS54217.2022.9836074},
  ISSN={2575-7296},
  month={June},}

@ARTICLE{10908463,
  author={Lee, Soyeong and Yoon, Daeyeong and Hwang, Kyuhwan and Wang, Heesu and Park, Kyung-Hwan and Bae Park, Yong},
  journal={IEEE Sensors Journal}, 
  title={Wideband Fan-Beam Lens Antenna for IR-UWB Through-the-Wall Human Detection Radar}, 
  year={2025},
  volume={25},
  number={7},
  pages={11246-11257},
  abstract={This article presents a fan-beam lens antenna design for impulse radio ultrawideband (IR-UWB) through-the-wall human detection radar applications operating in the 1–8 GHz. The proposed fan-beam lens antenna integrates a dielectric lens, designed by adjusting the lengths of dielectric slabs and air layers, with a Vivaldi antenna to achieve a fan-beam pattern characterized by a narrow beamwidth in the E-plane while maintaining a wide beamwidth in the H-plane. The antenna demonstrates excellent time-domain characteristics with a high fidelity factor exceeding 0.93, low reflection signal ringing, and maintained narrow beamwidth in the E-plane for far-field pulse radiation patterns. Through experimental validation, the antenna achieved SNR improvement due to concentrated signal propagation, enabling stable human detection at distances beyond 5 m through walls. The wide H-plane beamwidth allows effective detection of subjects in various postures, including lying positions. The proposed antenna design shows promising potential for various applications including disaster site search and rescue, building surveillance, fall detection in care facilities, noncontact vital sign monitoring, and smart home occupancy detection systems.},
  keywords={Radar antennas;Lenses;Vivaldi antennas;Dielectrics;Antennas;Radar;Ultra wideband antennas;Antenna radiation patterns;Impedance;Horn antennas;Dielectric lens;fan beam antenna;impulse radio ultrawideband (IR-UWB) radar;tapered slot antenna;through-the-wall radar},
  doi={10.1109/JSEN.2025.3543804},
  ISSN={1558-1748},
  month={April},}

@INPROCEEDINGS{11436282,
  author={Ghuge, Kalyani and Jadhav, Swapnil and Kharkar, Yadhni and Koshatwar, Prasad and Luniya, Chaitanya and Ghanwat, Harshada},
  booktitle={2025 2nd Asian Conference on Intelligent Technologies (ACOIT)}, 
  title={Autonomous Firefighting Drone Using ROS, YOLOv8, and ArduPilot with Intelligent Fire-Extinguishing Ball Deployment in Simulated Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper presents an autonomous firefighting UAV that integrates ROS2, AirSim, ArduPilot, and a YOLOv8n-based detector to identify fire, smoke, and human victims and deliver fire-extinguishing balls. We quantify system performance across simulation and real-world trials (30 missions): detection mAP@0.5 = 0.925 (avg), end-to-end response time = 58.3 ± 14.2 s, payload delivery accuracy = 0.35 ± 0.18 m, and overall mission success = 80%. Ablation experiments show YOLOv8n provides a favorable tradeoff between inference latency (3.5 ms/frame after TensorRT) and detection accuracy compared to baselines. We discuss failure modes (wind, heavy smoke), statistical significance of results, and practical considerations for field deployment.},
  keywords={YOLO;Accuracy;System performance;Autonomous aerial vehicles;Sensors;Time factors;Thermal stability;Standards;Payloads;Drones;Autonomous Drone;Fire Detection;ROS;ArduPilot;AirSim;YOLO;Fire Extinguishing Ball;Human Detection;Machine Learning;UAV},
  doi={10.1109/ACOIT66109.2025.11436282},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{11144930,
  author={Islam Shehab, Md. Maidul and Ghosh, Debashish Kumar and Hosscn, Shajib and Jany, Md. Rafsan and Shufian, Abu},
  booktitle={2025 IEEE Region 10 Symposium (TENSYMP)}, 
  title={Enhanced Human Detection in Challenging Environments Using Visible and Infrared Thermal Imaging}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This study presents an intelligent human detection system designed for low-visibility environments, including smoke-filled rooms, darkness, or low-light conditions. Leveraging the capabilities of visible and thermal infrared imaging, the system integrates a $64\times 64$. pixel Adafruit thermal camera module and a Raspberry Pi 4 microcontroller with the lightweight Tiny YOLOv4 object detection algorithm. Thermal image data is upscaled to $128\times 128$ resolution using bilinear interpolation to facilitate deep learning-based classification. A custom dataset of 1,990 infrared images was compiled from ten human subjects performing four everyday actions in varying levels of smoke and lighting. The model achieved an 87% accuracy rate with an average processing speed of 8.8 milliseconds per frame. Detailed metrics confirm the system's robustness, including precision, recall, and F1-score. Furthermore, it supports real-time alert functionality via GSM modules for emergency response. Despite resolution and dataset size limitations, the proposed solution highlights the feasibility of deploying affordable, low-power human detection systems in critical safety and surveillance scenarios.},
  keywords={Temperature sensors;YOLO;Accuracy;Image resolution;Surveillance;Cameras;Thermal conductivity;Robustness;Real-time systems;Time factors;Human detection;Image processing;Raspberry Pi;Infrared Thermal camera;CNN;Tiny Yolo v4},
  doi={10.1109/TENSYMP63728.2025.11144930},
  ISSN={2642-6102},
  month={July},}

@INPROCEEDINGS{11485207,
  author={Pantha, Kailash and Rimal, Biman and Shrestha, Kalyan Kumar and Chieng, David and Koiri, Jeevan and Yonghang, Ashma and Gupt, Aniket Kumar and Khadka, Anamol},
  booktitle={2026 International Conference on ICT and Photonics (ICTP)}, 
  title={An Efficient Infravision Thermal-Infrared Human Detection System for Low-Visibility Surveillance}, 
  year={2026},
  volume={1},
  number={},
  pages={1-6},
  abstract={Current detection systems struggle to provide real-time, accurate, and location-aware human detection in environments where illumination is poor or visibility is obstructed. Thermal imaging technology has become one of the prominent imaging technologies to capture and visualize the thermal radiation emitted from the body of living beings irrespective of visibility conditions. This work discusses the design and implementation of a low-cost, small and portable thermal imaging based human detection system to assist in low visibility environments such as wildlife conservation areas, harsh search and rescue zones, etc. The system integrates Raspberry Pi 4B with FLIR Lepton 3.5 thermal camera and Neo-6M GPS module, powered by YOLOV3 model to perform human detection on captured images. Our newly trained YOLOv3 model demonstrated good performance, achieving an Average Precision at IoU of 0.5 (AP50) of 0.9404 and a recall of 0.6974. This small and portable system can be easily mounted on a UAV or UGV to support a wide range of crucial and challenging surveillance tasks such as anti-poaching. A Flutter-based mobile application is also developed for real time alert notification with GPS coordinates and images captured, enabling rapid and informed decision making. Hence, the proposed holistic approach of efficient infravision human detection based on thermal imaging significantly enhances security and is directly applicable to crucial domains including anti-poaching, search and rescue and disaster management.},
  keywords={Telemetry;Aerospace and electronic systems;Feeds;Integrated circuits;Protocols;Data communication;Information and communication technology;Pixel;Videos;Communications technology;Thermal Infrared (TIR) Imaging;YOLO (You Only Look Once);Object Detection;Infravision;Real-Time Surveillance;GPS Coordinates;Deep Learning},
  doi={10.1109/ICTP67998.2026.11485207},
  ISSN={},
  month={Feb},}

@INPROCEEDINGS{10838065,
  author={Li, Yang and Li, Jing and Wang, Yanping and Lin, Yun and Shen, Wenjie and Jiang, Wen and Bai, Zechao},
  booktitle={2024 IEEE 7th International Conference on Computer and Communication Engineering Technology (CCET)}, 
  title={Analysis of Missed Detections and False Alarms in Radar Occupancy Grid Map Vehicle Detection Networks}, 
  year={2024},
  volume={},
  number={},
  pages={236-240},
  abstract={Millimeter-wave radar can collect data and form images under poor lighting conditions. Radar occupancy grid map vehicle detection plays an important role in confined disaster spaces. This paper uses a YOLO-based neural network model for vehicle object detection. The detection results show that false alarms and missed detections occur when there are objects with similar shapes and sizes near the vehicles or when the vehicles are parked irregularly. These issues can lead to misjudgments in specific situations such as fires in enclosed spaces, affecting rescue efficiency. This paper summarizes the causes of these problems. For the radar occupancy grid map vehicle dataset, Grad-CAM is used to visualize the feature extraction layers of the network model. It is further clarified that the cause of false alarms is the low distinguishability between feature encoding vectors, and the cause of missed detections is the low weight of vehicle features. A dynamic encoding approach is proposed to improve the distinguishability of feature vector encoding and to assign correct weights to the features extracted by the network model.},
  keywords={Space vehicles;Shape;Vehicle detection;Spaceborne radar;Radar detection;Object detection;Feature extraction;Encoding;Vectors;Vehicle dynamics;Deep Learning;Grad-CAM;False Alarms;Missed Detections},
  doi={10.1109/CCET62233.2024.10838065},
  ISSN={2836-5992},
  month={Aug},}

@INPROCEEDINGS{9032876,
  author={Krishna, Sankula Likhith and Chaitanya, Guduru Sai Rama and Reddy, Abbasani Sree Hari and Naidu, Arasada Manoj and Poorna, S.S. and Anuraj, K.},
  booktitle={2019 International Conference on Wireless Communications Signal Processing and Networking (WiSPNET)}, 
  title={Autonomous Human Detection System Mounted on a Drone}, 
  year={2019},
  volume={},
  number={},
  pages={335-338},
  abstract={Since the past decade the use of autonomous and semi-autonomous robotic systems for human assistance has gained immense significance in the fields of defense, medical surgery, industrial automation, automobile assembly, etc. In particular, the development of Unmanned Aerial Vehicles (UAVs) has been a boon to human kind because of their agility to survey inaccessible places with ease. Consequently, UAVs could provide prominent and multi-faceted information in a Search and Rescue (SAR) operation. In order to mitigate the number of casualties involved in a natural disaster, rapid localization of the victims involved is of utmost priority. The paper in hand elucidates the development of an automated human detection system mounted on a drone that can provide the rescuers with the vital data required to execute an effective rescue mission. The proposed UAV can autonomously carryout survey over a preplanned region of interest and detect the survivors. It is also capable of assigning a score of confidence for each human detection, from the video captured through the camera mounted on the UAV. Consequently, this would help in drastic reduction of time spent in coming up with an action plan to accomplish the rescue operation. After a few successful trials, results have been acquired with moderate accuracy in detecting humans with a higher level of confidence.},
  keywords={Cameras;Telemetry;Sensors;Drones;Conferences;Trajectory;Unmanned Aerial Vehicle (UAV);Natural Disaster;Drone;Flight Controller;Human Detection},
  doi={10.1109/WiSPNET45539.2019.9032876},
  ISSN={},
  month={March},}

@INPROCEEDINGS{8848943,
  author={Rosu, Radu Alexandru and Quenzel, Jan and Behnke, Sven},
  booktitle={2019 IEEE International Symposium on Safety, Security, and Rescue Robotics (SSRR)}, 
  title={Reconstruction of Textured Meshes for Fire and Heat Source Detection}, 
  year={2019},
  volume={},
  number={},
  pages={235-242},
  abstract={Automated fire and heat source detection is a helpful and important capability of a robotic system to assist firefighters in various search and rescue (SAR) scenarios. In this paper, we investigate thermal mapping using textured meshes from preregistered LIDAR scans and show how to detect and localize heat sources therein. Further, we propose a novel occupancy mapping approach based on a sparse permutohedral lattice with a contradiction indicator deduced from ray-tracing the mesh. We evaluate our system on three datasets recorded with a micro aerial vehicle (MAV) including heat sources in a hall and real flames at a fire brigades training site. Dynamic objects are removed from the mesh, heat sources are located and their extend estimated.},
  keywords={Three-dimensional displays;Heating systems;Cameras;Sensors;Robots;Laser radar;Image color analysis},
  doi={10.1109/SSRR.2019.8848943},
  ISSN={2475-8426},
  month={Sep.},}

@INPROCEEDINGS{10855134,
  author={Yousefi, Mohammad and Doğan, Emine Berjin and Gelal Soyak, Ece and Karamzadeh, Saeid},
  booktitle={2024 IEEE International Humanitarian Technologies Conference (IHTC)}, 
  title={Improving the Robustness of CNN-Based Human Detection in Multiple Raw UWB Radar Datasets}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Ultra-wideband (UWB) radar technology has gained significant attention for human detection, vital sign monitoring, and activity recognition applications. In this study, a robust deep-learning model capable of detecting human presence in different environments is developed. The model uses only the raw data obtained directly from the radar without preprocessing. The model is trained and tested on different datasets collected via the UWB radar. Transfer learning has been applied to fine-tune the model on datasets to improve the performance and generalization of the model. This study demonstrates the effectiveness of transfer learning in adapting UWB radar-based human detection models to different environments.},
  keywords={Adaptation models;Transfer learning;Activity recognition;Robustness;Data models;Ultra wideband radar;Monitoring;UWB radar;human detection;convolutional neural network;transfer learning},
  doi={10.1109/IHTC61819.2024.10855134},
  ISSN={2837-4800},
  month={Nov},}

@INPROCEEDINGS{11205230,
  author={Yousaf, Jawad and Maharana, Ishita and Galdanci, Hameeda Mahmoud and Yaghi, Maha and Gad, Abdalla and Hassan, Taimur and Ghazal, Mohammed},
  booktitle={2025 12th International Conference on Future Internet of Things and Cloud (FiCloud)}, 
  title={Machine Learning Driven Multiple Human Activity Recognition and Tracking Using Radar Technology: A Review}, 
  year={2025},
  volume={},
  number={},
  pages={418-423},
  abstract={In recent years, human detection and tracking have become crucial in military, search and rescue, and law enforcement agencies. Using machine learning techniques such as two-dimensional convolutional neural network (CNN), support vector machine (SVM), and ResNet in correct detection proves to increase efficiency with a great magnitude. This paper reviews the vast efficient methodologies used in data extraction and signal pre-processing for the effective detection and tracking of multiple human activities. The systematic reviews and quantitative analysis of existing research are thoroughly reviewed. Furthermore, it discusses the assessment and evaluation criteria based on the results extracted to showcase the challenges and opportunities of the methodologies discussed. Moreover, this study also presents the effective techniques for multiple human detection, tracking within a room and through the wall scenarios.},
  keywords={Support vector machines;Wavelet transforms;Radar detection;Radar tracking;Feature extraction;Convolutional neural networks;Human activity recognition;Ultra wideband radar;Systematic literature review;Testing;Human Activity Recognition (HCA);Ultrawideband radars;CNN;Multiple Human;Detection;Tracking},
  doi={10.1109/FiCloud66139.2025.00064},
  ISSN={2996-1017},
  month={Aug},}

@ARTICLE{9043726,
  author={Kim, Youngwook and Alnujaim, Ibrahim and You, Sungjin and Jeong, Byung Jang},
  journal={IEEE Geoscience and Remote Sensing Letters}, 
  title={Human Detection Based on Time-Varying Signature on Range-Doppler Diagram Using Deep Neural Networks}, 
  year={2021},
  volume={18},
  number={3},
  pages={426-430},
  abstract={We propose the detection of humans using millimeter-wave FMCW radar based on time-varying signatures of range-Doppler diagrams using deep recurrent neural networks (DRNNs). Demand for human detection is increasing for security, surveillance, and search and rescue purposes, recently, with a particular focus on urban areas filled with clutter and moving targets. We suggest the classification of targets based on their signatures in range-Doppler plots with time because the signatures can be consecutively observed. We measure five target types: humans, cars, cyclists, dogs, and road clutter using millimeter-wave FMCW radar that transmits fast chirps at 77 GHz. To maximize the classification accuracy using the time-varying range-Doppler signatures of the targets, we investigate and compare the performance of 2-D-deep convolutional neural networks (DCNN), 3-D-DCNN, and DRNN along with 2-D-DCNN. The DRNN plus 2-D-DCNN showed the best performance, and the classification accuracy yields 99%, with the human classification rate of 100%.},
  keywords={Feature extraction;Dogs;Clutter;Automobiles;Doppler effect;Radar detection;Deep convolutional neural networks (DCNN);FMCW radar;human detection;range-Doppler diagram;recurrent neural networks},
  doi={10.1109/LGRS.2020.2980320},
  ISSN={1558-0571},
  month={March},}

@INPROCEEDINGS{8327194,
  author={Roa-Borbolla, Arturo G. and Aguas-Garcia, Yaser and Marin-Hernandez, Antonio and Rios-Figueroa, Homero Vladimir},
  booktitle={2018 International Conference on Electronics, Communications and Computers (CONIELECOMP)}, 
  title={Intelligent wireless network deployment for search and rescue situations}, 
  year={2018},
  volume={},
  number={},
  pages={170-175},
  abstract={Under search and rescue situations the time to find and to rescue victims is very important. The use of autonomous mobile robots can increase the possibility to detect victims while avoiding to expose the life of human teams. In this paper is presented a methodology for the deployment of wireless nodes to provide communication ways on emergency situations. A mobile robot is used to release stand-alone wireless nodes while exploring the environment. Due to the stochastic nature of signals and the unknown factors on the environment, the a priori assumptions of the expansion of the Radio Frequency can not be used. Is then that, analyzing signals of released nodes that the mobile robot decides where to add another node, in order to assure environment coverage. The proposed methodology has proved to provide total coverage with non exhaustive exploration. Exploration is directed by an a priori knowledge of the environment outside of scope of this paper.},
  keywords={Robot sensing systems;Robot kinematics;Wireless sensor networks;Radio frequency;Wireless communication},
  doi={10.1109/CONIELECOMP.2018.8327194},
  ISSN={2474-9044},
  month={Feb},}

@INPROCEEDINGS{11239213,
  author={Ge, Lin and Phang, Swee King and Zhang, Ji and Sariff, Nohaidda},
  booktitle={2025 9th International Conference on Recent Advances and Innovations in Engineering (ICRAIE)}, 
  title={BIM-Assisted Hybrid Path Planning for UAV Navigation in Indoor Fire-Rescue Scenarios Using Reinforcement Learning}, 
  year={2025},
  volume={},
  number={},
  pages={154-159},
  abstract={Fire-rescue operations in high-rise buildings face challenges due to unpredictable fire spread, dense smoke, and changing obstacles. This paper presents a new framework that integrates Building Information Modeling (BIM) with a hybrid UAV navigation and path-planning system. The framework optimizes search and rescue efforts in indoor environments affected by fire. It combines graph-based global search algorithms with reinforcement learning (RL) for adaptive local path adjustments, allowing UAVs to navigate autonomously in complex settings. MATLAB simulations used a vowelized BIM model to test UAV responses to real-time sensor data, including smoke density and temperature changes. The results show improved path efficiency, better coverage of high-risk areas, and reduced response time compared to traditional methods. The UAVs' ability to adapt to changing conditions, driven by real-time sensor data and BIM-based structural information, proves the effectiveness of the approach. This framework can enhance emergency response and has potential for practical use in fire rescue operations.},
  keywords={Temperature sensors;Adaptation models;Buildings;Reinforcement learning;Autonomous aerial vehicles;Emergency services;Real-time systems;Path planning;Data models;Time factors;Building Information Modeling (BIM);fire-rescue;hybrid path planning;reinforcement learning;emergency response;indoor navigation;dynamic path adjustment},
  doi={10.1109/ICRAIE65839.2025.11239213},
  ISSN={},
  month={Aug},}


