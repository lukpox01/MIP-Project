@INPROCEEDINGS{11063894,
  author={Wang, Ruo and Ning, Shangbin and Wang, Shutai and Zhao, Yuxi and Liu, Bo},
  booktitle={2025 5th International Conference on Neural Networks, Information and Communication Engineering (NNICE)}, 
  title={Research on Crowd Detection Combining Deep Learning and CSI}, 
  year={2025},
  volume={},
  number={},
  pages={202-207},
  abstract={ISAC (Integrated Sensing and Communication) refers to the integration of communication and perception capabilities, and the realization of intelligent communication systems by using communication signals for environmental perception and information acquisition. Personnel detection is part of ISAC. Through positioning and number estimation, it provides data and decision support for security, intelligent transportation, market analysis, public health, smart home, and other fields, and improves the safety, convenience, efficiency and comfort of human life. In the research of indoor personnel detection at home and abroad, there are roughly three types of positioning algorithms. In addition to using traditional triangulation, positioning algorithms using scene analysis or proximity have also been developed to reduce measurement errors. Positioning algorithms based on scene analysis have made significant progress in recent years. Among the positioning algorithms based on scene analysis, some are based on machine learning algorithms, and some are based on deep learning algorithms. Previously, most of them used the information obtained by RSS as fingerprints. After CSI was applied, algorithms based on CSI fusion machine learning or deep learning showed their own advantages. This paper first built a convolutional neural network and separated the real and imaginary parts of CSI information into network training, and obtained a perception scheme with a certain prediction accuracy; then, based on the original network, the attention mechanism was added and the CSI amplitude information was used to improve the network and further enhance the network's perception ability. We verified our model on the dataset of the first Wi-Fi Perception Competition. Experiments show that the improved Wi-Fi perception algorithm can detect 96.13% of the people, which is a certain degree of improvement compared to the comprehensive detection performance of WiCount.},
  keywords={Deep learning;Machine learning algorithms;Image analysis;Accuracy;Attention mechanisms;Integrated sensing and communication;Robustness;Personnel;Convolutional neural networks;Wireless fidelity;ISAC;Wi-Fi sensing;crowd counting;Channel-state information;deep learning},
