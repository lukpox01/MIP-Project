@INPROCEEDINGS{11645210,
  author={Fukui, Shota and Morimoto, Naoyuki},
  booktitle={2026 IEEE 50th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={Wi-Fi CSI-Based Anomaly Detection for Multi-Person Occupancy in Private Rooms}, 
  year={2026},
  volume={},
  number={},
  pages={1323-1332},
  abstract={Detecting multiple occupants in private rooms designed for single-person use is important for safety assurance in privacy-sensitive environments. However, conventional monitoring, such as cameras or dedicated sensors, raises privacy concerns and requires additional hardware. This study proposes a nonintrusive method for multi-person occupancy detection using Wi-Fi Channel State Information (CSI), which can be obtained from existing infrastructure. We formulate the problem as anomaly detection, defining single occupancy as normal and multi-person occupancy as anomalous. This enables training using only singleoccupancy data, eliminating the need to collect multi-person data for each deployment environment. Separate Dense Autoencoders are applied to amplitude and phase components of CSI, and temporal modeling is intentionally excluded to reduce behavioral dependence. Multiple decision strategies are introduced to flexibly adjust detection characteristics. Experimental results demonstrate that models trained solely on single-occupancy data can successfully detect multi-person occupancy. The amplitude-based model achieves stable performance, while the phase-based model exhibits higher anomaly sensitivity. Their combination enables control of the trade-off between normal recognition and anomaly detection. The method shows robustness to unseen activities, though performance is influenced by environmental, positional, and subject differences. These results demonstrate the feasibility of privacy-preserving multi-person detection in single-use private rooms.},
  keywords={Modeling;Training;Signal detection;Anomaly detection;Wireless fidelity;Learning (artificial intelligence);Timing;Labeling;Printing;Design methodology;Wi-Fi Channel State Information (CSI);Anomaly Detection;Device-Free Sensing;Occupancy Detection;Autoencoder;Privacy-Preserving Indoor Monitoring},
  doi={10.1109/COMPSAC69091.2026.00177},
  ISSN={2836-3795},
  month={July},}

@ARTICLE{11674145,
  author={Sugiura, Hinaki and Fukazawa, Yusuke and Ogawa, Masakatsu},
  journal={IEEE Access}, 
  title={Dual Echo State Network for Lightweight Wi-Fi CSI-Based Outdoor Pedestrian Counting With Limited Training Data}, 
  year={2026},
  volume={14},
  number={},
  pages={146003-146018},
  abstract={Outdoor pedestrian counting using Wi-Fi channel state information (CSI) is a promising approach for privacy-preserving crowd monitoring. However, practical edge deployment remains challenging because many high-accuracy deep-learning methods require substantial labeled data and computationally costly training. To address this limitation, we propose a Dual Echo State Network (DualESN), a lightweight model that combines two Echo State Network (ESN) reservoirs with different timescales to capture both gradual and abrupt CSI dynamics. We collected Wi-Fi CSI over eight class days on a campus walkway, covering densities from 0 to approximately 180 pedestrians per 30 s, and derived pedestrian-count labels using You Only Look Once (YOLO). We evaluated robustness with limited labeled data using day-wise cross-validation under 7-day and 1-day training conditions. Under the 7-day training condition, DualESN achieved accuracy comparable to several strong baselines, with a training time one to two orders of magnitude shorter than those of the deep-learning baselines. Under the 1-day training condition, DualESN maintained performance comparable to the best-performing baseline, a Temporal Convolutional Network (TCN), in terms of Mean Absolute Error (MAE) and Root Mean Squared Error (RMSE), and significantly outperformed all other baselines in terms of RMSE. Moreover, DualESN required only approximately 1/204 of the TCN training time. In high-density ranges of 81 or more pedestrians per 30 s, DualESN reduced MAE by approximately 34–50% compared with the TCN. These findings indicate that a multi-timescale reservoir design provides a favorable accuracy–training-cost trade-off for edge-based outdoor CSI crowd monitoring.},
  keywords={Reservoirs;Modeling;Training;Pedestrians;Labeling;Wireless fidelity;Distance measurement;Timing;Accuracy;Limiting;Channel state information;echo state network;machine learning;pedestrian counting;reservoir computing;Wi-Fi sensing},
  doi={10.1109/ACCESS.2026.3729255},
  ISSN={2169-3536},
  month={},}


@ARTICLE{11683393,
  author={Dong, Gaofeng and Yang, Kang and Srivastava, Mani},
  journal={IEEE Internet of Things Journal}, 
  title={FuseFi: Combining Irregularly Sampled CSI from Diverse Communication Packets and Frequency Bands for Wi-Fi Sensing}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Existing Wi-Fi sensing systems rely on injecting high-rate probing packets to extract channel state information (CSI), leading to communication degradation and limited deployment flexibility. Although Integrated Sensing and Communication (ISAC) is a promising direction, existing solutions still rely on auxiliary packet injection because they exploit only uniform CSI from a single frame type, discarding approximately 70% of naturally available packets. We present FuseFi, a novel Wi-Fi-based ISAC framework that directly exploits irregularly sampled CSI from diverse communication packets across multiple frequency bands, eliminating intrusive packet injection and introducing no sensing-specific communication overhead. FuseFi integrates a CSI sanitization pipeline to harmonize heterogeneous packets and remove burst-induced redundancy, together with a time-aware attention model that learns directly from non-uniform CSI sequences without resampling. We further introduce CommCSI-HAR, a new dataset with irregularly sampled CSI from real-world dual-band communication traffic. Extensive evaluations on this dataset and, separately, on four public sensing tasks across three benchmark datasets show that FuseFi achieves state-of-the-art accuracy with a compact model size, while fully preserving communication throughput.},
  keywords={Modeling;Wireless fidelity;Timing;Accuracy;Bandwidth;Human activity recognition;Internet of Things;Integrated sensing and communication;Dual band;Frequency;Channel state information (CSI);Internet of Things (IoT);Wi-Fi Sensing;Integrated Sensing and Communication (ISAC)},
  doi={10.1109/JIOT.2026.3731514},
  ISSN={2327-4662},
  month={},}

