@ARTICLE{11449267,
  author={Yang, Kai and Han, Chong and Xia, Yichen and Zhu, Dongsheng and Guo, Jian and Sun, Lijuan},
  journal={IEEE Transactions on Cognitive Communications and Networking}, 
  title={Semi-Supervised Open-Set Through-Wall User Identification via MIMO Radar Respiratory Signals}, 
