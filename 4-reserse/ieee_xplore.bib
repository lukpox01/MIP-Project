@INPROCEEDINGS{11681671,
  author={K, Pradeep Mohankumar and Reddy, Manda Vishal and Janesh, Alavala},
  booktitle={2026 10th International Conference on Inventive Systems and Control (ICISC)}, 
  title={IoT-Based Smart Home Automation Using Multi-Sensor Occupancy Detection and Adaptive Fan Control}, 
  year={2026},
  volume={},
  number={},
  pages={735-740},
  abstract={The demand for smart energy management systems (SEMS) has grown to a higher extent and this has speeded up the adoption of smart home technologies based on Internet of Things (IoT). In a typical fan system, the fans are operated with manual settings and thus waste electricity if a room is not in use or the air is cooler. This paper aims to propose a low cost IoT based framework for smart home automation based on multi-sensor occupancy estimation with adaptive fan control for energy efficient indoor environment management. The proposed system is designed to incorporate a pair of infrared (IR) sensors for the detection of occupancy at the doorway level, a vision module based on YOLOv8 for person detection and a DHT11 sensor for measuring the ambient temperature. The sensor data are processed by an ESP32 microcontroller and used for a two-layer adaptive pulse-width modulation (PWM) control strategy. The control mechanism controls the fan speed dynamically, based on occupancy and provides a thermal override in high temperature situations. An operational reliability increases and abnormal supply conditions detection voltage monitoring subsystem is further provided. A custom indoor occupancy dataset was created from a variety of sources and used to train YOLOv8n. Experimental assessment shows that the real-time system performance is reliable, and that the estimation of occupancy is more accurate when fusing sensor information, while energy consumption is less than with a conventional constant speed operation. The design of the proposed architecture is low cost, modular, and scalable for actual smart homes deployments.},
  keywords={Fans;Internet of Things;Image sensors;Temperature;Signal detection;Smart homes;Timing;Pulse width modulation;Real-time systems;Printing;Internet of Things;Smart Home Automation;ESP32;YOLOv8;Occupancy Detection;Sensor Fusion;Adaptive PWM Control;Energy Optimization;Embedded Systems},
