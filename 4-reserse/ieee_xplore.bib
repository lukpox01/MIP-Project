@INPROCEEDINGS{11689394,
  author={Su, Yue and Liu, Feng and Lai, Zhengliang and Cai, Chunliu},
  booktitle={2026 5th International Conference on Artificial Intelligence, Internet of Things and Cloud Computing Technology (AIoTC)}, 
  title={LibSense-Net a Cross-Modal Graph Transformer Framework for Dynamic Resource Perception in Smart Libraries}, 
  year={2026},
  volume={},
  number={},
  pages={234-240},
  abstract={Modern libraries face significant challenges in realtime resource management, including book mis-shelving, seat occupancy detection, and space utilization optimization. Existing approaches typically rely on single-modal signals such as RFID or WiFi, which are insufficient for comprehensive environment perception. This paper proposes LibSense-Net, a novel crossmodal graph transformer framework for dynamic resource perception in smart libraries. LibSense-Net integrates RFID backscatter signals, WiFi RSSI fingerprints, and acoustic signatures through three core innovations: (1) a Cross-Modal Graph Construction module that models spatial-semantic relationships across modalities; (2) a Hierarchical Spatial-Temporal Transformer with dual-axis self-attention for capturing both spatial dependencies and temporal evolution; and (3) a Dynamic Adaptive Fusion mechanism with uncertainty-aware gating for robust multi-modal integration under varying environmental conditions. Extensive experiments on a real-world library dataset demonstrate that LibSense-Net achieves 96.3% book localization accuracy and 93.7% occupancy detection F1-score, outperforming state-of-the-art methods by 8.2% and 11.5% respectively.},
  keywords={Timing;Wireless fidelity;Libraries;Modeling;Location awareness;Equations;Modules (abstract algebra);Radiofrequency identification;Matrices;Tagging;Cross-modal graph transformer;multi-modal fusion;smart library;dynamic resource perception},
  doi={10.1109/AIoTC71250.2026.11689394},
