@INPROCEEDINGS{11559010,
  author={Zhao, Zhicheng and Kaden, Janik and Blangiardi, Francesco and Streiter, Reinhard and Dhamsania, Kavan Nayanbhai and Langer, Jan and Kuhn, Harald and Heinkel, Ulrich},
  booktitle={2026 IEEE 23rd International Multi-Conference on Systems, Signals & Devices (SSD)}, 
