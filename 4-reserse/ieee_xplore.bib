  author={Aytutuldu, Ilhan and Bilici, Zehra and Genc, Yakup and Akgul, Yusuf Sinan},
  booktitle={2024 6th International Conference on Communications, Signal Processing, and their Applications (ICCSPA)}, 
  title={Indoor Human Counting Based on Range-Doppler Spectrum in the Presence of Material Penetration and Occlusion}, 
