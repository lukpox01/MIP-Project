@INPROCEEDINGS{11707530,
  author={Rothen, Samuel and Ewen, Daniel and Seitz, Johannes and Zander, Dirk and Kuhlenkoetter, Bernd},
  booktitle={AUTOMATION 2026, Innovation trifft Anwendung}, 
  title={Radar-based modular assistance systems as foundation for AI-driven process optimization in hot strip mills}, 
  year={2026},
  volume={},
  number={},
  pages={163-169},
  abstract={Reliable inline measurement in hot strip mills has long been constrained by extreme environmental conditions: radiation temperatures exceeding 1,000 deg C, steam, scale, and mechanical vibrations overwhelm optical and contact-based measurement systems, leaving critical measurement gaps that fundamentally limit data-driven process optimization and AI applications. This paper presents a radar-based modular assistance system that integrates robust inline measurements of width, thickness, and position on a shared platform. A two-stage signal processing architecture combines embedded sensor-level processing, comprising FMCW signal configuration, automatic gain control, CFAR-based detection, and internal drift correction, with a system-level evaluation stage consisting of a hybrid occupancy detection system, dynamic peak selection, sensor fusion, and thermal structural compensation. The modular system design allows flexible adaptation to varying measurement tasks, spatial constraints, and cost requirements, and addresses process-specific edge cases such as the ski effect through vertical scaling of the sensor arrangement. Validation under real production conditions demonstrates a detection rate of 100 % for position detection across more than 10,000 slab passes, a systematic error of mu = −0.04 mm at 1sigma = ±0.76 mm (n = 3,484) for width measurement, and a repeatability of 1sigma = ±0.12 mm (n = 1,422) forthickness measurement against a radiometric reference system with 0.1 mm accuracy. The thermal structural compensation reliably reduces process-induced drift errors to a residual scatter band near 0 mm. The proposed system thus servesnot as an isolated hardware upgrade, but as a fundamental data infrastructure for AI-driven process optimization in hotstrip mills.},
  keywords={},
  doi={},
  ISSN={},
  month={June},}


