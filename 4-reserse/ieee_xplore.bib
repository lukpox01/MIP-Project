@INPROCEEDINGS{10841498,
  author={Prajwal Pathri, Bhargav and Borra, Venkata Sri Hari and Ganduri, Krishna Vamshi and Reddy, Jeereddy Mani Chenna Kesava and Kantipudi, Mahanth Raghav and Jupalle, Maneesh Reddy},
  booktitle={2024 3rd International Conference on Automation, Computing and Renewable Systems (ICACRS)}, 
  title={Smart Hostel Management Through the IoT: Reducing Energy Consumption, Securing Access, and Preventing Theft}, 
  year={2024},
  volume={},
  number={},
  pages={483-489},
  abstract={This research study intends to create an intelligent, automated power management system meant to maximize hostel room security and energy use. Using occupancy sensing, the system automatically controls power supply to guarantee that only required energy is consumed. The project also incorporates a safe door lock detection system by combining RFID (Radio-Frequency Identification) and NFC (Near-Field Communication) technology, therefore enabling smart power settings depending on the resident's unique RFID tag. The system includes a MQ-9 gas sensor that detects gas leaks, so initiating an automated power cutoff and warning occupants, and ultrasonic sensors for occupancy detection, so enhancing safety. Designed to be scalable and reasonably affordable, the solution fits well in many hostel settings. Automating access management and letting homeowners’ control and monitor their power settings via a mobile app linked via a Wi-Fi module gives user convenience priority. This function lets one remotely manage power use, therefore guaranteeing a flawless combination of ease, energy economy, and security. This project provides, all things considered, a clever, scalable hostel administration system.},
  keywords={Energy consumption;Power supplies;Power system management;Sensor systems;Acoustics;Safety;Security;Gas detectors;Monitoring;Intelligent sensors;RFID;NFC;Ultrasonic sensors;MQ-9 Gas sensor;Wi-Fi;Mobile Application;Energy Efficiency},
  doi={10.1109/ICACRS62842.2024.10841498},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{11452518,
  author={Aaquil, A. Mohammed and Divyasri, M. and Akash, K. and Kumar, A.P Sundheep and Rampriya, R. S. and Arun, R. Arumuga},
  booktitle={2026 International Conference on Computing, Communication, Control and Cyber-Physical Systems (I5CPS)}, 
  title={An IoT-Enabled Intelligent Seat Allocation Framework Incorporating Persistent Disruptive Noise Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Shared study spaces frequently can encounter a difficulty with effective seat assigning as there cannot be a real- time view of the seats and levels of noise. Manual monitoring and simple reservation systems are the cause of seat hoarding, inconvenience and lack of user experience. In this paper, we have introduced an IoT solution in the form of Smart Seat Recommendation System, which identifies occupancy via ultrasonic sensors and disruptive noise via a persistent noise detection algorithm. The sensor data are processed with an ESP32 and updated in real time to Firebase on seat status. The mobile app will provide real-time availability of seats, allow reservation and suggest the best seats according to occupancy and noise levels. A four-seat prototype accompanied by experimental validation proves that it has reliable occupancy detection, noise classification, and prevents double booking. It is a scalable, low-priced system that can be used to control smart seating within shared study areas.},
  keywords={Noise;Prototypes;Real-time systems;Acoustics;User experience;Sensor systems;Resource management;Reliability;Intelligent sensors;Recommender systems;IoT;Ultrasonic Sensor;Persistent disruptive Noise Detection;Seat Recommendation;Android Application},
  doi={10.1109/I5CPS67958.2026.11452518},
  ISSN={},
  month={Feb},}

@INPROCEEDINGS{11182343,
  author={Kiruthika, R. and Duraivel, A.N. and Jeyabharathi, S. and J, Baskar and R, Sujith and S, Sakthi Mahandran J},
  booktitle={2025 International Conference on Modern Sustainable Systems (CMSS)}, 
  title={Intelligent Public Sanitation: An IoT-based System for Environmental Sensing and Predictive Cleaning}, 
  year={2025},
  volume={},
  number={},
  pages={370-377},
  abstract={Maintaining proper sanitation in public restrooms is a significant challenge in modern society. Poor hygiene often results from worn-out appliances and costly maintenance. This study proposes an IoT-based smart toilet monitoring system to address these issues by integrating an efficient and cost-effective solution. The system utilizes an ESP32 microcontroller to collect real-time data from various sensors, which is transmitted to the Blynk application for monitoring and management. The proposed system employs sensors to monitor key parameters such as people count (In/Out), air quality, smoke detection, water tank levels, tap water leakage, and wet surface sensing. By analyzing this data, the system predicts the cleanliness status of the toilet, enabling timely maintenance actions. To further enhance hygiene, the system integrates an automated disinfectant mechanism to control bacterial and viral growth during cleaning. This solution aims to reduce the dependency on manual labor while improving sanitation standards in public restrooms. The combination of IoT, automation, and real-time monitoring ensures an effective and efficient approach to maintaining public hygiene.},
  keywords={Microorganisms;Microcontrollers;Manuals;Real-time systems;Cleaning;Sensor systems;Maintenance;Monitoring;Intelligent sensors;Standards;IoT;ESP32;Blynk application;Hygiene monitoring;Automated cleaning;Public toilet maintenance;Sensor-based monitoring;Real-time updates},
  doi={10.1109/CMSS66566.2025.11182343},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{8656753,
  author={Zemouri, Sofiane and Magoni, Damien and Zemouri, Ayoub and Gkoufas, Yiannis and Katrinis, Kostas and Murphy, John},
  booktitle={2018 IEEE International Smart Cities Conference (ISC2)}, 
  title={An Edge Computing Approach to Explore Indoor Environmental Sensor Data for Occupancy Measurement in Office Spaces}, 
  year={2018},
  volume={},
  number={},
  pages={1-8},
  abstract={Human occupancy measurement has become a topic of increasing interest in the past few years, due to the important role it plays in controlling a number of demand-driven applications like smart lighting and smart heating, as well as improving the energy efficiency of these applications in a broader sense. Office occupancy monitoring in commercial buildings can yield huge savings and improvements in terms of thermal, visual, and air quality. However, this is often impeded due to the lack of fine-grained occupancy information. This paper explores the use of low-priced environmental (temperature and humidity) sensor data for measuring occupancy in an office space. The idea behind this work is to leverage the variation divergence between humidity and temperature caused by human presence. We used a Raspberry Pi with a daughterboard called Sense Hat, which is equipped with the environmental sensors used in this study. The results are compared with occupancy data obtained from camera feeds in order to assess the effectiveness and the accuracy of the combined occupancy measurements, and show up to 87% accuracy.},
  keywords={Buildings;Cameras;Monitoring;Temperature sensors;Humidity;Cloud computing;Privacy;Occupancy detection;occupancy measurement;RaspberryPi;Internet of Things;Edge Computing;IBM Cloud},
  doi={10.1109/ISC2.2018.8656753},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11402676,
  author={Mehtre, Manisha and Sutar, Supriya and Bhavalkar, Suyash and Sondawale, Rounk and Sontakke, Swaraj and Suryawanshi, Avishkar},
  booktitle={2025 5th International Conference on Internet of Things: Smart Innovation and Usages (IoT-SIU)}, 
  title={An Intelligent Real-Time Bus Occupancy Monitoring System Using Sensor Fusion and Computer Vision for Smart Public Transport}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Throughout this paper, we have elucidated our concept of a smart bus monitoring system that operates under the IoT (Internet of Things) paradigm, thereby allowing the provision of real-time data for the determination of the number of people occupying seats as well as the overall count of passengers. We intend to determine occupancy by means of HX711 load cells which will provide a clear indication of the seat and the person’s weight. On the other hand, by using a Raspberry Pi Camera Module 3 together with OpenCV, we will be able to detect a human and our proposal is that once the detection is done, an alert will be raised instantly if the bus is overloaded with passengers. A combination of sensor data and vision data is the basis of our system, and the information is processed via a Raspberry Pi 4B microcontroller. The processing of data in real time this way makes it possible to set the rates for or counts of seated capacity; also, the counts of boarding and disembarking will be used for the automatic pricing of fares during bus journeys. This hybrid approach allows us to not only correct errors that arise from only using single input monitoring, but it improves the reliability of total occupancy or seated capacity detection in order to limit potentially false events. Our unified data will also support predictive analysis and optimal route planning, as well as providing a dynamically scheduled or resourced operation based on real-time occupancy counts. Our history information will be used to learn people’s changing behavioural traffic patterns, and improve fleet management. We will want the system to be affordable, easy to scale, deployable in any public transport network, while increasing the efficiency and safety of transport, while improving the opportunities for enjoyment of travel, as well as helping to further urban mobility into smart cities. Raspberry Pi’s integration with platforms like Firebase allows for low latency transfer of data and live dashboards related to analysis on occupancy and fares. The inclusion of GPS tags on data allows us to forecast demand based on some location data. Anomaly Detection helps to find mechanical problems or unforeseen circumstances.},
  keywords={Computer vision;Technological innovation;Smart cities;Traffic control;Sensor fusion;Real-time systems;Smart transportation;Safety;Internet of Things;Monitoring;Seat Occupancy Detection;OpenCV;Raspberry Pi;Passenger Monitoring;Smart Transportation;Fare Automation;Public Transport;Computer Vision},
  doi={10.1109/IOT-SIU65919.2025.11402676},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11631299,
  author={Altinses, Diyar and Schwung, Andreas},
  booktitle={2026 12th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={Residual Physics-Informed Neural Networks for Robust Indoor Occupancy Estimation using Sonar}, 
  year={2026},
  volume={},
  number={},
  pages={2114-2121},
  abstract={Robust indoor occupancy estimation is critical for smart building safety, especially in emergencies where optical sensors fail due to privacy concerns or smoke. While active acoustic sensing offers a non-intrusive alternative, current black-box models often fail to generalize, while analytical models oversimplify reverberation dynamics. To address this, we introduce a residual physics-informed neural network for acoustic crowd counting using edge devices. Our hybrid architecture fuses Sabine’s reverberation theory with a parallel residual branch to correct for non-linear scattering. We validate the approach on a novel real-world sonar dataset collected across three distinct environments. Experimental results demonstrate that our approach outperforms feedforward and recurrent baselines, achieving a detection accuracy of 84.5% and an F1-score of 0.730. Furthermore, the model offers superior interpretability by learning physically plausible absorption parameters and dynamically balancing physical priors with data-driven corrections.},
  keywords={Modeling;Physics;Equations;Renewable Portfolio Standard;Printing;Absorption;Learning (artificial intelligence);Neural networks;Architecture;Computer architecture},
  doi={10.1109/CoDIT70676.2026.11631299},
  ISSN={2576-3555},
  month={July},}

@INPROCEEDINGS{10041292,
  author={Sahoo, Soumya R. and Lone, Haroon R.},
  booktitle={2023 15th International Conference on COMmunication Systems & NETworkS (COMSNETS)}, 
  title={Occupancy counting in dense and sparse settings with a low-cost thermal camera}, 
  year={2023},
  volume={},
  number={},
  pages={537-544},
  abstract={Occupancy detection and counting are crucial to automate buildings' lighting, heating, and cooling systems. However, most existing occupancy detection and counting techniques are underperforming or privacy-averse. In this work, we propose an adaptive blob filtering algorithm for processing thermal images and evaluate several classification algorithms for occupancy counting. We evaluate the performance of the proposed algorithm using a low-cost privacy-preserving thermal camera under both sparse and dense occupancy settings. Our results show that the proposed algorithm improves occupancy counting results significantly compared to two existing baselines, resulting in an average accuracy of 84.5% under dense classroom settings.},
  keywords={Heating systems;Cooling;Buildings;Lighting;Filtering algorithms;Cameras;Classification algorithms;occupancy counting;thermal images;MLX90640},
  doi={10.1109/COMSNETS56262.2023.10041292},
  ISSN={2155-2509},
  month={Jan},}

@INPROCEEDINGS{11295361,
  author={Khan, Hamdan Zaman and Yadav, Harsh and Shukla, Varun and Khan, Mohammad Shoaib and Mandal, Anshul Kumar},
  booktitle={2025 International Conference on Sustainability, Innovation & Technology (ICSIT)}, 
  title={InsightX-A Smart Vision System for Human and Environmental Context Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In today's rapidly advancing world of smart surveillance and automation, being able to identify people and monitor environmental conditions in real time has become increasingly important. This paper introduces InsightX, a powerful and flexible desktop application created with OpenCV and Python. InsightX is designed to handle a variety of surveillance tasks, including real-time facial recognition, counting the number of people present, detecting whether lights are on or off using visual cues, and determining if a fan is running by analyzing audio. The system also allows users to upload video files for retrospective facial recognition and data analysis. Built to be affordable and easy to expand, InsightX is well-suited for use in schools, businesses, and homes. By combining traditional surveillance with intelligent, context-aware features, InsightX lays the groundwork for more advanced automation systems in the future.},
  keywords={Visualization;Automation;Surveillance;Face recognition;Scalability;Machine vision;Manuals;Real-time systems;Reliability;Videos;Smart Surveillance;Facial Recognition;OpenCV;Headcount System;Artificial Intelligence;Machine Learning},
  doi={10.1109/ICSIT65336.2025.11295361},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{11081274,
  author={Reddy, Balaram and Raj, Jebarson and Aroulanandam, Vijay Vasanth},
  booktitle={2025 3rd International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)}, 
  title={ParkAI: Real-Time Smart Parking Management using Hybrid YOLOv11-SSD Detection}, 
  year={2025},
  volume={},
  number={},
  pages={195-200},
  abstract={Urban areas are facing increased parking challenges, resulting in congestion, wasted time, and driver annoyance. Existing parking systems are generally aimed at occupancy detection or basic reservation functions, with no real-time feedback, navigation support, or proximity to neighboring service data. ParkAI fills these voids with an end-to-end smart parking system that not only senses real-time vacant parking spots but also permits pre-reservation of parking spots and effortless navigation to the spots. ParkAI also includes important urban services by detecting nearby gas stations and EV charging stations with occupancy data, enhancing user convenience. In comparison to earlier systems that were based on either heavy hardware sensor dependency (e.g., RFID or ultrasonic) or the presence of static parking data, ParkAI integrates AI-based computer vision models with enhanced mobile application capabilities for dynamic space detection, reservation, and guidance. ParkAI is an enhancement over existing proposals with real-time flexibility, slot-by-slot reservation, canceling features, and city service point integration in a single homogeneous system. By reducing the dependency on parking search time, alleviating traffic congestion, and facilitating efficient city mobility, ParkAI is a major enhancement over conventional and sensor-based parking systems.},
  keywords={Navigation;Urban areas;Automated parking;Real-time systems;Electric vehicle charging;Mobile applications;Proposals;Artificial intelligence;Traffic congestion;Radiofrequency identification;smart parking;YOLOv11;SSD;AI;Geocoding},
  doi={10.1109/ICSSAS66150.2025.11081274},
  ISSN={},
  month={June},}

@INPROCEEDINGS{10872700,
  author={Ahmed, Mohamed Mohamud and Rashid, Rozeha A. and Ali, Abdirahman Abdikarim and Mohammed, Mohammed Taha and Diblawe, Abdulkadir Mukhtar and Salim, Mohd Rashidi and Abdikadir, Nuradin Mohamed and Afwah, Abdullahi Aweis},
  booktitle={2024 IEEE 22nd Student Conference on Research and Development (SCOReD)}, 
  title={Integrating IoT Technologies for Smart Parking Management: A Cost-Effective System with Telegram-Based Real-Time Alerts}, 
  year={2024},
  volume={},
  number={},
  pages={670-674},
  abstract={As urbanization and vehicle ownership continue to rise, parking challenges significantly contribute to traffic congestion, fuel wastage, and heightened carbon emissions, with drivers spending considerable time searching for available spaces. Traditional parking systems often fail to address these issues efficiently, while current smart parking solutions are hindered by high costs, communication delays, and limited scalability. This study introduces a cost-effective IoT-based Smart Parking System integrating real-time monitoring, automated gate operations, and Telegram-based notifications to enhance parking management. Utilizing ultrasonic and infrared sensors for precise vehicle detection, the system employs MQTT for seamless communication with the Favoriot cloud platform, ensuring robust data management and instant notifications. Automated gate control, executed through servo motors managed by a Raspberry Pi and orchestrated by Node-RED, ensures smooth operation. Results demonstrate that the system achieves 97% accuracy in slot occupancy detection, reduces parking search time by 40%, and ensures real-time notifications with less than a 1 -second delay. This scalable and user-friendly solution not only fills existing research gaps but also optimizes parking space utilization and promotes a sustainable urban environment by minimizing unnecessary vehicle emissions. The findings highlight the potential of IoT technologies to deliver efficient, real-time parking management for modern urban needs.},
  keywords={Space vehicles;Cloud computing;Urban areas;Automated parking;Logic gates;Infrared sensors;Real-time systems;Acoustics;Delays;Internet of Things;Internet of Things (IoT);Node-red;Telegram;MQTT;Favoriot cloud platform;Node-RED},
  doi={10.1109/SCOReD64708.2024.10872700},
  ISSN={2643-2447},
  month={Dec},}

@INPROCEEDINGS{11102637,
  author={Reddy, Vanga Harshith and Raju, Vadicherla and Kandakatla, Rajashekar and Ajay, Satharla and Devi, Thalari},
  booktitle={2025 International Conference on Networks and Cryptology (NETCRYPT)}, 
  title={Smart Iot-Based Parking System with Real-Time Availability}, 
  year={2025},
  volume={},
  number={},
  pages={11-16},
  abstract={Urban parking congestion, particularly in indoor facilities, leads to significant time loss and increased traffic due to drivers searching for vacant slots. This research aims to develop a Smart IoT-Based Parking System that provides real-time availability updates to enhance parking efficiency. The system utilizes ultrasonic sensors to detect the presence and distance of vehicles, with data processed by an Arduino-based microcontroller. Slot occupancy is visually indicated via LED(light emitting diode) signals (green for available, red for occupied), while users receive real-time updates through a connected smartphone interface via Wi-Fi. Initial implementation demonstrates a 65 % reduction in time spent searching for parking, alongside improved traffic flow within the facility. The system's modular and scalable architecture allows for easy adaptation to various indoor parking layouts, offering a practical and efficient solution for modern smart city infrastructure. City-based parking challenges developed as a direct result of quick urbanization and speedily increasing automobile ownership worldwide. Traditional manual signage systems for parking management operate at low efficiency by producing traffic jams along with fuel usage and environmental damage [1]. Modern cities can solve their current parking establishment problems through IoT (Internet of Things) systems integrated into parking management control. Real-time analytics operating through IoT sensors together with cloud technologies better determines how parking spots get used. The system performs automatic spot direction capabilities coupled with entrance-exit automation functions alongside vehicle occupancy detection which reduces search times by clearing traffic congestion [2]. IoT-based parking technologies when implemented reduce carbon emissions from vehicles while simultaneously reducing fuel costs thus they contribute to sustainability benefits. The broad implementation of this system demands solution of three critical challenges which involve the high price of implementation alongside connection difficulties and security vulnerabilities. The development of smart urban mobility solutions for the future heavily depends on IoT-based smart parking technologies since urban expansion will continue to increase.},
  keywords={Cloud computing;Smart cities;Microcontrollers;Automated parking;Real-time systems;Sensor systems;Internet of Things;Fuels;Intelligent sensors;Wireless fidelity;Internet of Things;Sensors;Arduino;Smart Parking},
  doi={10.1109/NETCRYPT65877.2025.11102637},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11604320,
  author={Rani, Jyoti and Budhiraja, Sourabh and Sharma, Meenakshi and Choudhary, Satyam and Yadav, Anup Lal},
  booktitle={2026 IEEE Nexo-Tech - International Conference on Advanced Technologies and Innovations (ICATI)}, 
  title={Design and Implementation of a Cloud-Enabled IoT Smart Parking System}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The high pace of urbanization and the relentless growth in the number of vehicles have worsened the problem of parking congestion in the urban environment thus contributing to the increased travel time, fuel consumption, and the level of environmental pollution. In that regard, the proposed study is aimed at the design and deployment of an IoT- and cloud-based smart parking system that provides real-time data about the availability of parking spaces, automates the operation of the gates, supports the services of a reservation, and provides an opportunity to pay via a mobile application. The system does a combination of ultrasonic or infrared sensors placed on each parking space and Arduino Uno and ESP8266 NodeMCU modules to decide the presence of a vehicle and send the signal to a cloud environment where it would be centralized. The prototype has been experimentally tested and has proven to have over 90% occupancy detection accuracy and an average of less than two seconds system response time in response to user queries. Observations in the field indicate that a 15–20-minute decrease in the average time of search in parking vehicles per car and a more or less 30 percent increase in the use of park space are observed. The satisfaction rate of the users is indicated at around 75 percent, which speaks of the usability and convenience of the system. Besides, it is the efficient energy architecture that provides a saving of about 25% in comparison to the traditional parking management systems. These findings clearly prove that the suggested IoT-based smart parking system can improve the efficiency of parking, help reduce traffic jams, and promote development of smart cities that are sustainable.},
  keywords={Internet of Things;Timing;Image sensors;Automated parking;Real-time systems;Urban areas;Vehicles;Printing;Technology;Clouds;Parking space;traffic congestion;cloud-based server;sensors;internet of things (IoT)},
  doi={10.1109/ICATI69399.2026.11604320},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11336629,
  author={Suryawanshi, Ranjeetsingh and Abrol, Vansh and Uparkar, Prabhakar and Waghmare, Anjali and Wagh, Maithili and Ughade, Vijay},
  booktitle={2025 International Conference on Future Technologies (ICFT)}, 
  title={IoT-Based Smart Parking and Wireless EV Charging System}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Rapid urbanization and the global transition to Electric Vehicles (EVs) have created a critical demand for integrated, efficient urban infrastructure. Current parking systems are typically inefficient and lack seamless EV charging capabilities, which hinders the adoption of sustainable mobility solutions. This paper proposes and implements an IoT-Based Smart Parking and Wireless EV Charging System designed to solve the dual challenges of parking congestion and inconvenient wired charging. The novelty of our approach lies in the seamless fusion of RFID-based vehicle access control, real-time parking slot management, and inductive wireless power transfer (WPT), all managed through a unified, cloud-backed platform. The system architecture leverages NodeMCU ESP8266 microcontrollers, ultrasonic sensors for occupancy detection, and Firebase for secure authentication and real-time data synchronization with a responsive web interface. Experimental evaluation demonstrates the system's high reliability, achieving a 98.5% success rate for RFID authentication and a competitive 65.17% power transfer efficiency for the WPT subsystem. Additionally, the average system synchronization delay with the cloud is very low, at just 1.2 seconds. These results show that the system has the potential to greatly improve operational efficiency, user convenience, and safety in city parking areas. The framework introduced here provides a scalable model for integrating smart city technologies, and it supports future improvements such as dynamic pricing and predictive parking management.},
  keywords={Wireless communication;Wireless sensor networks;Authentication;Automated parking;Real-time systems;Electric vehicle charging;Safety;Communication system security;Synchronization;Radiofrequency identification;Smart Parking;Wireless EV Charging;RFID Authentication;ESP8266;Arduino Uno;Firebase;Real-Time Monitoring},
  doi={10.1109/ICFT66708.2025.11336629},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11517696,
  author={Prathipa, R and Saranya, S and Selvakumar, Varshini and Poonguzhali, I and Arun, M and Dillibabu, Karishma},
  booktitle={2026 International Conference on Intelligent Computing (ICONIC)}, 
  title={Smart Campus Safety and Energy Management System Using IoT}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Educational facilities require a significant quantity of electrical power because they need to keep their lighting systems their ventilation systems and their safety systems operational at all times. The systems on many campuses require manual control which leads to energy wastage because classrooms and hallways remain empty. Security needs to be maintained during non-working hours because of energy waste which results from traditional monitoring systems unable to detect unauthorized entry and dangerous situations such as fire outbreaks. This study presents an IoT-enabled multi-sensor system for campus safety and energy management which delivers both energy efficiency solutions and essential safety requirements. The proposed system includes various sensors which consist of PIR sensors ultrasonic sensors LDR modules temperature sensors flame sensors and a real-time clock (RTC) module that connects to an ESP32 microcontroller. The system achieved better accuracy in detecting occupancy because it used multiple sensor inputs instead of relying on one sensor input. The system uses environmental data together with time data to control lighting and fan operations which helps to achieve optimal energy efficiency. The experimental results demonstrate that this approach effectively decreases unnecessary energy use while enhancing campus security throughout the entire campus area. The system which we developed offers cost-effective solutions that can be easily expanded for practical use in schools. The researchers examined the proposed system through tests conducted in environments that simulated classrooms and hallways using various operational conditions. The system achieved $90 \%$ occupancy detection accuracy with 355 ms fire detection response time and an estimated $58 \%$ reduction in device operating hours which can be deployed at low cost.},
  keywords={Image sensors;Internet of Things;Lighting;Signal detection;Timing;Fires;Monitoring;Safety;Fans;Energy;Internet of Things;Smart Campus;Energy Management;Multi-Sensor System;ESP32;Safety Monitoring},
  doi={10.1109/ICONIC67661.2026.11517696},
  ISSN={},
  month={March},}

@INPROCEEDINGS{11318701,
  author={Nair, Raveena R and Anand, Shraddha and Saha, Akansha and S., Sreecharan and Chabbria, Krish and Shreeram, T.},
  booktitle={2025 7th International Symposium on Advanced Electrical and Communication Technologies (ISAECT)}, 
  title={Unified IoT Framework for Smart Parking Management and EV Charging Stations}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Smart urban infrastructure demands real-time, efficient, and scalable solutions for vehicular parking and electric vehicle (EV) charging. The current paper suggests a Unified IoT Framework, which would consolidate the smart parking management and EV charging infrastructure based on a multi-layered architecture of IoT sensors, edge gateways, and cloud analytics. The system includes ultrasonic and infrared (IR) sensors to understand the occupancy of parking slots, the current and voltage sensors to track the EV charging parameters. Information is gathered using microcontrollers and handled locally on Jetson Nano edge gateways and transferred to a cloud backend via MQTT over LoRaWAN, NB-IoT, or Wi-Fi, depending on the environmental conditions. The design uses dynamic slot assignment using Q-learning, predictive pricing, and blockchain-based billing to enhance integrity and confidence to the users. An experimental analysis in a testbed of 50 parking slots and 10 EV charging stations showed that the occupancy detection accuracy could be measured at 98.2 on average, and that billing integrity and network uptime were 100.0 and 99.5 respectively. The edge processing latency was below 50 ms which confirms the responsiveness of the system. The integrated platform also realized an efficient load balancing of energy with 23.5% of the charging energy coming out of solar panels demonstrating its sustainability. The findings have validated the fact that the suggested framework is strong, flexible, and prepared to implement in reality in cities and suburbs.},
  keywords={Cloud computing;Q-learning;LoRaWAN;Automated parking;Logic gates;Electric vehicle charging;Sensor systems;Vehicle dynamics;Intelligent sensors;Wireless fidelity;IoT;Smart Parking;EV Charging;Q-learning;Edge Computing;LoRaWAN;Blockchain Billing;MQTT;Cloud IoT;Sensor Network;Renewable Integration;Smart Mobility;Dynamic Allocation},
  doi={10.1109/ISAECT68904.2025.11318701},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{11688667,
  author={A, Santhana shalin raj and Kumar, P. and Kumar, M. Pradeep and Madhankumar, C. and Ranganayaki, V. and Sivaraju, S.S.},
  booktitle={2026 International Conference on Modern Sustainable Systems (CMSS)}, 
  title={IoT-Driven Smart Parking System with LSTM-Based Predictive Analytics and Dynamic Slot Allocation for Smart Cities}, 
  year={2026},
  volume={},
  number={},
  pages={748-755},
  abstract={Severe parking congestion has become a common problem in urban areas due to rapid urbanization and ever-growing vehicles, causing longer search time, fuel wastage, traffic congestion and higher carbon emissions. In this paper, we propose an intelligent IoT-LSTM Smart Parking Framework which combines the capabilities of the IoT-based occupancy sensing to gather the on-site data, the cloud-based data management system, the deep learning-based parking availability prediction and the dynamic parking reservation for efficient parking management. The ESP32 controllers, which are equipped with ultrasonic sensors, continuously check the status of the parking space, and the data is sent to the cloud via Wi-Fi/MQTT communication for real-time analysis and storage. A historical parking occupancy data is used to train an LSTM model which is used to predict future parking availability with a high level of accuracy and a dynamic parking allocation mechanism allocates optimal parking space based on predicted availability and proximity. The proposed framework was tested in a 50 -slots parking lot which was continuously monitored for 30 days. The experimental results showed accuracy in parking space occupancy detection of 98.6%, prediction of 96.8%, precision of 98.1%, F1-score of 98.2%, parking space utilization of 95.2%, and a success rate of 97.4% in making reservations, while the average parking search time was reduced from 8.7 min to 1.8 min. The communication infrastructure also showed the packet delivery ratio 99.1%, the transmission delay 145 ms and network reliability 98.9%, which proved the proposed communication infrastructure suitable for real-time deployment. The proposed IoT-LSTM framework is capable of providing an accurate, scalable and sustainable smart parking solution that could help to enhance urban mobility and be integrated into nextgeneration intelligent transportation systems and smart city infrastructures.},
  keywords={Internet of Things;Timing;Modeling;Long short term memory;Automated parking;Image sensors;Real-time systems;Availability;Clouds;Accuracy;Smart Parking System;LSTM;Parking Availability Prediction;Dynamic Reservation;Intelligent Transportation Systems},
  doi={10.1109/CMSS69636.2026.11688667},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{9842451,
  author={Benjdira, Bilel and Koubaa, Anis and Boulila, Wadii and Ammar, Adel},
  booktitle={2022 2nd International Conference of Smart Systems and Emerging Technologies (SMARTTECH)}, 
  title={Parking Analytics Framework using Deep Learning}, 
  year={2022},
  volume={},
  number={},
  pages={200-205},
  abstract={With the number of vehicles continuously increasing, parking monitoring and analysis are becoming a substantial feature of modern cities. In this study, we present a methodology to monitor car parking areas and to analyze their occupancy in real-time. The solution is based on a combination between image analysis and deep learning techniques. It incorporates four building blocks put inside a pipeline: vehicle detection, vehicle tracking, manual annotation of parking slots, and occupancy estimation using the Ray Tracing algorithm. The aim of this methodology is to optimize the use of parking areas and to reduce the time wasted by daily drivers to find the right parking slot for their cars. Also, it helps to better manage the space of the parking areas and to discover misuse cases. A demonstration of the provided solution is shown in the following video link: https://www.youtube.com/watch?v=KbAt8zT14Tc.},
  keywords={Deep learning;Visualization;Urban areas;Pipelines;Streaming media;Ray tracing;Real-time systems;Deep Learning;Parking Analysis;Parking Monitoring;Video Analytics;YOLO;Deep SORT},
  doi={10.1109/SMARTTECH54121.2022.00051},
  ISSN={},
  month={May},}

@INPROCEEDINGS{10774769,
  author={Jain, Samyak and Gupta, Shubhi and Jain, Rajashree and Narsingoju, Bhavana},
  booktitle={2024 8th International Conference on Computing, Communication, Control and Automation (ICCUBEA)}, 
  title={Design of Smart Parking System using IoT}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Increasing urbanization has increased load on the city roads, traffic and parking systems. It is essential to leverage Information Communication Technologies (ICT) to enhance traffic and parking system services in an urban area. With available hardware components and software platform researchers are exploring to build effective solutions to resolve citizen problems. The present paper uses available off the shelf component to build a smart parking system. A tripod approach was used. Such a smart parking system involves user management, parking space management and cloud based administration. IR sensors are used for parking space occupancy detection; these sensors are connected to an Atmel AtMega microcontroller available on Arduino UNO. The information is communicated through a Wi-Fi protocol and cloud services were utilized using Blynk platform. The designed prototype is presented in this paper. The proposed model is an effective way of managing mid-sized parking spaces},
  keywords={Cloud computing;Protocols;Microcontrollers;Urban areas;Prototypes;Automated parking;Software;Road traffic;Intelligent sensors;Wireless fidelity;Internet of Things;Sensors;IR Sensors;Blynk;Smart Parking System},
  doi={10.1109/ICCUBEA61740.2024.10774769},
  ISSN={2771-1358},
  month={Aug},}


