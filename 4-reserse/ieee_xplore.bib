  number={},
  pages={1332-1336},
  abstract={Low-resolution infrared (IR) array sensors offer a low-cost, low-power, and privacy-preserving alternative to optical cameras and smartphones/wearables for social distance monitoring in indoor spaces, permitting the recognition of basic shapes, without revealing the personal details of individuals. In this work, we demonstrate that an accurate detection of social distance violations can be achieved processing the raw output of a 8x8 IR array sensor with a small-sized Convolutional Neural Network (CNN). Furthermore, the CNN can be executed directly on a Microcontroller (MCU)-based sensor node.With results on a newly collected open dataset, we show that our best CNN achieves 86.3% balanced accuracy, significantly outperforming the 61% achieved by a state-of-the-art deterministic algorithm. Changing the architectural parameters of the CNN, we obtain a rich Pareto set of models, spanning 70.5-86.3% accuracy and 0.18-75k parameters. Deployed on a STM32L476RGMCU, these models have a latency of 0.73-5.33ms, with an energy consumption per inference of 9.38-68.57$\mu$J.},
  keywords={Quantization (signal);Microcontrollers;Shape;Human factors;Social factors;Convolutional neural networks;Optical sensors;Social Distance;COVID-19;Edge Computing;Infrared Sensors;Convolutional Neural Networks},
  doi={10.1109/ISCAS48785.2022.9937837},
  ISSN={2158-1525},
  month={May},}

@INPROCEEDINGS{11560578,
  author={Hu, Yunfei and Liu, Shuguang and Nie, Liangyuan},
  booktitle={2026 38th Chinese Control and Decision Conference (CCDC)}, 
  title={The Intelligent Lighting System of Classroom Based on Internet of Things}, 
  year={2026},
  volume={},
  number={},
  pages={7143-7147},
  abstract={In the context of current educational informatization and green campus initiatives, the design and implementation of intelligent classroom lighting systems have become particularly crucial. Traditional classroom lighting systems often neglect energy conservation, student learning experience enhancement, and smart functionality. In contrast, intelligent lighting systems can automatically adjust light intensity based on actual needs, providing an optimal learning environment while achieving energy efficiency and emission reduction. This paper proposes an IoT-based intelligent classroom lighting system that integrates infrared sensors to monitor real-time classroom occupancy and control lighting accordingly, thereby improving energy efficiency and learning environment quality. Additionally, the system supports both manual and remote control modes, enhancing user interaction experience.},
  keywords={Lighting;Modules (abstract algebra);Timing;Displays;Bluetooth;Real-time systems;Microcontrollers;Testing;Design methodology;Light emitting diodes;Smart classroom lighting;microcontroller control;Bluetooth communication;infrared people counting;LED energy-saving lamps;remote monitoring;user interface;learning environment optimization},
  doi={10.1109/CCDC69976.2026.11560578},
  ISSN={1948-9447},
  month={May},}

@INPROCEEDINGS{9025336,
  author={Nowruzi, Farzan Erlik and El Ahmar, Wassim A. and Laganiere, Robert and Ghods, Amir H.},
  booktitle={2019 IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)}, 
  title={In-Vehicle Occupancy Detection With Convolutional Networks on Thermal Images}, 
  year={2019},
  volume={},
  number={},
  pages={941-948},
  abstract={Counting people is a growing field of interest for researchers in recent years. In-vehicle passenger counting is an interesting problem in this domain that has several applications including High Occupancy Vehicle (HOV) lanes. In this paper, present a new in-vehicle thermal image dataset. We propose a tiny convolutional model to count on-board passengers and compare it to well known methods. We show that our model surpasses state-of-the-art methods in classification and has comparable performance in detection. Moreover, our model outperforms the state-of-the-art architectures in terms of speed, making it suitable for deployment on embedded platforms. We present the results of multiple deep learning models and thoroughly analyze them.},
  keywords={Cameras;Convolution;Visualization;Machine learning;Feature extraction;Computational modeling;Training},
  doi={10.1109/CVPRW.2019.00124},
  ISSN={2160-7516},
  month={June},}

@ARTICLE{9839444,
  author={Emad-ud-Din, Muhammad and Chen, Zhangjie and Wu, Libo and Shen, Qijie and Wang, Ya},
  journal={IEEE Sensors Journal}, 
  title={Indoor Occupancy Estimation Using Particle Filter and SLEEPIR Sensor System}, 
  year={2022},
  volume={22},
  number={17},
  pages={17173-17183},
  abstract={We recently developed a synchronized low energy electronically chopped passive infrared (SLEEPIR) sensor that can detect both stationary and moving occupants by incorporating a liquid crystal (LC) shutter with a traditional passive infrared (PIR) sensor. However, its detection accuracy is still largely impacted by environmental infrared noises. In this paper, we present a Particle Filter (PF) based system-level algorithm that employs a network of SLEEPIR sensors which are installed at different points of interest within an indoor space. The method interprets the incoming observations from the field of view (FOV) of each sensor via the likelihood function to update the state of the PF. The PF output is a probability density function (pdf) that represents the occupancy state of the entire observed space. The sensor location, observation cone, range, observation frequency and historic inter-sensor correlation are the key parameters that contribute to the likelihood function design. Since the method utilizes the historic correlation among sensors, the pairs of correlating sensors often perform self-correction whenever a faulty observation is encountered due to either sensor limitations or due to environmental noise. Occupancy is established through a thresholding function applied to the output pdf of the PF. A lab-based dataset was collected over a period of 360 hours using the SLEEPIR sensor system. Results indicate an average 8.25% occupancy accuracy improvement when compared to the accuracy state delivered by individual SLEEPIR nodes.},
  keywords={Sensors;Sensor systems;Particle filters;Monitoring;Estimation;Temperature sensors;Mechanical sensors;Bayes filters;smart devices;recurrent neural networks;edge computing;passive infrared sensors},
  doi={10.1109/JSEN.2022.3192270},
  ISSN={1558-1748},
  month={Sep.},}

@INPROCEEDINGS{11468329,
  author={Khan, Zaid Ahmad and Shukla, Yash and Khaleeq, Musab Bin and Sarfraz, Mohammad},
  booktitle={2026 6th International Conference on Multimedia, Signal Processing and Communication Technologies (IMPACT)}, 
  title={Real-Time Data Collection Using a Hybrid IoT-Based DAS with LSTM-Based Load Forecasting for Air Conditioner Power Consumption}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Real monitoring and predictive control of high-consumption power appliances like air conditioners are needed for efficient energy management in residential and commercial spaces to meet the growing demand. This project has developed and presented a hybrid IoT-enabled system combining deep learning-based forecasting and hardware-based sensing. An ESP32 microcontroller, interfaced with a DHT22 sensor and an infrared sensor, was employed to acquire indoor temperature, humidity, and occupancy count, while wired power measurements of the air conditioner were done by an Arduino UNO equipped with a PZEM-004T sensor. The acquired datasets were pre-processed into synchronized time series and were used to train a Long Short-Term Memory (LSTM) neural network to forecast power consumption over the next 90 time steps. The proposed system was then evaluated using metrics such as MAE, RMSE, and $\mathbf{R}^{\mathbf{2}}$, demonstrating good accuracy and confirming that energy management is possible by combining machine learning and IoT-based real-time monitoring.},
  keywords={Microcontrollers;Microprocessors;Internet of Things;Web servers;Wireless fidelity;Communications technology;Protocols;Communication systems;HTTP;Wireless LAN;Home Energy Management System (HEMS);Load Forecasting;Air Conditioning;Data Acquisition System;Long Short-Term Memory (LSTM);Machine Learning},
  doi={10.1109/IMPACT68503.2026.11468329},
  ISSN={2690-8239},
  month={Feb},}

@INPROCEEDINGS{9648694,
  author={Saengthong, Phurich and Charnsripinyo, Chalermpol and Laitrakun, Seksan},
  booktitle={2021 13th International Conference on Knowledge and Systems Engineering (KSE)}, 
  title={Energy-efficient Airflow Control for Human Thermal Comfort using Object Detection and Monocular Depth Estimation}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={A split-type air conditioner is installed in many households and buildings to produce a comfortable environment. The air conditioner is still mostly operated with occupant&#x0027;s configurations through the remote control. However, it may unexpectedly affect the occupant&#x0027;s health because of the static configurations. Furthermore, improper configurations can reduce the energy-efficient of the air conditioner usage. To address these challenges, we propose a smart control system that is able to automatically control configurations of the air conditioner, including airflow direction, wind speed, and temperature parameters. The smart control system is operated under an embedded box, including a small-embedded device and a camera sensor. It is applied with occupancy detection through object detection and monocular depth estimation through SSD-MobileNetV2 and FastDepth. The occupancy detection integrated environment sensing from the temperature sensor at the living area can help the embedded box determine the optimum control of the air conditioner. The results show that our smart control approach makes a fast comfortable environment and maintains quality of comfort for the entire period of usage with lower energy consumption.},
  keywords={Temperature sensors;Temperature dependence;Wind speed;Estimation;Object detection;Control systems;Cameras;energy-efficient;air conditioner control;occupancy detection;monocular depth estimation;deep learning},
  doi={10.1109/KSE53942.2021.9648694},
  ISSN={2694-4804},
  month={Nov},}

@INPROCEEDINGS{9816801,
  author={Xie, Chen and Pagliari, Daniele Jahier and Calimera, Andrea},
  booktitle={2022 17th Conference on Ph.D Research in Microelectronics and Electronics (PRIME)}, 
  title={Energy-efficient and Privacy-aware Social Distance Monitoring with Low-resolution Infrared Sensors and Adaptive Inference}, 
  year={2022},
  volume={},
  number={},
  pages={181-184},
  abstract={Low-resolution infrared (IR) Sensors combined with machine learning (ML) can be leveraged to implement privacy-preserving social distance monitoring solutions in indoor spaces. However, the need of executing these applications on Internet of Things (IoT) edge nodes makes energy consumption critical. In this work, we propose an energy-efficient adaptive inference solution consisting of the cascade of a simple wake-up trigger and a 8-bit quantized Convolutional Neural Network (CNN), which is only invoked for difficult-to-classify frames. Deploying such adaptive system on a IoT Microcontroller, we show that, when processing the output of a $8\times 8$ low-resolution IR sensor, we are able to reduce the energy consumption by 37-57% with respect to a static CNN-based approach, with an accuracy drop of less than 2% (83% balanced accuracy).},
  keywords={Energy consumption;Adaptive systems;Human factors;Social factors;Energy efficiency;Sensor systems;Internet of Things;Edge Computing;Adaptive Inference;Social Distancing;Energy Efficiency;Infrared Sensor},
  doi={10.1109/PRIME55000.2022.9816801},
  ISSN={},
  month={June},}

@INPROCEEDINGS{11005196,
  author={V, Santhi and Balaji K, Mukesh and G, Nandikaa and G, Samendhra and Ramesh, Shreya and Thiagarajan, Shreya},
  booktitle={2025 International Conference on Wireless Communications Signal Processing and Networking (WiSPNET)}, 
  title={Smart Lab Management: Real-Time Occupancy Monitoring and Analysis using Edge Computing and Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a comprehensive study on the various components needed to develop a lab occupancy monitoring system to optimize lab usage during peak times. The system architecture consists of communication modules - WiFi and LoRaWAN, which were studied and evaluated, a deep learning model optimized for real-time occupancy detection on Raspberry Pi, and a structured lab setup for effective sensor placement. By aggregating data from the sensors and a camera module, the system identifies occupied and available workstations leading to efficient lab management. The system achieved an accuracy of 0.86, precision of 0.86, and mAP50 of 0.75, demonstrating the effectiveness of the optimized deep learning model for real-time occupancy detection. WiFi supports high data rates (30 Mbit/s) but suffers from high packet loss (> 50%) and latency (around 5 ms), making it ideal for camera feeds. LoRa offers robust signal quality (RSSI: -80 to -50 dBm, SNR: 10-14 dB) but is limited by low bandwidth (125 kHz) and high airtime (40-50 ms), restricting real-time applications. The results demonstrate the effectiveness of the deep learning model and a direction as to which communication module is the most suitable for the chosen use case. Further improvements are suggested to enhance the detection accuracy and data transmission efficiency.},
  keywords={Deep learning;Analytical models;Computational modeling;Scalability;LoRaWAN;Cameras;Real-time systems;Face detection;Wireless fidelity;Monitoring;Edge Computing;Real-Time Occupancy Monitoring;Deep Learning;YOLO;Face Detection;PIR Sensors;WiFi;LoRaWAN},
  doi={10.1109/WiSPNET64060.2025.11005196},
  ISSN={},
  month={March},}

@INPROCEEDINGS{9776411,
  author={Sahu, Harsh Sudhanshu and Himanish, Nellutla and Hiran, Kamal Kant and Leha, Janapala},
  booktitle={2021 International Conference on Computing, Communication and Green Engineering (CCGE)}, 
  title={Design of Automatic Lighting System based on Intensity of Sunlight using BH-1750}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={In this 21st century, one of the major issues faced by humans is, how to deal with the wastage of electricity. Mostly due to the carelessness of the management of the lamps or the streetlights are left ON in many places and one of the main sources of this wastage of electricity is in the sports complexes. In our paper, we try to solve this problem by using solar panels, and in addition to the proper utilization of electrical energy and water, we are using specific light and soil moisture sensors. To the maximum extend, our paper helps us to overcome the problems faced. The lights will be automatically turned on and turned off depending on the sunlight intensity, and also the water pumps will be controlled according to the moisture level present in the ground. The solar sensor which we are using is BH-1750 gives accurate values when compared with other sensors. In this research, we have collected the data on sunlight intensity which can be used further for developing a Machine Learning algorithm.},
  keywords={Machine learning algorithms;Soil moisture;Green products;Moisture;Lighting;Water pumps;Sensors;Solar;Light Solar;Automation;PIR;Microcontroller},
  doi={10.1109/CCGE50943.2021.9776411},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{10413002,
  author={Šabansks, Kristers and Teličko, Jevgēnijs and Jakovičs, Andris},
  booktitle={2023 IEEE 64th International Scientific Conference on Power and Electrical Engineering of Riga Technical University (RTUCON)}, 
  title={Secure Video loT Monitoring System Based on ESP32}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Monitoring systems have become an integral part of modern households and offices. Recent advancements in loT technologies have made highly sophisticated systems affordable. The use of Artificial Intelligence in monitoring systems, especially with cameras, has become more accessible and sought-after. Currently, there are systems available for performing people-counting tasks in buildings, but they often come with a high cost and high power usage. Images of people as well as the count of people in a room is sensitive data in many occasions. One of potential solutions could be usage of esp32 based cameras due to low cost, small power consumption and compact design. Important to note that esp32 has limited computing resources and is not able to process images locally with AI tools. At the same time, secure data transfer also requires resources to encrypt data due to that available resolution from camera could be reduced. In this paper, the authors investigate the limitations of ESP32based cameras for people counting through a series of tests involving different ESP32-based cameras and configurations. To demonstrate the proof-of-concept, a central computing module was employed in conjunction with MQTT-based TLS secured communication.The results indicate that this approach could achieve a maximum resolution of up to 1600x1200, with a potential image transmission frequency of up to 20 images per minute in some cases. Nevertheless, it is crucial to consider that such high frequency may lead to temperature-related issues},
  keywords={Performance evaluation;Image resolution;Costs;Cameras;Artificial intelligence;Monitoring;Thermal stability;Monitoring;Internet of Things;Cameras;Artificial intelligence;object recognition;Microcontrollers},
  doi={10.1109/RTUCON60080.2023.10413002},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{8842711,
  author={Godakandage, V. M. P. and Kothalawala, K. R. M. and Chathumali, E. J. A. and Madhubhashana, A. W.},
  booktitle={2019 International Research Conference on Smart Computing and Systems Engineering (SCSE)}, 
  title={Occupancy Monitoring System for Workplace Washrooms}, 
  year={2019},
  volume={},
  number={},
  pages={24-28},
  abstract={With regard to rapid technological advancements majorly influencing our daily lives, Internet of Things (IoT) has been a topic of broad and current interest in the recent years. The capabilities of IoT can assist in revolutionizing the way people live and work, thereby improving quality of life. With the impact of IoT only continuing to propagate in the future, it can be used as a means of easing our day-to-day struggles. Therefore, with the assistance of IoT along with a few hardware, the proposed system, addresses the displeasing reality of queues and several visits for the washrooms due to them coming forth occupied. Thus, the focus of the intended system is on delivering a pleasant washroom experience for employees in an office environment providing them with an at-desk indication on the occupancy of the washroom cubicles reducing queues and disappointments.},
  keywords={Sensors;Internet of Things;Sports;Monitoring;Microcontrollers;Cloud computing;Hardware;Internet of Things;Raspberry Pi;Message Queuing Telemetry Transport;Occupancy Detection;Publisher;Subscriber;Sensors},
  doi={10.23919/SCSE.2019.8842711},
  ISSN={2613-8662},
  month={March},}

@INPROCEEDINGS{11467518,
  author={Islam, Mahbubul and Sani, Md. Sahadat Hossain and Hossain, Md. Mamun and Hasan, Md. Rakibul and Ali, A B M Shawkat},
  booktitle={2025 International Conference on Sustainable Technology and Engineering (i-COSTE)}, 
  title={Energy-Efficient IoT and Cloud Framework for Accurate and Scalable Hotel Occupancy Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Efficient room occupancy monitoring is crucial for optimizing operations in the hospitality industry, yet traditional methods like manual reporting, camera-based systems, and passive infrared (PIR) sensors suffer from inaccuracies, privacy issues, and inability to detect stationary occupants. This paper introduces a cloud-integrated IoT solution that employs an ESP32 microcontroller interfaced with an HLK-LD2410B mmWave radar sensor to accurately detect both static and dynamic human presence. The system captures raw data via Universal Asynchronous Receiver/Transmitter (UART), processes it to determine occupancy status, and stores it locally using flash memory, while syncing with a Firebase Realtime Database for remote access. Energy efficiency is enhanced through deep sleep modes, with dynamic Wi-Fi provisioning via a captive portal and Over-the-Air (OTA) updates ensuring system adaptability. A Django-based web dashboard offers real-time occupancy updates, historical trends, and analytical visuals to support hotel management decisions. Tested over seven days across three hotel rooms with bi-minute sampling, the system achieved a 94.4% detection accuracy, validated against manual observations, outperforming PIR-based alternatives. This scalable, privacy-focused framework holds promise for applications in smart homes, offices, healthcare facilities, and intelligent building management.},
  keywords={Aerospace and electronic systems;Payloads;Synthetic aperture sonar;Microcontrollers;Microprocessors;Filtering;Filters;Communication systems;Internet of Things;Wireless fidelity;IoT & Cloud;mmWave Radar;Energy Efficient;Cloud Integration;Occupancy Detection;Hospitality Management},
  doi={10.1109/i-COSTE68047.2025.11467518},
  ISSN={},
  month={Dec},}


