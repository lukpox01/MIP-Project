  month={July},}

@INPROCEEDINGS{10796139,
  author={Golam Mowla, Arat Ibne and Hossain, Riad and Asaduzzaman},
  booktitle={2024 IEEE International Conference on Computing, Applications and Systems (COMPAS)}, 
  title={CSI-Based People Counting in WiFi Networks: Leveraging Occupancy Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The use of WiFi-based techniques to identify human activity has significantly increased in the past few years. The growing interest in smart buildings, retail analytics, healthcare facilities, and public spaces where real-time occupancy monitoring is essential. Detecting occupancy levels using Wi-fi is a great option because it is available almost everywhere. In wireless communications, the term "channel state information" (CSI) refers to the known channel properties of a communication link. CSI data can be used to implement object detection, human activity detection, patient activity monitoring, and so on. This work presents a framework for estimating the occupancy of an indoor environment, like a lab, inside a car, meeting room, using WiFi Channel State Information. The framework consists of four main steps: hardware configuration, CSI data collection, data preprocessing, and the number of people prediction. Qualcomm Atheros AR5BMD222 Wi-Fi LAN card TX-5B222 having a double antenna were used as both the transmitter and receiver. The raw CSI data have been collected from one person to five people, increasing gradually. During the preprocessing step, null subcarriers were eliminated, and amplitude and phase data were extracted and converted into decibels. Then the normalization was performed on the dataset. CSI data is Sequential Data. Therefore, there will be reliance on the datasets. CNN and LSTM architecture are used which combines the strengths of both networks to effectively extract features, model sequential information, and capture complex relationships in WiFi signals for accurate crowd counting in multi-human environments. We have trained classification models and achieved overall accuracy rates of 98.12%, 96.88%, 95.75%, 92.25%, and 87.88% for one to five persons respectively.},
  keywords={Wireless communication;Accuracy;Smart buildings;Transmitting antennas;Feature extraction;Data mining;Wireless fidelity;Local area networks;Monitoring;Channel state information;Wi-fi sensing;Wi-Fi LAN card;Qualcomm Atheros AR5BMD222 Wi-Fi LAN card TX-5B222;CSI data;Deep Neural Network;CNN;LSTM;Crowd counting},
  doi={10.1109/COMPAS60761.2024.10796139},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{9901666,
  author={Lil, Yuli and Lu, Xiao and Cui, Zhe and Wang, Haixia and Sheng, Chunyang},
  booktitle={2022 41st Chinese Control Conference (CCC)}, 
  title={An Novel Indoor Crowd Counting Approach Based on WiFi Signals}, 
  year={2022},
  volume={},
  number={},
  pages={7264-7268},
  abstract={Crowd counting approaches are widely used in personnel arrangements in crowded places and early warning of critical situations for their ability to accurately and quickly estimate the number of crowds. At present, researchers have proposed some methods for crowd counting using cameras and wearable devices. But these methods have some defects, for instance, cameras can only provide monitoring within the visible range, and wearable devices need to be consciously worn by the monitored. There are also some methods used radar-related technology to realize through-wall perception and recognition, but this kind of system has a complex design and high application cost and is mostly used in the military field. Considering the above problems, this paper proposes a crowd counting method based on WiFi signal, which uses the amplitude fluctuation of Channel State Information (CSI) to describe the change of indoor population and realizes crowd counting based on the Resnet network algorithm. At the same time, we verify the performance of the approach, and the experimental results show that the performance of this method is better than other algorithms.},
  keywords={Support vector machines;Radio frequency;Fluctuations;Wearable computers;Sociology;Cameras;Personnel;Crowd counting;CSI;Resnet;WiFi signal},
  doi={10.23919/CCC55666.2022.9901666},
  ISSN={1934-1768},
  month={July},}

@INPROCEEDINGS{11083958,
  author={Vardar, Alptekin and Zhang, Li and Lupp, Marc and Rehmer, Alexander and Yadav, Nandakishor and Kämpfe, Thomas},
  booktitle={2025 14th International Conference on Modern Circuits and Systems Technologies (MOCAST)}, 
  title={People Counting and Positioning Using Low-Resolution Infrared Images for Resource-Constrained Edge Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents a people counting and indoor positioning system using low-resolution infrared video from a thermopile sensor, optimized for deployment on resource-constrained edge devices. A lightweight YOLOv3-tiny network is trained on a custom thermal dataset and enhanced through quantization-aware training and structured pruning. Pre-processing techniques such as Otsu thresholding and morphological filtering are used to suppress noise and reduce image size by over 80 percent with minimal accuracy loss. The final model—quantized to 4 bits and pruned by 50 percent—achieves 57.71 precent mAP at 0.5 while significantly lowering memory and compute demands. Results validate the system's suitability for privacy-preserving, low-power applications in smart environments.},
  keywords={Training;Performance evaluation;Accuracy;Thresholding (Imaging);Systematics;Quantization (signal);Image edge detection;Computational modeling;Pipelines;Real-time systems;Infrared imaging;people counting;indoor positioning;edge inference;YOLOv3-tiny;quantization;pruning},
  doi={10.1109/MOCAST65744.2025.11083958},
  ISSN={2993-4443},
  month={June},}

@INPROCEEDINGS{10571038,
  author={Ling, Sida and Zhao, Jingbo and Lu, Zhaoming and Wen, Xiangming and Xiao, Zhe},
  booktitle={2024 IEEE Wireless Communications and Networking Conference (WCNC)}, 
  title={EasyCount: Crowd Counting Based on Easy Deployment Using Commodity Wi-Fi}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent years have witnessed the great potential of Wi-Fi-based crowd counting technique due to its popularity and non-invasive. However, the existing schemes with high accuracy require labeled data with different numbers of people for a priori learning, which poses an obstacle to the usability of crowd counting systems. Hence in this paper, we propose EasyCount, an easy learning-free multi-environment crowd counting system that only needs one person's prior data for simple calibration. First, we model the reflection signal of an individual as a Gaussian stochastic process. Then, we propose the ratio of dynamic power to noise power (RDN), which establishes a mapping between the autocorrelation function (ACF) of Channel State Information (CSI) amplitude and the number of people. The proposed RDN metric is proportional to the number of people, thus eliminating the dependence on labeled data with different numbers of people. Finally, we design a calibration scheme to obtain the base RDN, which enables our system to overcome the impact of different environments. Extensive experiments show that EasyCount can be easily deployed in different environments, achieving an average accuracy of 93.9 % for 0–6 people counting tasks in multiple environments with only one pair of transceivers, which is comparable to the existing state-of-the-art works.},
  keywords={Accuracy;Noise;Stochastic processes;Transceivers;Reflection;Calibration;Sensors;Channel state information;Wi-Fi-based crowd counting;Easy deployment;Multi-environment detection},
  doi={10.1109/WCNC57260.2024.10571038},
  ISSN={1558-2612},
  month={April},}

@ARTICLE{9765582,
  author={Khan, Danista and Ho, Ivan Wang-Hei},
  journal={IEEE Internet of Things Journal}, 
  title={CrossCount: Efficient Device-Free Crowd Counting by Leveraging Transfer Learning}, 
  year={2023},
  volume={10},
  number={5},
  pages={4049-4058},
  abstract={Recently, wireless sensing is gaining immense attention in the Internet of Things (IoT) for crowd counting and occupancy detection. As wireless signals propagate, they tend to scatter and reflect in various directions depending on the number of people in the indoor environment. The combined effect of these variations on wireless signals is characterized by the channel state information (CSI), which can be further exploited to identify the presence of people. State-of-the-art CSI-based supervised crowd counting systems are vulnerable to temporal and environmental dynamics in practical scenarios as their performance degrades with fluctuations in the indoor environments due to multipath fading. Inspired by the breakthroughs of transfer learning and advancement in edge computing, we have leveraged in this work the concept of transfer learning to minimize this problem via exploiting the trained model from the source environment for other indoor environments to perform device-free crowd counting (CrossCount) at the target rooms. Our results show that this technique can combat the dynamics of the environment and achieves 4.7% better accuracy with 40% reduction in training time as compared to conventional convolutional neural networks. In essence, our results imply the future possibility of harnessing crowdsourced CSI data collected at different indoor environments to boost the accuracy and efficiency of local crowd counting systems.},
  keywords={Wireless communication;Internet of Things;Transfer learning;Wireless sensor networks;Indoor environment;Support vector machines;Convolutional neural networks;Channel state information (CSI);cloud computing;convolutional neural networks (CNNs);crowd counting systems;Internet of Things (IoT);transfer learning},
  doi={10.1109/JIOT.2022.3171449},
