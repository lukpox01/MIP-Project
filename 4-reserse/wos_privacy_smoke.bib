Author = {Kim, Youngwook and Alnujaim, Ibrahim and You, Sungjin and Jeong, Byung
   Jang},
Book-Group-Author = {IEEE},
Title = {HUMAN DETECTION WITH RANGE-DOPPLER SIGNATURES USING 3D CONVOLUTIONAL
   NEURAL NETWORKS},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
