@inproceedings{ WOS:001017754700081,
Author = {Uzunidis, Dimitris and Kasnesis, Panagiotis and Margaritis, Evangelos
   and Feidakis, Michalis and Patrikakis, Charalampos Z. and Mitilineos,
   Stelios A.},
Book-Group-Author = {IEEE},
Title = {Real-Time Human Detection Behind Obstacles Based on a low-cost UWB Radar
   Sensor},
Booktitle = {2022 IEEE 8TH WORLD FORUM ON INTERNET OF THINGS, WF-IOT},
Year = {2022},
Note = {8th IEEE World Forum on the Internet of Things (WF-IoT) - Sustainability
   and the Internet of Things, Yokohama, JAPAN, OCT 26-NOV 11, 2022},
Organization = {IEEE; Multi Soc IEEE IoT Initiat; IEEE Commun Soc; IEEE Council Elect
   Design Automat; IEEE Circuits \& Syst Soc; IEEE Reliabil Soc; IEEE
   Signal Proc Soc; CSS; EDS; IES; IEEE Microwave Theory \& Technol Soc;
   IEEE Power \& Energy Soc; IEEE Power Elect Soc; IEEE Solid State
   Circuits Soc; IEEE Japan Council; KIOXIA; NTT; RakutenMobile; Toshiba
   Digital Solut Corp; EAGLYS},
Abstract = {Ultra-Wideband (UWB) radars are a cost-effective and accurate solution
   for recognizing human movements for various purposes that span from
   human activity recognition to vital signs monitoring, (i.e. breathing
   and heart beating). In this work, we introduce a convenient to use,
   lightweight and portable solution that exploits an UWB radar sensor as
   well as an analysis tool tailored for search and rescue operations. In
   particular, the proposed method works in real-time with main aim to find
   trapped victims via recognizing their torso movement during breathing.
   To validate the efficiency of the candidate solution we have collected
   about three hours of data for three different case studies: indoor
   environment with and without clear Line of Sight (LOS) as well as
   outdoor environment with clear LOS. The results demonstrate that the
   proposed tool is efficient in quantifying in real-time a) if a victim is
   present within the effective radar range and b) its distance from the
   radar sensor, even in cases with zero LOS, e.g. behind large obstacles
   or walls.},
