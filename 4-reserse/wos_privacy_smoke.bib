@article{ WOS:000557098300001,
Author = {Park, Piljae and Kim, Sungdo and Koo, Bontae},
Title = {An impulse radio (IR) radar SoC for through-the-wall human-detection
   applications},
Journal = {ETRI JOURNAL},
Year = {2020},
Volume = {42},
Number = {4},
Pages = {480-490},
Month = {AUG},
Abstract = {More than 42 000 fires occur nationwide and cause over 2500 casualties
   every year. There is a lack of specialized equipment, and rescue
   operations are conducted with a minimal number of apparatuses.
   Through-the-wall radars (TTWRs) can improve the rescue efficiency,
   particularly under limited visibility due to smoke, walls, and collapsed
   debris. To overcome detection challenges and maintain a small-form
   factor, a TTWR system-on-chip (SoC) and its architecture have been
   proposed. Additive reception based on coherent clocks and
   reconfigurability can fulfill the TTWR demands. A clock-based
   single-chip infrared radar transceiver with embedded control logic is
   implemented using a 130-nm complementary metal oxide semiconductor.
   Clock signals drive the radar operation. Signal-to-noise ratio
   enhancements are achieved using the repetitive coherent clock schemes.
   The hand-held prototype radar that uses the TTWR SoC operates in real
   time, allowing seamless data capture, processing, and display of the
   target information. The prototype is tested under various
   pseudo-disaster conditions. The test standards and methods, developed
   along with the system, are also presented.},
