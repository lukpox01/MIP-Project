@inproceedings{ WOS:001832020800020,
Author = {Sikic, Haris and Grubmueller, Stephanie and Solmaz, Selim and Cao, Qiuyi
   and Dikic, Berin},
Book-Group-Author = {IEEE},
Title = {Multi-Modal Survivor Detection in Search and Rescue Missions: LiDAR and
   Thermal Camera Fusion},
Booktitle = {2025 IEEE INTERNATIONAL AUTOMATED VEHICLE VALIDATION CONFERENCE, IAVVC},
Year = {2025},
Note = {2025 International Automated Vehicle Validation Conference-IAVVC,
   Baden-Baden, GERMANY, SEP 30-OCT 02, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc; IEEE
   Instrumentation \& Measurement Society},
Abstract = {Search and Rescue (SAR) missions in constrained and closed environments
   require efficient and reliable methods for detecting survivors. The
   primary objective is to provide detections and pose estimates of humans
   within subterranean and complex environments utilizing multiple sensor
   modalities as well as a combination of several machine learning
   techniques. This paper proposes a survivor detection pipeline that fuses
   Light Detection and Ranging (LiDAR) data with thermal images, enabling
   robust human detection even under low-visibility conditions. The
   foundation is a fusion of semantic labels obtained by thermal imaging
   and the LiDAR point cloud, which is projected to the image space. Given
   the one-to-one correspondence between the original and the projected
   point cloud, the system effectively maps the labels derived from the
   segmentation of the thermal image to the LiDAR point cloud. Moreover,
   due to the inherent challenges in calibrating the camera's intrinsic
   parameters, estimating the relative poses of the two sensor modalities
   accurately, and accounting for the sparse and noisy nature of LiDAR
   point clouds, the resulting point cloud segmentation may be suboptimal.
   A set of heuristic post-processing steps of the labeled point cloud,
   together with a semi-supervised label propagation approach are performed
   to counteract the effects introduced by inaccurate sensor calibration
   and measurement noise. The proposed survivor detection pipeline
   increases the robustness of the projection-based segmentation and its
   performance is evaluated based on test results.},
