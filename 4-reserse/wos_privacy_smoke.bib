   Martirosyan, Artur; Kostanyan, Radik; Martirosyan, Vahan; Muzhikyan, Pavel, NAS Armenia, Inst Phys Res, Ashtarak, Armenia.
   Martirosyan, Vahan, Univ Paris Saclay, Cent Supelec, Gif Sur Yvette, France.
   Martirosyan, Vahan, Yerevan State Univ, Fac Math \& Mech, Yerevan, Armenia.},
DOI = {10.1117/1.OE.63.4.044101},
