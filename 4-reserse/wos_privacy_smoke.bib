@article{ WOS:001894330700026,
Author = {Guo, Yufan and Li, Junhuai and Fei, Rong and Wang, Huaijun and Wang, Kan
   and Miao, Yalin and Shen, Xuyao and Yang, Zhuangbang},
Title = {Statistics-Physics Dual-Feature Multimodal Fusion Network for
   Device-Free Person Re-Identification via Wi-Fi CSI Respiratory
   Biometrics},
Journal = {IEEE SENSORS JOURNAL},
Year = {2026},
Volume = {26},
Number = {19},
Pages = {28998-29016},
Month = {OCT 1},
Abstract = {With the widespread deployment of Wi-Fi devices, nonintrusive and
   privacy-preserving person re-identification has become feasible.
   However, channel state information (CSI)-based approaches mainly rely on
   behavioral features, which require prolonged activity to extract
   biometric cues and remain vulnerable to behavior-mimicking attacks,
   thereby limiting identification efficiency. Conversely, we propose a
   statistics-physics dual-feature multimodal fusion network (SPDFMF-Net),
   which enables rapid re-identification of both known and unknown
   individuals under stationary conditions by CSI respiratory biometric
   signatures. To enhance signal stability and reliability, a multilevel
   subcarrier optimization strategy is proposed, combining dynamic time
   warping (DTW), singular value decomposition (SVD) contribution, and
   information entropy. Specifically, statistical features characterize
   respiratory amplitude, depth, and rhythm variations, while physical
   features capture chest micro-Doppler motion patterns and respiration
   rate dynamics. Accordingly, a dual-branch architecture is designed to
   exploit the multidimensional information in CSI respiration signals. The
   statistical branch employs convolution and a self-attention mechanism to
   extract temporal amplitude-phase statistical features, whereas the
   physical branch utilizes a vision transformer (ViT) encoder to model
   chest micro-Doppler motion patterns. Cross-attention is then introduced
   to adaptively fuse multimodal features, followed by a bidirectional long
   short-term memory (BiLSTM) to capture temporal dependencies, enabling
   comprehensive respiratory representation. Extensive experiments on
   small-scale datasets demonstrate that the proposed method achieves
   person re-identification accuracies of 99.07\% in indoor and 95.11\% in
   corridor scenarios with ten participants. The results also indicate its
   potential for recognizing unseen users under open-set conditions and
   show competitive performance compared with state-of-the-art CSI-based
   baselines. With an average inference time of 6.97 ms, the proposed
   method demonstrates the feasibility of real-time respiration-based
   identity recognition and provides preliminary evidence for its potential
   application in IoT scenarios.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
Address = {445 HOES LANE, PISCATAWAY, NJ 08855-4141 USA},
