@article{ WOS:001582357500001,
Author = {Hassan, Qusay},
Title = {Hybrid PV/T-biomass heating and power system for optimized energy
   management in residential units},
Journal = {ENERGY CONVERSION AND MANAGEMENT-X},
Year = {2025},
Volume = {27},
Month = {JUL},
Abstract = {Iraq's residential sector faces escalating energy demands, driven by
   urban growth and climate extremes, with existing infrastructure failing
   to deliver reliable, cost-effective heating and cooling. Addressing
   this, a hybrid energy system integrating roof-mounted
   photovoltaic-thermal (PV/T) collectors with biomass-fired boilers was
   assessed for a 400-unit housing complex in Makki City, Baqubah.
   Simulations using TRNSYS, supported by real weather and occupancy data,
   evaluated energy flows, costs, and emissions. The PV/T array delivered
   4298 MWh of useful heat and 1545 MWh of electricity annually, meeting 58
   \% of thermal demand and reducing diesel dependency. Boiler operation,
   fueled by biogas and pellets, supplied the remaining 3127 MWh with a 76
   \% thermal efficiency. Thermal energy storage achieved 90 \% roundtrip
   efficiency, ensuring continuous service during solar shortfalls.
   Economic analysis under a 7 \% discount rate yielded an NPV of \$2.3 M
   and a levelized heat cost of \$0.041 kWh- 1, with a 6.8-year payback.
   Monte Carlo simulations confirmed robustness across varying fuel prices,
   and the system demonstrated CO2-eq avoidance near 765 t y- 1. Upscaling
   the collector field by 30 \% slightly improved NPV but plateaued LCOH,
   highlighting design-optimal trade-offs.},
