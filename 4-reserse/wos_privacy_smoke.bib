Title = {UWB Radar-Based Human Vital Signal and Range Detection Beyond Obstacles},
Booktitle = {10TH INTERNATIONAL CONFERENCE ON ELECTRONICS, COMPUTING AND
   COMMUNICATION TECHNOLOGIES, CONECCT 2024},
Series = {IEEE International Conference on Electronics Computing and Communication
   Technologies},
Year = {2024},
Note = {10th IEEE International Conference on Electronics, Computing and
   Communication Technologies (IEEE CONECCT), Indian Inst Sci, Bangalore,
   INDIA, JUL 12-14, 2024},
Organization = {IEEE; IEEE Bangalore Sect},
Abstract = {The need for safety and detection during an emergency situation like an
   earthquake requires advanced detection techniques for rescue operations
   in a complex environment. When it comes to search and rescue missions in
   disaster relief areas, UWB radar plays a crucial role. Human detection
   through radar relies primarily on human vital signs, especially
   breathing. This difference is crucial for distinguishing human targets
   from stationary objects. Methods to reduce background clutter have
   already been established based on various clutter reduction algorithms
   like simple moving average filters, exponential weight subtraction
   methods, and Singular Value Decomposition (SVD). Our proposed clutter
   reduction method consists of a combination of various clutter reduction
   techniques, yielding better results in locating humans. Also, the vital
   signs such as respiration and heartbeat signals are extracted and
   reconstructed using Empirical Mode Decomposition (EMD) methods},
