Title = {Multispectral Human Presence Detection using Adapted YOLO Network},
Booktitle = {2025 33RD EUROPEAN SIGNAL PROCESSING CONFERENCE, EUSIPCO},
Series = {European Signal Processing Conference},
Year = {2025},
Pages = {686-690},
Note = {33rd European Signal Processing Conference-EUSIPCO-Annual, Palermo,
   ITALY, SEP 08-12, 2025},
Abstract = {Search and Rescue (SAR) operations increasingly use drones with thermal
   cameras to locate individuals in distress. However, human operators are
   required for navigation and detection. Given modern drones'
   self-navigation capabilities, automating human detection can enhance
   efficiency. While previous studies leveraged multi-spectral imagery,
   specifically RGB and thermal, for object detection, they often
   introduced computational overhead. Building on recent YOLO advancements,
   we adapt YOLOv8 to support multi-spectral input using early feature
   fusion, modified convolution kernels, and improved up-scaling blocks for
   better small-object detection. Experiments on RGB-thermal multispectral
   data show a 22\% mAP50-95 improvement over the baseline and a 10\% gain
   over prior work, while maintaining real-time performance.},
