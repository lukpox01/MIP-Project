@article{ WOS:001873688400001,
Author = {Wu, Ruipeng and Sun, Zhiyuan and Sun, Zeyue and Tu, Hao and Wang, Tao},
Title = {WDMS-Net: A Wavelet Downsampling and Multi-Scale Convolution Network for
   Step-Wise mmWave Gait Recognition},
Journal = {JOURNAL OF INFRARED MILLIMETER AND TERAHERTZ WAVES},
Year = {2026},
Volume = {47},
Number = {9},
Month = {SEP 12},
Abstract = {Gait recognition, as an effective biometric identification technology,
   has been widely studied recently. Conventional gait recognition methods
   are generally vision-based. However, video monitoring methods are
   severely limited by factors such as clothing obscuring the view,
   insufficient lighting, and the inability to use cameras to collect gait
   data for privacy reasons. Gait recognition based on millimeter-wave
   (mmWave) radar offers advantages such as non-contact operation, privacy
   protection, resistance to environmental interference, and high detection
   accuracy, making it an effective gait recognition solution. However,
   existing millimeter-wave radar-based gait recognition methods usually
   rely on multiple consecutive gait segments to achieve reliable
   recognition. Therefore, a worthwhile research question is whether
   reliable gait recognition can be achieved using only single-step gait
   segments. To this end, this paper proposes a wavelet downsampling
   multi-scale convolutional network (WDMS-Net) for single-step gait
   segment (SGS) recognition. Since SGSs lack the temporal redundancy
   information contained in multiple consecutive gait segments, it is
   necessary to make fuller use of the limited discriminative motion
   information contained therein. Based on this, we introduce a wavelet
   downsampling module to preserve motion features as much as possible, and
   introduce a multi-scale convolutional module to extract motion patterns
   under different receptive fields, thereby enhancing feature
   representation. The WDMS-Net achieves an average recognition accuracy of
   98.00\% on a dataset of ten subjects. We also compare it with other
   millimeter-wave radar-based gait recognition networks, demonstrating the
   effectiveness of our proposed model. This SGS-based gait recognition
   reduces inference latency while maintaining accuracy and holds the
   potential for lightweight deployment.},
