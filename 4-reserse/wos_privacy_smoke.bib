   Malik, Zainab; Taysi, Ziya Cihan; Karsligil, M. Elif, Yildiz Tech Univ, Dept Comp Engn, TR-34220 Istanbul, Turkiye.},
DOI = {10.1109/LES.2025.3619147},
ISSN = {1943-0663},
EISSN = {1943-0671},
Keywords = {Feature extraction; Accuracy; Radar; Radio frequency; Radar detection;
   Machine learning; Long short term memory; Sensors; Ultra wideband radar;
   Frequency-domain analysis; Frequency-modulated continuous wave (FMCW)
