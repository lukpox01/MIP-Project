Title = {STPOINTGCN: SPATIAL TEMPORAL GRAPH CONVOLUTIONAL NETWORK FOR MULTIPLE
   PEOPLE RECOGNITION USING MILLIMETER-WAVE RADAR},
Booktitle = {2022 IEEE INTERNATIONAL CONFERENCE ON ACOUSTICS, SPEECH AND SIGNAL
   PROCESSING (ICASSP)},
