Title = {AI-Enhanced Intelligent Interfaces for Secure Biometric Authentication
   in IoT Ecosystems: Recent Advances and Future Directions},
Booktitle = {2026 INTERNATIONAL CONFERENCE ON SEMANTIC COMPUTING, ICSC},
Series = {IEEE International Conference on Semantic Computing},
