@article{ WOS:001836013400002,
Author = {Zeng, Jielin and Han, Jiayi and Yang, Yutong and Zhang, Yuxin and Wang,
   Yapeng and Li, Shaoxiang and Cheng, Jiaji},
Title = {Titanium-based metal-organic frameworks incorporating phase change
   materials for thermal management and fire safety enhancement in building
   coatings},
Journal = {APPLIED THERMAL ENGINEERING},
Year = {2026},
Volume = {303},
Number = {5},
Month = {AUG},
Abstract = {In order to save building energy consumption and improve the comfort of
   building occupancy, functional building coatings are widely used.
   Introducing phase change materials into epoxy resin coatings can endow
   them with temperature-control properties. To enhance the fire safety of
   buildings, this study presents a novel strategy for fabricating an
   epoxy-based composite coating incorporated with capric acid supported on
   metal-organic framework MIL-125(Ti). The disc-like MIL-125(Ti) with
   well-defined porous architecture serves as an ideal host matrix for
   capric acid (CA) loading via vacuum impregnation, yielding
   MIL-125(Ti)@CA with a latent heat of 67.5 J/g and appropriate phase
   transition temperature near 30 degrees C. Comprehensive characterization
   confirms the successful confinement of CA within MOF pores without
   compromising the crystalline integrity of the host framework. When
   incorporated into epoxy resin, the resulting EP/MIL-125(Ti)@CA coating
   demonstrates superior thermal regulation performance under simulated
   solar irradiation, reducing exterior wall peak temperature by 18.6\% and
   indoor peak temperature by 8.4\% compared to neat epoxy. Cone
   calorimetry tests demonstrate that MIL-125(Ti) significantly enhances
   the fire safety of the material by catalyzing char formation, as
   evidenced by a 35.1\% reduction in peak heat release rate (pHRR) and a
   17.6\% decrease in total heat release (THR). The MIL-125(Ti) alone
   exhibits superior fire resistance, while the addition of CA partially
   compromises this advantage due to the flammable nature of organic PCMs.
   Nevertheless, the final composite achieves a balanced trade-off between
   thermal storage and fire safety, establishing a promising approach for
   designing smart building coatings with integrated thermal management and
   fire protection functionalities.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
