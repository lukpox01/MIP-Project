@inproceedings{ WOS:001776713800080,
Author = {Jain, Vidhan and Tanish and Dhara, Sobhan Kanti},
Book-Group-Author = {IEEE},
Title = {TSRNet: A Lightweight Thermal Saliency Refinement Network for Tiny Human
   Detection},
Booktitle = {2026 NATIONAL CONFERENCE ON COMMUNICATIONS, NCC},
Series = {National Conference on Communications NCC},
Year = {2026},
Pages = {472-477},
Note = {32nd National Conference on Communications-NCC, Hyderabad, INDIA, FEB
   26-MAR 01, 2026},
Organization = {IEEE Hyderabad Section; Qualcomm; Silicon Laboratories, Inc.; TCS
   Research; Texas Instruments; MathWorks; Advanced Micro Devices; Emona
   Instruments Pty Ltd},
Abstract = {Detecting humans in aerial thermal imagery is pivotal for search and
   rescue operations, particularly in environments with limited visibility.
   However, performance often suffers from atmospheric interference and
   complex background clutter that obscures tiny human targets. To address
   these degradations, we propose the lightweight Thermal Saliency
   Refinement Network (TSRNet) to retain weak thermal signatures. Our
   architecture introduces two novel modules, DFR and ACP. The
   Dual-Frequency Refinement (DFR) module leverages frequency domain
   analysis to suppress background noise while enhancing the saliency of
   target details. Complementing this, the Axial Context Pooling (ACP)
   module identifies salient regions by independently pooling features
   across spatial and channel dimensions to capture global context.
   Experiments on the RGBT Tinyperson benchmark demonstrate the superiority
   of our method, achieving 0.454 mAP@0.5 with a computational cost of only
   36.5 GFLOPs.},
