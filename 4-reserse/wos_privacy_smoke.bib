Editor = {Kaparaju, P and Howlett, RJ and Littlewood, J and Ekanyake, C and Vlacic, L},
Title = {Systemised Offsite Manufactured Timber Dwelling Typologies from UK
   Forestry Supply Chains, Enabling a Transition to Nearly Zero Carbon
