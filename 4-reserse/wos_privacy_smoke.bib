@article{ WOS:001750550600001,
Author = {Ahmed, Owais and Guye, Justin and Tanveer, M. Hassan and Khalid, Adeel},
Title = {Comparative Evaluation of Segmentation-Based and Pose-Assisted Head
   Temperature Estimation from UAS Thermal Imagery Under Controlled
   Conditions},
Journal = {DRONES},
Year = {2026},
Volume = {10},
Number = {4},
Month = {APR 17},
Abstract = {Highlights What are the main findings? YOLOv11 architecture outperforms
   YOLOv10 for thermal human detection from UAS, doing human detection
   without requiring any model retraining or fine-tuning. The pose-assisted
   head localization method produces more physiologically accurate
   temperature estimates compared to segmentation-based approaches, with
   better precision in multi-human aerial scenes. What is the implication
   of the main finding? The framework enables rapid, non-contact assessment
   of human presence and condition during search and rescue operations,
   allowing first responders to prioritize individuals based on thermal
   anomalies (fever or hypothermia) detected from aerial platforms. The use
   of pre-trained models without domain-specific fine-tuning allows for
   immediate deployment in time-critical emergency scenarios, reducing the
   barrier for integrating AI-based thermal detection into existing UAS
   rescue workflows.Highlights What are the main findings? YOLOv11
   architecture outperforms YOLOv10 for thermal human detection from UAS,
   doing human detection without requiring any model retraining or
   fine-tuning. The pose-assisted head localization method produces more
   physiologically accurate temperature estimates compared to
   segmentation-based approaches, with better precision in multi-human
   aerial scenes. What is the implication of the main finding? The
   framework enables rapid, non-contact assessment of human presence and
   condition during search and rescue operations, allowing first responders
   to prioritize individuals based on thermal anomalies (fever or
   hypothermia) detected from aerial platforms. The use of pre-trained
   models without domain-specific fine-tuning allows for immediate
   deployment in time-critical emergency scenarios, reducing the barrier
   for integrating AI-based thermal detection into existing UAS rescue
   workflows.Abstract This paper presents a vision-based framework for
   detecting humans and estimating head surface temperature from aerial
   thermal imagery acquired by Unmanned Aerial Systems (UAS). A comparative
   evaluation of recent object detection architectures was conducted to
   identify the most stable and reliable model for thermal human detection
   under varying flight altitudes. The selected framework integrates two
   head localization strategies, namely, segmentation-based mask slicing
   and pose-assisted keypoint localization, to extract head regions and
   compute per-pixel temperature values from radiometric metadata. The
   results show that cross-domain inference using pre-trained YOLOv11
   models achieves reliable human detection across controlled outdoor
   environments. Between the two pipelines, the pose-assisted method
   produced temperature estimates closer to the expected human
   physiological range (36-38 degrees C), whereas the segmentation-based
   approach exhibited higher values attributable to mask boundary
   contamination and solar surface heating. In the absence of ground-truth
   validation from medical-grade sensors, these findings are characterized
   as relative comparisons rather than absolute accuracy claims. This study
   establishes a methodological foundation for future UAS-based thermal
   assessment systems and identifies critical calibration and validation
   requirements for field deployment.},
