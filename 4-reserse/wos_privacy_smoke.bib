@article{ WOS:001620349300003,
Author = {Zhang, Jie and Liang, Haoyu and Li, Yunze and He, Lang and Wang,
   Zhongmin and Chen, Jing},
Title = {Enhancing CSI-based gait recognition through multi-view feature
   extraction and few-sample adaptability},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {300},
Month = {MAR 5},
Abstract = {Driven by breakthroughs in wireless sensing technology, gait recognition
   based on WiFi Channel State Information (CSI) has emerged as a promising
   paradigm due to its non-contact and privacy-friendly characteristics.
   However, when facing an increasing number of users or insufficient
   training samples, the existing CSI-based gait recognition methods are
   often limited to extracting local features in the time-frequency or
   spatiotemporal domain, failing to make full use of the rich information
   embedded in CSI measurements. The extracted features lack sufficient
   discriminability, restricting the model's ability to effectively learn
   and represent features, which consequently leads to a significant
   decline in recognition performance. To address these key challenges,
   this paper proposes a novel multi-view feature extraction framework.
   Specifically, CSI measurements are converted into GADF (Gramian Angular
   Difference Field) to better capture the spatiotemporal information
   within CSI. Subcarrier diversity features are introduced by computing
   the differences between subcarriers and generating subcarrier diversity
   heatmaps to provide complementary information. Meanwhile, effective
   feature information is extracted directly from the raw CSI measurements.
   The three types of features extracted from different views are fused
   using an adaptive weighting mechanism, which automatically adjusts the
   contribution of each feature according to the task requirements, thereby
   improving the performance of gait recognition. Experimental results show
   that, in a gait recognition task involving 20 users, the proposed method
   improves the accuracy by more than 8\% compared to existing methods.
   Even when the sample size is reduced to 60\%, the accuracy drops by only
   2.45\%.},
