@article{ WOS:001862742300001,
Author = {Luan, Tian and Yang, Fan and Zhou, Shixiong and Tao, Lei and Pan, Weijun
   and Wei, Huanxia and Melgani, Farid},
Title = {REM-YOLO: visible-infrared feature fusion network with adaptive
   attention for robust human detection in post-disaster UAV surveillance},
Journal = {INTERNATIONAL JOURNAL OF REMOTE SENSING},
Year = {2026},
Month = {2026 AUG 31},
Abstract = {Post-disaster person detection from aerial platforms faces significant
   challenges, including adverse illumination, extreme imbalance between
   foreground and background, and small target sizes. We proposed Robust
   Emergency Multispectral YOLO (REM-YOLO), a YOLO11-based framework that
   integrates visible and thermal infrared imagery for all-weather
   emergency response. The architecture introduces four key innovations:
   early-stage multispectral fusion to capture complementary spectral
   information, Adaptive Cross-Spatial Pyramid Attention (ACPA) modules
   that leverage multi-scale attention mechanisms for improved feature
   extraction, the PP-HGNetv2 backbone for high-quality representation with
   reduced computational cost, and Adaptive Threshold Focal Loss (ATFLoss)
   to effectively address class imbalance through dynamic reweighting. On
   the Low-Light Vision Infrared-Paired (LLVIP) dataset, REM-YOLO achieves
   97.2\% mAP@50 and 66.8\% mAP@50:95, outperforming the baseline YOLO11 by
   9.1\% and 18.3\%, while reducing computational complexity by 20\% and
   parameters by 24\%. These advances make REM-YOLO a robust, lightweight
   solution for unmanned aerial vehicle (UAV)-based search-and-rescue
   operations, offering vital support for emergency post-disaster response
   systems.},
