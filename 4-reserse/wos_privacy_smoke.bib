@article{ WOS:001777672500028,
Author = {Monteiro, Marcos Eduardo Pivaro and Acqua, Thiago Luciano Dall and
   Santos, Douglas de Oliveira and Frutos, Estefani and de Souza, Cleber
   Brantl and Silva, Alisson Siqueira},
Title = {Classroom-HAR: A Study on Generalization in Wi-Fi CSI Sensing Using Deep
   Learning},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {74736-74750},
Abstract = {Human Activity Recognition (HAR) using Wi-Fi Channel State Information
   (CSI) is a privacy-preserving alternative to camera-based systems.
   However, its deployment in complex, multipath-rich environments like
   classrooms remains challenging due to signal variability and a lack of
   robust generalization. In this work, we present a comprehensive study on
   the generalization capabilities of Deep Learning models for CSI-based
   sensing in educational settings. To lower the barrier to entry, we
   release a complete open-source platform, including low-cost ESP32
   acquisition software, training scripts, and a novel dataset comprising
   27 spatial-activity scenarios (9 discrete locations \$ imes 3\$ activity
   states) across 5 subjects. Rather than proposing a purely architectural
   advancement, our primary contribution is a rigorous investigation across
   three increasing levels of difficulty: (A) a randomized baseline sanity
   check, (B) strict temporal drift, and (C) leave-one-subject-out (LOSO)
   cross-user validation. Our results demonstrate that while standard
   models achieve near-perfect accuracy under ideal conditions, they
   degrade significantly as temporal and biometric constraints tighten.
   Crucially, our results indicate that a hybrid architecture combining a
   2D Convolutional Neural Network (CNN) with an Attention-enhanced
   Bidirectional LSTM (BiLSTM) achieves the highest overall accuracy.
   However, our investigation equally positions the standalone BiLSTM as a
   strong, computationally simpler competitor, offering commendable
   resilience against the noise and domain shifts inherent in commercial
   IoT deployments.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
