Pages = {312-319},
Note = {20th International Conference on Semantic Computing-ICSC-Annual, Laguna
   Hills, CA, FEB 02-04, 2026},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {The ubiquitous integration of devices from the Internet of Things (IoT)
   into daily life demands authentication mechanisms that are secure,
   continuous, and unobtrusive. Traditional static credentials are
   increasingly inadequate for dynamic IoT environments. This work explores
   the paradigm shift towards AI-enhanced intelligent interfaces that
   leverage biometric authentication as an intrinsic component of user
   interaction. We analyse the convergence of three critical dimensions:
   (1) AI-driven intelligent interaction modalities, ranging from
   contactless RF sensing to wearable neuromuscular interpretation; (2)
   Advanced biometric authentication paradigms, focusing on behavioural
   traits and multimodal fusion strategies; and (3) Security and privacy
   constraints specific to IoT ecosystems, including edge intelligence and
   cancellable biometrics. By synthesising a selection of recent
   literature, this paper highlights how Artificial Intelligence is
   transforming interfaces from passive input points into active,
   security-aware agents capable of robust user identification in
   resource-constrained environments.},
