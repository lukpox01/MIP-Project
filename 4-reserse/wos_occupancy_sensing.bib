@article{ WOS:001304646700001,
Author = {Gharamohammadi, Ali and Dabak, Anand G. and Yang, Zigang and Khajepour,
   Amir and Shaker, George},
Title = {Volume-Based Occupancy Detection for In-Cabin Applications by Millimeter
   Wave Radar},
Journal = {REMOTE SENSING},
Year = {2024},
Volume = {16},
Number = {16},
Month = {AUG},
Abstract = {In-cabin occupancy detection has become increasingly important due to
   incidents involving children left in vehicles under extreme temperature
   conditions. Frequency modulated continuous wave (FMCW) radars are widely
   used for non-contact monitoring and sensing applications, particularly
   for occupancy detection. However, the confined and metallic environment
   inside vehicle cabins presents significant challenges due to multipath
   reflections. This paper introduces a novel approach that detects the
   occupied space in each seat to determine occupancy, using the variance
   of detected points as an indicator of volume occupancy. In an
   experimental study involving 70 different scenarios with single and
   multiple subjects, we classify occupants in each seat into one of three
   categories: adult, baby, or empty. The proposed method achieves an
   overall accuracy of 96.7\% using an Adaboost classifier and a
   miss-detection rate of 1.8\% for detecting babies. This approach
   demonstrates superior robustness to multipath interference compared to
   traditional energy-based methods, offering a significant advancement in
   in-cabin occupancy detection technology.},
