@inproceedings{ WOS:001716978000119,
Author = {Louis Tutor, Mark and John Tiope, Paul and Cahlil Eiz Togonon, Adrian
   and de Guzman, Jaybie A.},
Book-Group-Author = {IEEE},
Title = {Bayesian Sensor Fusion for Smart Occupancy Detection},
Booktitle = {2025 IEEE 11TH WORLD FORUM ON INTERNET OF THINGS, WF-IOT},
Series = {IEEE World Forum on Internet of Things},
Year = {2025},
Note = {11th World Forum on Internet of Things-WF-IOT-Annual, Chengdu, PEOPLES R
   CHINA, OCT 27-30, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {Occupancy detection plays an important role in optimizing energy use,
   comfort, and security. While single-sensor solutions exist, they face
   issues like high cost, privacy concerns, and sensitivity. Sensor fusion
   overcomes these, but existing algorithms are complex and hard to
   interpret. This project uses Bayesian sensor fusion to integrate data
   from PIR, CO2, and power sensors for occupancy detection. Bayesian
   sensor fusion (BSF) effectively detects occupancy using data from PIR,
   CO2, and power sensors, with CO2 sensors showing the highest correlation
   to occupancy. It was also found that BSF prioritizes recall leading to
   inferring more occupancy events at the costs of false positives. Using a
   Maximum A Posteriori classifier improves both accuracy and precision,
   addressing the problem of uninformative classification introduced by
   maximizing the F1 score. The results show that PIR sensors were critical
   for early detection to compensate for CO2 sensor delays, but reliance on
   CO2 data led to false positives and challenges in detecting intermittent
   vacancies. Furthermore, a debounce logic was implemented to address the
   frequent dips in mmWave and PIR sensors. Lastly, this work highlights
   the limitations of BSF in detecting brief vacancies: further
   highlighting the need for additional sensors and the exploration of
   spatial and temporal dependencies to improve the detection of transient
   vacancy events.},
