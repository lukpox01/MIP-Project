@article{ WOS:001883326800004,
Author = {Ebong, Frank E. and Tonello, Andrea M.},
Title = {Atomic Norm Denoising of RF Multistatic Response Tensor Eigenvalues for
   Device-Free Indoor Crowd Counting},
Journal = {IEEE WIRELESS COMMUNICATIONS LETTERS},
Year = {2026},
Volume = {15},
Pages = {5333-5337},
Abstract = {Device-free human counting using radio frequency (RF) sensing enables
   occupancy monitoring in indoor environments; however, many existing
   approaches lack physical interpretability. We propose a physics-informed
   method for device-free human counting that extracts dominant eigenvalues
   from the RF multistatic response tensor acquired by a set of deployed
   antennas via Para-Hermitian Eigenvalue Decomposition (PhEVD), followed
   by atomic norm denoising to obtain robust sparse spectral features. For
   the WiFi platform, slot averaging is additionally incorporated to
   capture the temporal evolution of the scattered field prior to
   eigenvalue extraction. Motivated by the observation that dominant
   human-induced scattering mechanisms exhibit sparse spectral structure,
   sparsity-promoting regularization is imposed through a semidefinite
   program solved using the alternating direction method of multipliers
   (ADMM). The processed eigenvalue features are then classified using a
   support vector machine (SVM) with a radial basis function (RBF) kernel
   for human counting. Experimental results demonstrate within-layout
   human-count classification accuracies of 99.9\% and 100.0\% using 4
   antennas connected to a vector network analyzer, and 99.4\% and 99.7\%
   using commercial 2 x 2 WiFi hardware, across two different layouts of
   the same room and scenarios involving 0-8 occupants. These results
   indicate consistent within-layout separability of the proposed features
   across platforms and same-room layout configurations. The proposed
   method is 6.1x faster than the no-averaging baseline and achieves
   substantial memory efficiency, requiring 20.7 MB compared to 83.6 MB for
   PhEVD-only processing, and 165 KB compared to 1.4 GB for the full raw
   WiFi dataset.},
