@inproceedings{ WOS:000446963700075,
Author = {Yang, Dandan and Wang, Tao and Sun, Yanzan and Wu, Yating},
Book-Group-Author = {IEEE},
Title = {Doppler Shift Measurement Using Complex-Valued CSI of WiFi in Corridors},
Booktitle = {PROCEEDINGS OF 2018 3RD INTERNATIONAL CONFERENCE ON COMPUTER AND
   COMMUNICATION SYSTEMS (ICCCS)},
Year = {2018},
Pages = {367-371},
Note = {3rd International Conference on Computer and Communication Systems
   (ICCCS), Nagoya, JAPAN, APR 27-30, 2018},
Organization = {IEEE; Nagoya Inst Technol},
Abstract = {This paper presents a novel approach to measure indoor Doppler shift
   (which is generally neglected) based on Channel State Information (CSI)
   using WiFi. Our approach is motivated by the fact that the CSI provided
   by a commercially available measurement tool is complex-valued, and
   therefore the Fast Fourier Transform (FFT) of CSI is not
   conjugate-symmetric. After establishing a CSI acquisition system, we
   process CSI data guided by theoretical derivation under different
   corridor scenarios and finally obtain the Doppler shift of different
   relative motions. Our results demonstrate that this method of measuring
   Doppler shift could be applied to further research on crowd counting or
   human activity recognition based on WiFi.},
