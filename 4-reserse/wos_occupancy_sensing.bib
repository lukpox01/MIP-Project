@article{ WOS:001736064000023,
Author = {Xun, Zhijie and Cui, Jiarong and Zhang, Haiquan and Nian, Zhongyuan and
   Wang, Hua and Mao, Bomin and Xun, Yijie},
Title = {SDN-Managed Hidden Device Human Counting Scheme Based on Wi-Fi
   Perception},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2026},
Volume = {13},
Number = {8},
Pages = {17286-17294},
Month = {APR 15},
Abstract = {In the Internet of Things (IoT) era, accurate human counting is critical
   for public safety, intelligent building management, and emergency
   response, enabling real-time occupancy estimation and rapid
   decision-making. Current vision-based approaches suffer from blind
   spots, poor lighting, occlusion, and privacy concerns, while
   device-based methods require costly dedicated hardware, restricting
   deployment in large-scale public spaces. Wi-Fi sensing offers a
   promising alternative due to its nonintrusive and
   infrastructure-friendly nature. Compared to received signal strength
   indicator (RSSI)-based methods, channel state information (CSI) offers
   fine-grained signal features and improved sensitivity to environmental
   changes, making it more suitable for complex indoor sensing tasks.
   However, existing CSI-based human counting schemes still struggle with
   dynamic human behaviors and complex obstacle environments. Therefore, we
   propose a software-defined networking (SDN)-managed hidden device-free
   human counting scheme based on Wi-Fi perception, named Hi-Count. CSI is
   utilized for fine-grained environmental sensing, while SDN is employed
   for centralized Wi-Fi management. Experiments were conducted in a
   meeting room and an open hall under three activity scenarios: standing
   still, walking regularly, and walking randomly. Hi-Count achieved
   accuracies of 99.8\%, 93.8\%, and 89.3\% in the meeting room and 97.8\%,
   88.0\%, and 78.7\% in the open hall, respectively. Compared to other
   approaches, Hi-Count achieved higher accuracy and robustness, attributed
   to its low-cost, privacy-preserving design and adaptability, rendering
   it suitable for applications in smart classrooms, hospitals, and
   transportation hubs.},
