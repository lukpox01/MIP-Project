@article{ WOS:000483918900006,
Author = {Popa, Daniel and Ali, Sped Zeeshan and Hoppe, Richard and Dai, Ying and
   Udrea, Florin},
Title = {Smart CMOS mid-infrared sensor array},
Journal = {OPTICS LETTERS},
Year = {2019},
Volume = {44},
Number = {17},
Pages = {4111-4114},
Month = {SEP 1},
Abstract = {We present a novel single-chip thermopile sensor array for mid-infrared
   room temperature imaging. The array is fabricated on a single
   complementary metal-oxide-semiconductor (CMOS) dielectric membrane,
   composed of single-crystal silicon (Si) p(+) and n(+) elements, and
   standard CMOS tungsten metal layers for thermopile cold junction
   heatsinking, significantly reducing the chip size and simplifying its
   processing. We demonstrate a 16 x 16 pixel device with 34 V/W
   responsivity and enhanced optical absorption in the 8-14 mu m waveband,
   with a suitable performance for gesture recognition and people-counting
   applications. Our simple, low-cost sensor is an attractive on-chip array
   for a variety of applications in the mid-infrared spectral region. (C)
   2019 Optical Society of America},
