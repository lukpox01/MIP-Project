   Han, Jung-Hoon, Korea Aerosp Univ, Dept Elect \& Elect Engn, Goyang 10540, South Korea.},
DOI = {10.1109/ACCESS.2024.3450476},
ISSN = {2169-3536},
Keywords = {Radar antennas; Radar imaging; Doppler radar; Receiving antennas;
   Prevention and mitigation; Time division multiplexing; Millimeter wave
