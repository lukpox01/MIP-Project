@inproceedings{ WOS:000632622300364,
Author = {Hagenaars, Erik and Pandharipande, Ashish and Frimout, Emmanuel and
   Leus, Geert},
Book-Group-Author = {IEEE},
Title = {Sensor commissioning detection in single-pixel thermopile sensing
   systems},
Booktitle = {28TH EUROPEAN SIGNAL PROCESSING CONFERENCE (EUSIPCO 2020)},
Series = {European Signal Processing Conference},
Year = {2021},
Pages = {1807-1811},
Note = {28th European Signal Processing Conference (EUSIPCO), ELECTR NETWORK,
   JAN 18-22, 2021},
Organization = {European Assoc Signal Proc},
Abstract = {We consider the problem of detecting sensor commissioning in the form of
   determining the sensor layout. We address this problem for single-pixel
   thermopile sensors, located at the ceiling, that provide remote
   temperature measurements for people counting applications and HVAC
   controls. We employ a random forest classifier to determine the deployed
   layout in an area. For this classifier, we propose spatio-temporal
   distance features using two-sided cumulative sum recursive least squares
   (CUSUM RLS) filtering of the thermopile temperature sensor signals.
   Using sensor data generated with simulated occupancy patterns and a
   thermopile signal model, we show that the proposed method achieves a
   true positive rate (determining the correct layout) of 90.2\% and false
   positive rate of 1.3\%.},
