@article{ WOS:001848337500001,
Author = {Shankar, Yamini and Chakraborty, Ayon},
Title = {SPARC: Disrupting adversarial WiFi sensing with communication-safe
   perturbations},
Journal = {AD HOC NETWORKS},
Year = {2026},
Volume = {193},
Month = {DEC 1},
Abstract = {WiFi sensing leverages fine-grained Channel State Information (CSI) to
   enable applications such as occupancy detection, activity recognition,
   and gesture tracking. However, the same signals can be passively
   intercepted by nearby receivers, allowing adversaries to infer sensitive
   behavioral information without accessing network credentials or
   interacting with the system. This form of adversarial WiFi sensing is
   difficult to detect and cannot be mitigated through traditional security
   mechanisms. Defending against such inference is challenging due to the
   dual role of CSI: while it encodes information useful for sensing, it is
   also critical for communication tasks such as channel equalization and
   rate adaptation. Naive perturbations can degrade signal quality, while
   existing adversarial defenses often rely on unrealistic white-box
   assumptions about the attacker's model. In this paper, we introduce
   SPARC, a sparse and communication-aware perturbation framework for
   defending against CSI-based inference. SPARC identifies a subset of
   highly informative time-subcarrier elements using Sparse Sensor
   Placement Optimization for Classification (SSPOC) and perturbs only
   these components under an explicit signal-to-noise ratio (SNR)
   constraint. The SNR budget keeps the perturbation communication-safe in
   a precise sense: the link remains operational and degrades gracefully
   through standard rate adaptation, with a bounded and controllable cost
   rather than zero cost. The approach operates in a model-black-box
   setting and does not require access to the adversary's model, gradients,
   or training data. We evaluate SPARC across multiple WiFi sensing tasks,
   including occupancy detection, activity recognition, and gesture
   classification. Our results show that SPARC reduces adversarial accuracy
   to 22\%-28\%, down from unperturbed baselines of 83\%-95\%, while
   maintaining SNR deviations within 4 dB and retaining 77\%-90\% of link
   throughput in rate-adaptation simulations, roughly twice the retention
   of a dense perturbation baseline. These results demonstrate that
   targeted, communication-safe perturbations provide an effective and
   practical mechanism for preserving privacy in WiFi sensing systems.},
