@article{ WOS:001898884800001,
Author = {Zaman, Qamar and Ahmad, Muhammad and Khan, Sagheer and Salman, Muhammad},
Title = {PiSense: a Raspberry Pi-based real-time occupancy detection system using
   CSI from commodity WiFi},
Journal = {COMPUTING},
Year = {2026},
Volume = {108},
Number = {11},
Month = {OCT 10},
Abstract = {Occupancy detection plays a critical role in smart building systems by
   enabling efficient energy management, security, and adaptive space
   utilization. Conventional approaches such as cameras, sensors, and
   passive infrared detectors are often constrained by privacy concerns,
   high installation costs, and Line-of-Sight (LoS) limitations. This
   research presents PiSense, a real-time occupancy detection framework
   built on the Raspberry Pi 4B platform that leverages Channel State
   Information (CSI) extracted from commodity WiFi devices. The system
   utilizes the Broadcom BCM43455c0 WiFi chipset in conjunction with the
   Nexmon CSI extraction toolchain to capture fine grained CSI data
   representing multipath propagation characteristics affected by human
   presence and movement. The acquired CSI data are pre-processed using
   Discrete Wavelet Transform (DWT) for denoising and Principal Component
   Analysis (PCA) for dimensionality reduction before classification
   through Random Forest, One-Class SVM, and Autoencoder models.
   Experiments conducted across small, medium, and large indoor
   environments achieved average accuracies exceeding 90 percent, with the
   Autoencoder achieving an average F1 score of 0.94 and an average AUC of
   0.94. The system demonstrated reliable detection under Non-Line-of-Sight
   (NLoS) conditions, confirming robustness against multipath interference.
   Operating entirely on-device, PiSense enables real time inference
   without cloud dependency, providing a low cost, privacy preserving, and
   scalable solution for intelligent occupancy monitoring. The complete
   dataset and implementation framework are publicly available to support
   reproducibility and future research in WiFi-based human sensing.},
