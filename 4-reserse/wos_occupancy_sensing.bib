@inproceedings{ WOS:001556391900041,
Author = {de Armas, Elizabet and Diaz, Guillermo and Sobron, Iker and Matias, Jose
   Maria and Eizmendi, Inaki},
Editor = {Golatowski, F and Scanzio, S and Ashjaei, M and Daoud, R and Santos, P and Amer, H},
Title = {WiFi-CSI sensing for human presence and machine activity in industrial
   environments},
