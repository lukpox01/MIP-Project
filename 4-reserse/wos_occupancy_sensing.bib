@inproceedings{ WOS:001414377800075,
Author = {Du, Hongzhou and Cheong, Pedro and Choi, Wai-Wa},
Book-Group-Author = {IEEE},
Title = {FMCW Radar Crowd Counting with Beamforming and Attention -Enhanced Multi
   -Scale CNN},
Booktitle = {2024 CROSS STRAIT RADIO SCIENCE AND WIRELESS TECHNOLOGY CONFERENCE,
   CSRSWTC 2024},
Series = {Cross Strait Quad Regional Radio Science and Wireless Technology
   Conference},
Year = {2024},
Pages = {223-225},
Note = {2024 Cross Strait Radio Science and Wireless Technology Conference,
   PEOPLES R CHINA, NOV 04-07, 2024},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {In this research, we offer a novel approach for crowd counting employing
   77-GHz frequency -modulated continuous wave (FMC7W) radar, combined with
   digital beamforming and a multiscale convolutional neural network (CNN)
   improved by a channel attention mechanism. The system generates 2D
   spectral waterfall heat maps as inputs to multiple CNN channels using
   beamforming to capture radar data from various perspectives. The channel
   attention mechanism prioritizes signals from critical directions,
   improving detection accuracy. Experimental validation of data obtained
   from up to eight persons demonstrates that the proposed method achieves
   a high accuracy of 98.2\%, outperforming models without beamforming and
   attention processes.},
