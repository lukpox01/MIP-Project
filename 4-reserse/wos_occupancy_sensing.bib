Title = {OCCUPANCY ESTIMATION USING WIFI MOTION DETECTION VIA SUPERVISED MACHINE
   LEARNING ALGORITHMS},
Booktitle = {2019 7TH IEEE GLOBAL CONFERENCE ON SIGNAL AND INFORMATION PROCESSING
   (IEEE GLOBALSIP)},
Series = {IEEE Global Conference on Signal and Information Processing},
