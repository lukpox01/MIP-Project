Title = {Probabilistic Occupancy Level Estimation Based on Opportunistic Passive
   Wi-Fi Localisation},
Booktitle = {PROCEEDINGS OF SAI INTELLIGENT SYSTEMS CONFERENCE (INTELLISYS) 2016, VOL
   1},
Series = {Lecture Notes in Networks and Systems},
