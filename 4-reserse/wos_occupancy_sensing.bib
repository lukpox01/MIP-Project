@article{ WOS:001511452900005,
Author = {Jung, Minyoung and Lee, Joosang and Kim, Donghyun and Park, Dongjun and
   Kim, Taeyeon},
Title = {Implementing Wi-Fi CSI-based room-level occupancy Estimation: an
   experimental study in multi-zone residential environments},
Journal = {JOURNAL OF BUILDING ENGINEERING},
Year = {2025},
Volume = {111},
Month = {OCT 1},
Abstract = {Recent studies have focused on occupant-centric control (OCC) systems,
   which are designed to enhance indoor environments for occupant thermal
   comfort while simultaneously reducing building energy consumption. In
   these control systems, accurate occupancy estimation is crucial;
   however, conventional occupancy sensors have limitations, including
   limited detection range, high installation costs, and privacy concerns.
   This study evaluates the effectiveness of Wi-Fi channel state
   information (CSI)-based occupancy estimation as a promising solution to
   these limitations in multi-zone residential settings. By leveraging
   existing Wi-Fi infrastructure, this method offers a practical,
   non-intrusive, and cost-effective alternative. Through verification
   stages and data analysis in a multi-zone environment, key challenges
   such as signal variability across different settings and cross-room
   interference impacting estimation accuracy were identified. To address
   these critical issues, the study proposes integrating temporal variation
   feature selection to enhance signal consistency, employing a
   hierarchical model structure to isolate roomspecific occupancy states,
   and applying an entropy-based decision-making approach to handle
   unstable signal conditions. Consequently, these strategies achieved an
   average room-level occupancy estimation accuracy of 87.3 \% in a
   five-room multi-zone residential setting with three residents. This
   research offers insights into the practical application of Wi-Fi
   CSI-based occupancy estimation in OCC processes, such as building energy
   management and automatic indoor environment control. By overcoming the
   limitations of conventional sensors, these findings not only demonstrate
   potential for current applications but are also expected to advance more
   reliable and non-intrusive occupancy estimation methods for future OCC
   processes.},
