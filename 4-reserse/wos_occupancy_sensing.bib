@article{ WOS:001571021400009,
Author = {Amiri, Alireza Jafarian and Mahmoodi, Kaywan and Tootchi, Amirreza and
   Razban, Ali},
Title = {A review of occupancy detection techniques for HVAC control: Advances
   and practical challenges},
Journal = {JOURNAL OF BUILDING ENGINEERING},
Year = {2025},
Volume = {113},
Month = {NOV 1},
Abstract = {This review investigates recent advancements in occupancy detection
   methods and their integration into HVAC control systems to enhance
   energy efficiency and indoor comfort in buildings. The primary aim is to
   comprehensively classify and evaluate existing detection strategies
   categorized as direct, indirect, and fusion-based while also analyzing
   the role of supervised, unsupervised, and deep learning models in
   real-world building environments. The review synthesizes over 190
   peer-reviewed studies published between 2017 and 2024, highlighting the
   importance of data-related factors such as resolution, size, bias, and
   preprocessing in the development of accurate and reliable occupancy
   estimation models. Methodologically, the study examines comparative
   performance, privacy implications, cost, sensor placement, and
   algorithmic adaptability across different detection technologies. Key
   findings reveal that multimodal fusion strategies and privacy-preserving
   AI frameworks are gaining prominence due to their enhanced detection
   accuracy and real-time potential, especially when integrated with edge
   computing or hybrid cloud-edge architecture. The paper further outlines
   the practical challenges associated with dataset availability, model
   validation, and scalability, and identifies critical gaps such as the
   lack of standardized benchmarks and the underutilization of real-world
   deployment data. The main contribution of this study is a structured and
   up-to-date framework that bridges technical and practical perspectives
   of occupancy-based HVAC control. The novelty lies in its comprehensive
   synthesis of detection methods, sensor data challenges, and machine
   learning integration, offering actionable insights for researchers and
   building engineers seeking to design intelligent, adaptive, and
   resource-efficient HVAC systems.},
