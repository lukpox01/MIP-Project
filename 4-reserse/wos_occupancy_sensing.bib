@inproceedings{ WOS:001701130700009,
Author = {Merino Bernaola, Jose Ramon and Sobron, Iker and Landa, Iratxe and
   Eizmendi, Inaki and Velez, Manuel},
Book-Group-Author = {ACM},
Title = {Transferability Assessment of WiFi Sensing through CSI-based Doppler},
Booktitle = {PROCEEDINGS OF THE 14TH INTERNATIONAL CONFERENCE ON INFORMATION
   COMMUNICATION AND APPLICATIONS, ICICA 2025},
Year = {2025},
Pages = {61-68},
Note = {14th International Conference on Information Communication and
   Applications-ICICA-Annual, ENGLAND, OCT 14-16, 2025},
Organization = {University of Oxford},
Abstract = {People counting (PC) using WiFi sensing with Channel State Information
   (CSI) is a well-researched area, offering significant potential for
   various smart applications. Despite extensive studies and advancements,
   one of the critical challenges that remains is the transferability of
   models. Specifically, models trained in one environment often struggle
   to classify accurately in new, unseen environments. This study addresses
   the challenge of transferability in CSI-based sensing by utilizing
   Doppler spectrum features derived from CSI data collected under
   noncontrolled, non-uniform time conditions. Two neural network
   architectures-a Multilayer Perceptron (MLP) and a pre-trained
   ResNet-were employed using two types of input features: raw CSI data and
   Doppler spectrum-extracted features. The results demonstrate promising
   transferability performance, with the ResNet model combined with Doppler
   features achieving up to 98\% accuracy in certain case studies. This
   highlights the potential of leveraging Doppler spectrum features and
   pretrained architectures to enhance transfer learning in real-world,
   uncontrolled environments.},
