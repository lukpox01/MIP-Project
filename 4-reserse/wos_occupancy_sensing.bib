Title = {Privacy-Aware Crowd Monitoring and WiFi Traffic Emulation for Effective
   Crisis Management},
Booktitle = {2023 INTERNATIONAL CONFERENCE ON INFORMATION AND COMMUNICATION
   TECHNOLOGIES FOR DISASTER MANAGEMENT, ICT-DM},
Series = {International Conference on Information and Communication Technologies
   for Disaster Management},
