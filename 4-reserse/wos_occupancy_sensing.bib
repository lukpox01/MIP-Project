@inproceedings{ WOS:001786509400627,
Author = {Ratto, V, Sebastian and Sayed, Ahmed N. and Rosas-Bustos, Jose R. and
   Sligar, Arien and Ramahi, Omar M. and Shaker, George},
Book-Group-Author = {IEEE},
Title = {Quantum-Enhanced Radar Systems for Indoor Occupancy Detection Using
   Digital Twin Simulations},
Booktitle = {2025 IEEE MICROWAVES, ANTENNAS, AND PROPAGATION CONFERENCE, MAPCON},
Year = {2025},
Note = {2025 Microwaves Antennas and Propagation Conference-MAPCON-Annual,
   Kochi, INDIA, DEC 14-18, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {This paper introduces a novel approach for indoor human presence
   detection using Hybrid Quantum Neural Networks (HQNNs) integrated with
   Digital Twin (DT) radar simulations. By leveraging a 60 GHz
   Frequency-Modulated Continuous Wave (FMCW) radar, we generate synthetic
   radar data for various occupancy conditions, marking the first
   application of quantum machine learning for radar-based human presence
   detection. Our quantum-enhanced model outperforms classical machine
   learning models, especially in low signal-tonoise ratios (SNR) and
   cluttered environments, demonstrating superior robustness with fewer
   data and parameters. This work highlights the potential of quantum
   machine learning for radar-based sensing, offering a scalable and
   privacy-preserving solution for real-time applications in healthcare and
   security.},
