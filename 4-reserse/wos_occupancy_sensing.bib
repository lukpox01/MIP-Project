@inproceedings{ WOS:001748476000056,
Author = {Harichandan, Chinta and Krishnasamy, Vijayakumar and Rajendiran,
   Praveenkumar and Balaji, Garaga Prem Sri},
Book-Group-Author = {IEEE},
Title = {Machine Learning Driven CSI Motion Detection for Smart Homes with Energy
   Efficiency and Safety},
Booktitle = {2025 IEEE 9TH INTERNATIONAL CONFERENCE ON INFORMATION AND COMMUNICATION
   TECHNOLOGY, CICT},
Year = {2025},
Note = {9th Conference on Information and Communication Technology-CICT,
   Chennai, INDIA, DEC 19-21, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc; IEEE Signal
   Processing Society Bangalore Chapter},
Abstract = {Monitoring human activity serves as a vital element in evaluating
   occupancy levels and security risks in indoor spaces, including smart
   homes. However, most traditional sensors and vision-based methods
   require a direct line of sight, involve high installation costs, or
   raise privacy concerns. To mitigate the issues, a device-free motion
   detection presented in this study, which leverages fine-grained
   multipath dynamics under channel state information (CSI) inherently
   available in the WiFi infrastructure. The RSSI-based technique monitors
   single-path signal strength changes, which is challenging in non-linear
   environments. Whereas the proposed method infers human presence and
   activity trends by analysing CSI variations in real time. To achieve
   reliable occupancy detection and motion classification, the proposed
   two-stage machine learning pipeline is used. The model was trained by
   CSI data from commodity IoT WiFi devices in multiple indoor scenarios.
   The proposed method highlights robust performance even when targets are
   hidden from view, highlighting the potential of the method for pervasive
   ambient intelligence.},
