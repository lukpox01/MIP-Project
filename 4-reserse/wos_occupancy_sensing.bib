@inproceedings{ WOS:001103214700016,
Author = {Chung, Wei-Yu and Shen, Li-Hsiang and Feng, Kai-Ten and Lin, Yuan-Chun
   and Lin, Shih-Cheng and Chang, Sheng-Fuh},
Book-Group-Author = {IEEE},
Title = {WiRiS: Transformer for RIS-Assisted Device-Free Sensing for Joint People
   Counting and Localization Using Wi-Fi CSI},
Booktitle = {2023 IEEE 34TH ANNUAL INTERNATIONAL SYMPOSIUM ON PERSONAL, INDOOR AND
   MOBILE RADIO COMMUNICATIONS, PIMRC},
