@article{ WOS:001635844100044,
Author = {Li, Zeyang and Zhang, Jie and Da Silva, Claudio R. C. M. and Yurduseven,
   Okan and Duong, Trung Q. and Fischione, Carlo and Cotton, Simon L.},
Title = {Efficient 6-GHz Wi-Fi-Based Occupancy Detection: Channel Model-Informed
   Feature Engineering and Random Forest Optimization},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2025},
Volume = {12},
Number = {24},
Pages = {53800-53813},
Month = {DEC 15},
Abstract = {This article investigates the use of the newly opened, and relatively
   unexplored, 6 GHz band for office occupancy detection using Wi-Fi
   sensing. To deliver accurate and efficient occupancy detection, we
   develop a novel channel model-informed feature engineering method
   combined with a random forest optimization strategy. Specifically,
   physically interpretable channel state information (CSI) amplitude-based
   features, such as the Rician \$K\$ -factor and channel coherence time
   (CCT), are employed to capture channel variations induced by human
   presence and movement. A dual sliding window approach is introduced to
   effectively extract temporally relevant channel parameters,
   significantly improving computational efficiency and classification
   accuracy. Experimental validation conducted in a realistic office
   environment demonstrates that the proposed method achieves an average
   occupancy classification accuracy of 98.28\%, outperforming existing
   methods while substantially reducing computational complexity. These
   findings suggest that integrating this Wi-Fi sensing approach into
   next-generation networks (e.g., IEEE 802.11bf) can enhance real-time
   responsiveness and reliability in smart building applications such as
   security and energy management.},
