@inproceedings{ WOS:001820964800056,
Author = {Morabet, Farid and Lazaro, Marc and Villarino, Ramon and Girbau, David
   and Lazaro, Antonio},
Book-Group-Author = {IEEE},
Title = {Privacy-Preserving Seat Detection with FSS-Modulated Backscatter and
   mmWave Radar},
Booktitle = {2025 22ND EUROPEAN RADAR CONFERENCE, EURAD},
Year = {2025},
Pages = {226-229},
Note = {22nd European Radar Conference-EuRAD, Utrecht, NETHERLANDS, SEP 24-26,
   2025},
Organization = {Institute of Electrical and Electronics Engineers Inc; Antennas and
   Propagation Society; IEEE Aerospace and Electronic Systems Society},
Abstract = {Reliable seat occupancy detection is critical for vehicle safety, energy
   efficiency, and advancements in autonomous driving technologies.
   Traditional methods, such as weight sensors, camera-based systems, and
   motion-based radar, face challenges such as privacy, high cost, and
   limitations in detecting still occupants. This paper proposes a novel
   system based on a millimeter-wave (mmWave) Doppler radar that acts as a
   reader and several tags with Frequency Selective Surfaces (FSS). These
   tags are mounted on the seat headrests, and backscatter and modulate the
   signal from the radar. Occupancy detection is done depending on the
   visibility between the tag and the radar, without the need to analyze
   motion. The FSS tags are modulated using PIN diodes at different
   switching frequencies to identify each seat. A 24 GHz proof-of-concept
   prototype has been designed and developed to experimentally validate the
   system's performance under real-world driving conditions, demonstrating
   its feasibility for applications such as adaptive airbag deployment,
   automatic climate zone control, and advanced driver-assistance systems
   (ADAS).},
