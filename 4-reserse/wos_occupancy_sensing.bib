@article{ WOS:001740782500006,
Author = {Tong, Liangang and Li, He and Kong, Weihang},
Title = {GFAF-Net: Global-Local Feature Extraction and Adaptive Fusion Network
   for RGB-T Crowd Counting in Video Surveillance Systems},
Journal = {IEEE TRANSACTIONS ON AUTOMATION SCIENCE AND ENGINEERING},
Year = {2026},
Volume = {23},
Pages = {7869-7879},
Abstract = {RGB-T cross-modal crowd counting aims to improve the accuracy and
   robustness of crowd counting by combining information from visible and
   thermal infrared images. However, how to effectively utilize
   different-modal features as well as different-level (global or local)
   features within the same modality is a challenging issue for cross-modal
   crowd counting task. In this paper, we develop a global-local feature
   extraction and adaptive fusion network for RGB-T crowd counting,
   including three main components. The developed network utilizes the
   novel parallel CNN-transformer backbone structure to learn the global
   and local features effectively, and then utilize the self-learning
   feature preference selection strategy to select the different-level
   features with pReferences adaptively. And a cross-modal intra-inter
   fusion module is designed to realize the effective intra-modal and
   inter-modal fusion simultaneously. Extensive experimental evaluations of
   the proposed GFAF-Net on mainstream challenging RGB-T crowd counting
   benchmark datasets. And results show that the proposed method
   significantly improves the performance of the cross-modal crowd counting
   task with competitive results. In addition, through ablation studies, we
   further validate the significant contribution of the core components of
   the GFAF-Net to the counting performance. We hope that the proposed
   GFAF-Net can bring meaningful inspiration for cross-modal crowd counting
   to facilitate future research. Note to Practitioners-This work is
   motivated by the challenge of accurately counting people in crowded
   public spaces, such as airports, train stations, or large events, using
   video surveillance systems. While standard color (RGB) cameras struggle
   with poor lighting or visual clutter, thermal (T) cameras can see people
   in the dark but lack texture detail. Combining both modalities promises
   more reliable counts, but fusing their information effectively is
   difficult. We introduce GFAF-Net, a new deep learning model designed to
   intelligently combine data from RGB and thermal cameras. Our solution
   improves counting accuracy and robustness by addressing two key
   problems: it learns both broad scene context and fine-grained local
   details from each camera type, and it automatically determines the best
   way to blend this information. For example, in a dark scene, the network
   can learn to rely more on the thermal data, while in a well-lit, crowded
   scene, it can prioritize the detailed textures from the RGB image. The
   primary practical value of our results is the potential for more
   reliable and automated crowd monitoring systems. This can enhance public
   safety by providing security personnel with more accurate real-time
   occupancy data for proactive management. While our method shows superior
   performance on standard benchmarks, its current limitations include a
   dependency on paired RGB-thermal data for training and the computational
   demands of the model, which may require optimization for deployment on
   low-power edge devices. Future work will focus on making the network
   lighter and more efficient for real-time processing. Beyond crowd
   counting, the core technology of adaptive multi-sensor fusion could be
   applied to other surveillance tasks, such as anomaly detection or
   traffic monitoring.},
