@article{ WOS:001511068800027,
Author = {Chen, Penghui and Du, Yang and Huang, Wenfeng and Bai, Yujing and Wei,
   Shaoming and Wang, Jun},
Title = {Vehicle Occupant Detection and Vital Sign Monitoring Based on Random
   Body Movement Correction Using Millimeter-Wave Radar},
Journal = {IEEE SENSORS JOURNAL},
Year = {2025},
Volume = {25},
Number = {12},
Pages = {21945-21957},
Month = {JUN 15},
Abstract = {In this work, a combined system for vehicle occupant detection and
   noncontact vital sign monitoring is proposed, which can be used in the
   automotive industry. First, occupant detection and radial range-azimuth
   positioning method based on frequency-modulated continuous wave (FMCW)
   radar is applied. By separating the radar echoes of multiple life
   targets, the intermediate frequency (IF) signals containing vital sign
   micromovement information of each passenger's chest are extracted. Then,
   the successive variational mode decomposition (SVMD) algorithm is used
   to decompose and reconstruct the breathing and heartbeat signals of each
   passenger. Furthermore, we propose an IF signal speed compensation
   method to eliminate the impact of random body movement (RBM) on vital
   signal extraction. Our system can successfully extract the breathing and
