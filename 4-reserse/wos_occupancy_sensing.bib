Title = {IoT-Based Analysis of Environmental and Motion Data for Comfort and
   Energy Conservation in Optimizing HVAC Systems},
Booktitle = {INTERNET COMPUTING AND IOT AND EMBEDDED SYSTEMS, CYBER-PHYSICAL SYSTEMS,
   AND APPLICATIONS, ICOMP 2024, ESCS 2024},
Series = {Communications in Computer and Information Science},
