@inproceedings{ WOS:000539913200024,
Author = {Gaonkar, Pradnya and Bapat, Jyotsna and Das, Debabrata and Rao,
   Subrahmanya V. R. K.},
Book-Group-Author = {IEEE},
Title = {Occupancy Estimation in Semi-Public Spaces using Sensor Fusion and
   Context Awareness},
Booktitle = {PROCEEDINGS OF 2019 IEEE REGION 10 SYMPOSIUM (TENSYMP)},
Series = {IEEE Region 10 Symposium},
Year = {2019},
Pages = {131-136},
Note = {IEEE-Region-10 Symposium (TENSYMP), Kolkata, INDIA, JUN 07-09, 2019},
Organization = {IEEE Reg 10; IEEE; IEEE Kolkata Sect},
Abstract = {Accurate occupancy estimation is of great importance in managing indoor
   comfort demands and energy costs in semi-public buildings like academic
   institutes, offices, etc. Large spaces with multiple occupant seating
   are common in such buildings. Sophisticated sensors used for occupancy
   detection and estimation in these spaces, like cameras and motion
   sensors, may prove expensive and intrusive. Contrarily, simple devices
   like a door sensor or a Passive Infrared (PIR) sensor, if employed
   individually, might not he accurate enough. In this work, we exploit the
   unique advantages of each of these low-cost, off-the shelf sensors to
   propose a novel heuristic algorithm for occupancy estimation. We develop
   an analytical model to probabilistically derive the uncertainty
   associated with a door sensor. We propose an effective and unique way to
   enhance the capability of the door sensor by fusing it with a PIR sensor
   and context information in terms of occupancy memory of the space. The
   hardware test bed was deployed in an academic institute, that mimics a
   work space in semi-public building. The pertbrmance comparison of the
   sensors and proposed algorithm is presented in terms of probability of
   detection and errors.},
