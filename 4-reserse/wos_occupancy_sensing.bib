@article{ WOS:000448397200047,
Author = {Bassoli, Marco and Bianchi, Valentina and De Munari, Ilaria},
Title = {A Plug and Play IoT Wi-Fi Smart Home System for Human Monitoring},
Journal = {ELECTRONICS},
Year = {2018},
Volume = {7},
Number = {9},
Month = {SEP},
Abstract = {The trend toward technology ubiquity in human life is constantly
   increasing and the same tendency is clear in all technologies aimed at
   human monitoring. In this framework, several smart home system
   architectures have been presented in literature, realized by combining
   sensors, home servers, and online platforms. In this paper, a new system
   architecture suitable for human monitoring based on Wi-Fi connectivity
   is introduced. The proposed solution lowers costs and implementation
   burden by using the Internet connection that leans on standard home
   modem-routers, already present normally in the homes, and reducing the
   need for range extenders thanks to the long range of the Wi-Fi signal.
   Since the main drawback of the Wi-Fi implementation is the high energy
   drain, low power design strategies have been considered to provide each
   battery-powered sensor with a lifetime suitable for a consumer
   application. Moreover, in order to consider the higher consumption
   arising in the case of the Wi-Fi/Internet connectivity loss, dedicated
   operating cycles have been introduced obtaining an energy savings of up
   to 91\%. Performance was evaluated: in order to validate the use of the
   system as a hardware platform for behavioral services, an activity
   profile of a user for two months in a real context has been extracted.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
