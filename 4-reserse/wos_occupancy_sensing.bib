@article{ WOS:000701680800001,
Author = {Jung, YooSeok and Kang, TaeWook and Chun, Chanjun},
Title = {Anomaly analysis on indoor office spaces for facility management using
   deep learning methods},
Journal = {JOURNAL OF BUILDING ENGINEERING},
Year = {2021},
Volume = {43},
Month = {NOV},
Abstract = {Shared and open offices have grown in demand and value in recent years.
   In these offices, no principal agent is available for space management
   because seats are not designated to specific users, posing difficulties
   in lighting and temperature control, and facility management. This
   problem can be resolved by collecting data on the conditions of indoor
   office spaces using Internet of Things (IoT) devices, and providing the
   data to facility managers for spatial management. However, user privacy
   must not be undermined during data collection. Therefore, this study
   analyzes the feasibility of anomaly analysis using deep learning, based
   on data collected by IoT devices on the conditions of indoor spaces, for
   facility management. We fabricated three IoT devices that collect data
   on temperature, humidity, and brightness, and installed them in the
   underground communal spaces and rest spaces of an office building. Each
   device collected 53900 time-series data records in about a month, which
   were used for training a long-short term memory (LSTM) model, which is a
   representative recurrent neural network method. When the LSTM was
   trained using the temperature, humidity, and brightness data collected
   by one device, the prediction accuracy was significantly high with a
   mean absolute percentage error (MAPE) of 1.47\%. When trained using the
   values obtained by one device based on the data collected by the other
   two devices installed nearby, the prediction accuracy was very high with
   a MAPE of 8.58\%. Therefore, anomaly analysis can be performed using the
   model developed through training by setting thresholds for criteria
   errors.},
